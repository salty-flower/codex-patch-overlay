+use std::collections::VecDeque;
+
+use codex_protocol::config_types::ReasoningSummary;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::models::BaseInstructions;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use futures::StreamExt;
+use tokio_util::sync::CancellationToken;
+
+use crate::client_common::Prompt;
+use crate::client_common::ResponseEvent;
+use crate::compact::content_items_to_text;
+use crate::context_manager::is_user_turn_boundary;
+use crate::responses_metadata::CodexResponsesMetadata;
+use crate::responses_metadata::CodexResponsesRequestKind;
+use crate::session::session::Session;
+
+const TITLE_INSTRUCTIONS: &str = "Generate a concise descriptive English title for this conversation. Output only the title, with no quotes, markdown, or punctuation wrapper. Use at most 15 words.";
+const MAX_TITLE_CONTEXT_MESSAGES: usize = 12;
+const MAX_TITLE_WORDS: usize = 15;
+
+pub(crate) async fn generate_thread_name(
+    session: &Session,
+    after_turns: usize,
+    cancellation_token: &CancellationToken,
+) -> CodexResult<Option<String>> {
+    let history = session.clone_history().await;
+    let history_items = history.raw_items().cloned().collect::<Vec<_>>();
+    let (completed_turns, input) = completed_conversation_messages(&history_items);
+    if completed_turns < after_turns.max(1) {
+        return Ok(None);
+    }
+
+    let (model, effort, service_tier, config) = session.thread_name_model_context().await;
+    let model_config = config.to_models_manager_config();
+    let model_info = session
+        .services
+        .models_manager
+        .get_model_info(&model, &model_config)
+        .await;
+    let prompt = Prompt {
+        input,
+        tools: Vec::new().into(),
+        parallel_tool_calls: false,
+        base_instructions: BaseInstructions {
+            text: TITLE_INSTRUCTIONS.to_string(),
+            provenance: None,
+        },
+        output_schema: None,
+        output_schema_strict: true,
+    };
+    let mut metadata = CodexResponsesMetadata::new(
+        session.installation_id.clone(),
+        session.session_id().to_string(),
+        session.thread_id.to_string(),
+        session.current_window_id().await,
+    );
+    metadata.request_kind = Some(CodexResponsesRequestKind::ThreadName);
+
+    let mut client_session = session.services.model_client.new_isolated_session();
+    let trace_context = codex_rollout_trace::InferenceTraceContext::disabled();
+    let stream = client_session.stream(
+        &prompt,
+        &model_info,
+        &session.services.session_telemetry,
+        effort,
+        ReasoningSummary::None,
+        service_tier,
+        &metadata,
+        &trace_context,
+    );
+    let mut stream = tokio::select! {
+        result = stream => result?,
+        _ = cancellation_token.cancelled() => return Err(CodexErr::Interrupted),
+    };
+
+    let mut output = String::new();
+    loop {
+        let event = tokio::select! {
+            event = stream.next() => event,
+            _ = cancellation_token.cancelled() => return Err(CodexErr::Interrupted),
+        };
+        let Some(event) = event else {
+            break;
+        };
+        match event? {
+            ResponseEvent::OutputTextDelta(delta) => output.push_str(&delta),
+            ResponseEvent::OutputItemDone(ResponseItem::Message { content, .. })
+                if output.is_empty() =>
+            {
+                if let Some(text) = content_items_to_text(&content) {
+                    output.push_str(&text);
+                }
+            }
+            ResponseEvent::Completed { .. } => break,
+            _ => {}
+        }
+    }
+
+    Ok(normalize_generated_title(&output))
+}
+
+fn completed_conversation_messages(items: &[ResponseItem]) -> (usize, Vec<ResponseItem>) {
+    let mut completed_turns = 0usize;
+    let mut pending_user = false;
+    let mut messages = VecDeque::new();
+
+    for item in items {
+        let ResponseItem::Message {
+            role,
+            content,
+            phase,
+            ..
+        } = item
+        else {
+            continue;
+        };
+        if role == "user" && is_user_turn_boundary(item) {
+            pending_user = true;
+        } else if role == "assistant" && pending_user {
+            completed_turns = completed_turns.saturating_add(1);
+            pending_user = false;
+        } else if role != "assistant" {
+            continue;
+        }
+
+        let Some(text) = content_items_to_text(content) else {
+            continue;
+        };
+        let content = if role == "assistant" {
+            vec![ContentItem::OutputText { text }]
+        } else {
+            vec![ContentItem::InputText { text }]
+        };
+        messages.push_back(ResponseItem::Message {
+            id: None,
+            role: role.clone(),
+            content,
+            phase: phase.clone(),
+            internal_chat_message_metadata_passthrough: None,
+        });
+        if messages.len() > MAX_TITLE_CONTEXT_MESSAGES {
+            messages.pop_front();
+        }
+    }
+
+    (completed_turns, messages.into())
+}
+
+fn normalize_generated_title(title: &str) -> Option<String> {
+    let first_line = title.lines().find(|line| !line.trim().is_empty())?.trim();
+    let unwrapped = first_line
+        .trim_matches(|character: char| {
+            character.is_whitespace()
+                || matches!(character, '"' | '\'' | '`' | '*' | '_' | '#' | '.')
+        })
+        .trim();
+    let title = unwrapped
+        .split_whitespace()
+        .take(MAX_TITLE_WORDS)
+        .collect::<Vec<_>>()
+        .join(" ");
+    (!title.is_empty()).then_some(title)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn message(role: &str, text: &str) -> ResponseItem {
+        ResponseItem::Message {
+            id: None,
+            role: role.to_string(),
+            content: vec![if role == "assistant" {
+                ContentItem::OutputText {
+                    text: text.to_string(),
+                }
+            } else {
+                ContentItem::InputText {
+                    text: text.to_string(),
+                }
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }
+    }
+
+    #[test]
+    fn counts_only_paired_real_user_assistant_turns() {
+        let items = vec![
+            message("user", "first"),
+            message("assistant", "answer"),
+            message("user", "failed"),
+        ];
+
+        let (count, messages) = completed_conversation_messages(&items);
+
+        assert_eq!(count, 1);
+        assert_eq!(messages.len(), 3);
+    }
+
+    #[test]
+    fn generated_title_is_unwrapped_and_limited_to_fifteen_words() {
+        let title = normalize_generated_title(
+            "**one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen**",
+        );
+
+        assert_eq!(
+            title.as_deref(),
+            Some(
+                "one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen"
+            )
+        );
+    }
+}

+impl AutoThreadNameState {
+    fn try_start(&mut self, thread_id: ThreadId, completed_turn_id: String) -> bool {
+        if self.in_flight.contains(&thread_id)
+            || self
+                .last_attempted_turn
+                .get(&thread_id)
+                .is_some_and(|turn_id| turn_id == &completed_turn_id)

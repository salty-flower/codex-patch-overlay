+                &primary.to_string(),
+                TurnStatus::Completed,
+            ),
+            Some(primary)
+        );
+    }
+
+    #[test]
+    fn stale_or_subagent_completion_is_not_eligible() {
+        let selected = ThreadId::new();
+        let completed = ThreadId::new();
+        assert_eq!(

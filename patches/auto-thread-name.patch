+        }
+        self.in_flight.insert(thread_id);
+        self.last_attempted_turn
+            .insert(thread_id, completed_turn_id);
+        true
+    }
+
+    fn finish(&mut self, thread_id: ThreadId) {
+        self.in_flight.remove(&thread_id);
+    }

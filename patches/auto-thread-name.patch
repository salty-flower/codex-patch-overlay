+use crate::function_tool::FunctionCallError;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolOutput;
+use crate::tools::context::ToolPayload;
+use crate::tools::context::boxed_tool_output;
+use crate::tools::handlers::set_thread_name_spec::create_set_thread_name_tool;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseInputItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ThreadNameUpdateRequestedEvent;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde::Deserialize;
+use serde_json::Value as JsonValue;
+
+/// Model-callable tool that titles the current (primary) thread in-process.
+///
+/// The rename is best-effort and scoped to the running thread: the handler
+/// emits [`EventMsg::ThreadNameUpdateRequested`], and the owning app-server
+/// persists the title through the canonical thread-store metadata path and
+/// broadcasts `thread/name/updated`. It never overwrites an existing title, so
+/// manual `/rename` names are preserved.
+pub struct SetThreadNameHandler;
+
+pub struct SetThreadNameOutput {
+    message: String,
+}
+
+#[derive(Deserialize)]
+struct SetThreadNameArgs {
+    name: String,
+}
+
+impl ToolOutput for SetThreadNameOutput {
+    fn log_preview(&self) -> String {
+        self.message.clone()
+    }
+
+    fn success_for_logging(&self) -> bool {
+        true
+    }
+
+    fn to_response_item(&self, call_id: &str, _payload: &ToolPayload) -> ResponseInputItem {
+        let mut output = FunctionCallOutputPayload::from_text(self.message.clone());
+        output.success = Some(true);
+
+        ResponseInputItem::FunctionCallOutput {
+            call_id: call_id.to_string(),
+            output,
+        }
+    }
+
+    fn code_mode_result(&self, _payload: &ToolPayload) -> JsonValue {
+        JsonValue::Object(serde_json::Map::new())
+    }
+}
+
+impl ToolExecutor<ToolInvocation> for SetThreadNameHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("set_thread_name")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        create_set_thread_name_tool()
+    }
+
+    fn handle(&self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'_> {
+        Box::pin(self.handle_call(invocation))
+    }
+}
+
+impl SetThreadNameHandler {
+    async fn handle_call(
+        &self,
+        invocation: ToolInvocation,
+    ) -> Result<Box<dyn ToolOutput>, FunctionCallError> {
+        let ToolInvocation {
+            session,
+            turn,
+            payload,
+            ..
+        } = invocation;
+
+        let arguments = match payload {
+            ToolPayload::Function { arguments } => arguments,
+            _ => {
+                return Err(FunctionCallError::RespondToModel(
+                    "set_thread_name handler received unsupported payload".to_string(),
+                ));
+            }
+        };
+
+        // Subagents and other side threads must never rename a primary thread.
+        // The tool is also unregistered for them, but guard defensively here in
+        // case it is ever reached through another dispatch path.
+        if turn.session_source.is_non_root_agent() {
+            return Err(FunctionCallError::RespondToModel(
+                "set_thread_name is only available on the primary thread".to_string(),
+            ));
+        }
+
+        let args: SetThreadNameArgs = serde_json::from_str(&arguments).map_err(|err| {
+            FunctionCallError::RespondToModel(format!("failed to parse function arguments: {err}"))
+        })?;
+        let Some(name) = crate::util::normalize_thread_name(&args.name) else {
+            return Err(FunctionCallError::RespondToModel(
+                "thread name must not be empty".to_string(),
+            ));
+        };
+
+        session
+            .send_event(
+                turn.as_ref(),
+                EventMsg::ThreadNameUpdateRequested(ThreadNameUpdateRequestedEvent {
+                    name: name.clone(),
+                }),
+            )
+            .await;
+
+        Ok(boxed_tool_output(SetThreadNameOutput {
+            message: format!(
+                "Requested title \"{name}\" for this conversation; it is applied only if the thread is currently untitled."
+            ),
+        }))
+    }
+}
+
+impl CoreToolRuntime for SetThreadNameHandler {}

+            model: Some("mock-model".to_string()),
+            ..Default::default()
+        })
+        .await?;
+    let start_resp: JSONRPCResponse = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_response_message(RequestId::Integer(start_id)),
+    )
+    .await??;
+    let ThreadStartResponse { thread, .. } = to_response(start_resp)?;
+
+    let turn_id = mcp
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Please title this conversation".to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let turn_resp: JSONRPCResponse = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_response_message(RequestId::Integer(turn_id)),
+    )
+    .await??;
+    let TurnStartResponse { .. } = to_response(turn_resp)?;
+
+    // The model's in-process `set_thread_name` call must broadcast a single
+    // silent (generated) `thread/name/updated` for the active thread.
+    let notification = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_notification_message("thread/name/updated"),
+    )
+    .await??;
+    let notification: ThreadNameUpdatedNotification =
+        serde_json::from_value(notification.params.expect("thread/name/updated params"))?;
+    assert_eq!(notification.thread_id, thread.id);
+    assert_eq!(notification.thread_name.as_deref(), Some(generated_name));
+    assert_eq!(notification.source, Some(ThreadNameUpdateSource::Generated));
+
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+
+    // The canonical thread-store metadata write must be visible through read.
+    let read_id = mcp
+        .send_thread_read_request(ThreadReadParams {
+            thread_id: thread.id.clone(),
+            include_turns: false,
+        })
+        .await?;
+    let read_resp: JSONRPCResponse = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_response_message(RequestId::Integer(read_id)),
+    )
+    .await??;
+    let read: ThreadReadResponse = to_response(read_resp)?;
+    assert_eq!(read.thread.name.as_deref(), Some(generated_name));
+
+    // SQLite state-db and the session_index.jsonl must expose the same title.
+    let state_db_list_id = mcp
+        .send_thread_list_request(ThreadListParams {
+            cursor: None,
+            limit: Some(50),
+            sort_key: None,
+            sort_direction: None,
+            model_providers: None,
+            source_kinds: None,
+            archived: None,
+            is_pinned: None,
+            cwd: None,
+            use_state_db_only: true,
+            search_term: None,
+            parent_thread_id: None,
+            ancestor_thread_id: None,
+        })
+        .await?;
+    let state_db_list_resp: JSONRPCResponse = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_response_message(RequestId::Integer(state_db_list_id)),
+    )
+    .await??;
+    let ThreadListResponse { data, .. } = to_response::<ThreadListResponse>(state_db_list_resp)?;
+    let listed = data
+        .iter()
+        .find(|t| t.id == thread.id)
+        .expect("state-db thread/list should include the created thread");
+    assert_eq!(listed.name.as_deref(), Some(generated_name));
+
+    let session_index = std::fs::read_to_string(codex_home.path().join("session_index.jsonl"))?;
+    assert!(
+        session_index
+            .lines()
+            .any(|line| line.contains(&thread.id) && line.contains(generated_name)),
+        "session_index.jsonl must record the generated title: {session_index}"
+    );
+
+    Ok(())
+}

+    let _: ThreadSetNameResponse = to_response(set_resp)?;
+    let manual_notification = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_notification_message("thread/name/updated"),
+    )
+    .await??;
+    let manual_notification: ThreadNameUpdatedNotification = serde_json::from_value(

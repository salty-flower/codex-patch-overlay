+use codex_tools::JsonSchema;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolSpec;
+use std::collections::BTreeMap;
+
+pub fn create_set_thread_name_tool() -> ToolSpec {
+    let properties = BTreeMap::from([(
+        "name".to_string(),
+        JsonSchema::string(Some(
+            "Concise, descriptive title for the current conversation (at most ~15 words, no surrounding quotes)."
+                .to_string(),
+        )),
+    )]);
+
+    ToolSpec::Function(ResponsesApiTool {
+        name: "set_thread_name".to_string(),
+        description: r#"Set a short, descriptive title for the current conversation thread.
+Only takes effect if the thread has no title yet; existing titles (whether set manually or earlier) are preserved.
+The title updates the terminal window title and status line immediately without adding a visible turn."#
+            .to_string(),
+        strict: false,
+        defer_loading: None,
+        parameters: JsonSchema::object(
+            properties,
+            Some(vec!["name".to_string()]),
+            Some(false.into()),
+        ),
+        output_schema: None,
+    })
+}

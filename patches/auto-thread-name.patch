+                true,
+                Some(selected),
+                &completed.to_string(),
+                TurnStatus::Completed,
+            ),
+            None
+        );
+    }
+
+    #[test]
+    fn disabled_or_failed_completion_is_not_eligible() {
+        let primary = ThreadId::new();

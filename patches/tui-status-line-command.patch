+    pub(crate) key: StatusLineCommandRequestKey,
+    pub(crate) result: Result<Vec<Line<'static>>, String>,
+}
+
+#[derive(Clone, Debug)]
+struct PendingRequest {
+    key: StatusLineCommandRequestKey,
+    config: StatusLineCommandConfig,
+    stdin_json: Vec<u8>,
+    cwd: PathBuf,
+    terminal: Size,
+}
+
+#[derive(Debug)]
+struct InFlightRequest {
+    key: StatusLineCommandRequestKey,
+    cancellation: CancellationToken,
+}
+
+#[derive(Clone, Debug)]
+struct CachedOutput {
+    thread_id: Option<ThreadId>,
+    command_generation: u64,
+    lines: Vec<Line<'static>>,
+}
+
+/// Single-flight controller. Repeated refreshes retain only the newest desired snapshot.
+#[derive(Debug, Default)]
+pub(crate) struct StatusLineCommandState {
+    config: Option<StatusLineCommandConfig>,
+    command_generation: u64,
+    active_thread_id: Option<ThreadId>,
+    context_initialized: bool,
+    next_request_id: u64,
+    desired_status_generation: u64,
+    in_flight: Option<InFlightRequest>,
+    pending: Option<PendingRequest>,
+    last_requested_json: Option<Vec<u8>>,
+    last_requested_at: Option<Instant>,
+    last_success: Option<CachedOutput>,
+    terminal: Size,
+}
+
+impl StatusLineCommandState {
+    pub(crate) fn terminal(&self) -> Size {
+        self.terminal
+    }
+
+    pub(crate) fn set_terminal(&mut self, terminal: Size) -> bool {
+        let became_valid = (self.terminal.width == 0 || self.terminal.height == 0)
+            && terminal.width > 0
+            && terminal.height > 0;
+        self.terminal = terminal;
+        became_valid
+    }
+
+    pub(crate) fn sync_context(
+        &mut self,
+        config: Option<&StatusLineCommandConfig>,
+        thread_id: Option<ThreadId>,
+    ) {
+        let config_changed = self.config.as_ref() != config;
+        let thread_changed = self.context_initialized && self.active_thread_id != thread_id;
+        if !config_changed && !thread_changed {
+            self.context_initialized = true;
+            return;
+        }
+
+        if let Some(in_flight) = self.in_flight.as_ref() {
+            in_flight.cancellation.cancel();
+        }
+        if config_changed {
+            self.command_generation = self.command_generation.wrapping_add(1);
+            self.config = config.cloned();
+        }
+        self.active_thread_id = thread_id;
+        self.context_initialized = true;
+        self.desired_status_generation = self.desired_status_generation.wrapping_add(1);
+        self.pending = None;
+        self.last_requested_json = None;
+        self.last_requested_at = None;
+        self.last_success = None;
+    }
+
+    pub(crate) fn request(
+        &mut self,
+        input: &StatusLineCommandInputV1,
+        cwd: PathBuf,
+        now: Instant,
+        tx: &AppEventSender,
+    ) -> Result<bool, serde_json::Error> {
+        let Some(config) = self.config.clone() else {
+            return Ok(false);
+        };
+        if self.terminal.width == 0 || self.terminal.height == 0 {
+            return Ok(false);
+        }
+        let stdin_json = serde_json::to_vec(input)?;
+        let changed = self.last_requested_json.as_deref() != Some(stdin_json.as_slice());
+        let interval = Duration::from_millis(config.refresh_interval_ms);
+        let interval_elapsed = self
+            .last_requested_at
+            .is_none_or(|last| now.saturating_duration_since(last) >= interval);
+        if !changed && !interval_elapsed {
+            return Ok(false);
+        }
+        // An interval-only refresh must not supersede an identical invocation that is still
+        // running. Its completion schedules the next due check, while semantic changes continue
+        // to coalesce into `pending` below.
+        if !changed && self.in_flight.is_some() {
+            return Ok(false);
+        }
+
+        self.desired_status_generation = self.desired_status_generation.wrapping_add(1);
+        let key = StatusLineCommandRequestKey {
+            thread_id: self.active_thread_id,
+            command_generation: self.command_generation,
+            request_id: self.next_request_id,
+            status_generation: self.desired_status_generation,
+        };
+        self.next_request_id = self.next_request_id.wrapping_add(1);
+        let request = PendingRequest {
+            key,
+            config,
+            stdin_json: stdin_json.clone(),
+            cwd,
+            terminal: self.terminal,
+        };
+        self.last_requested_json = Some(stdin_json);
+        self.last_requested_at = Some(now);
+        if self.in_flight.is_some() {
+            self.pending = Some(request);
+        } else {
+            self.launch(request, tx);
+        }
+        Ok(true)
+    }
+
+    pub(crate) fn complete(
+        &mut self,
+        completion: StatusLineCommandCompletion,
+        tx: &AppEventSender,
+    ) -> bool {
+        if self.in_flight.as_ref().map(|run| run.key) != Some(completion.key) {
+            return false;
+        }
+        self.in_flight = None;
+
+        let is_current = completion.key.thread_id == self.active_thread_id
+            && completion.key.command_generation == self.command_generation
+            && completion.key.status_generation == self.desired_status_generation;
+        if is_current {
+            match completion.result {
+                Ok(lines) => {
+                    self.last_success = Some(CachedOutput {
+                        thread_id: completion.key.thread_id,
+                        command_generation: completion.key.command_generation,
+                        lines,
+                    });
+                }
+                Err(err) => tracing::debug!(error = %err, "status-line command failed"),
+            }
+        }
+
+        if let Some(pending) = self.pending.take()
+            && pending.key.thread_id == self.active_thread_id
+            && pending.key.command_generation == self.command_generation
+            && pending.key.status_generation == self.desired_status_generation
+        {
+            self.launch(pending, tx);
+        }
+        is_current
+    }
+
+    pub(crate) fn output(&self) -> Option<Vec<Line<'static>>> {
+        self.last_success.as_ref().and_then(|cached| {
+            (cached.thread_id == self.active_thread_id
+                && cached.command_generation == self.command_generation)
+                .then(|| cached.lines.clone())
+        })
+    }
+
+    pub(crate) fn cancel_for_handoff(&mut self) {
+        if let Some(in_flight) = self.in_flight.as_ref() {
+            in_flight.cancellation.cancel();
+        }
+        self.desired_status_generation = self.desired_status_generation.wrapping_add(1);
+        self.pending = None;
+        self.last_requested_json = None;
+        self.last_requested_at = None;
+    }
+
+    fn launch(&mut self, request: PendingRequest, tx: &AppEventSender) {
+        let cancellation = CancellationToken::new();
+        self.in_flight = Some(InFlightRequest {
+            key: request.key,
+            cancellation: cancellation.clone(),
+        });
+        let tx = tx.clone();
+        tokio::spawn(async move {
+            let key = request.key;
+            let result = runner::run_status_line_command(request, cancellation).await;
+            tx.send(AppEvent::StatusLineCommandCompleted(
+                StatusLineCommandCompletion { key, result },
+            ));
+        });
+    }
+}
+
+impl Drop for StatusLineCommandState {
+    fn drop(&mut self) {
+        if let Some(in_flight) = self.in_flight.as_ref() {
+            in_flight.cancellation.cancel();
+        }
+    }
+}

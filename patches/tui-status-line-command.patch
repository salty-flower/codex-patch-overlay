+fn validate_status_line_command(config: Option<&StatusLineCommandConfig>) -> std::io::Result<()> {
+    let Some(config) = config else {
+        return Ok(());
+    };
+    if config.command.is_empty() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "tui.status_line_command.command must contain an executable",
+        ));
+    }
+    if config.command[0].is_empty() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "tui.status_line_command.command executable must not be empty",
+        ));
+    }
+    if config.timeout_ms == 0 || config.timeout_ms > MAX_STATUS_LINE_COMMAND_TIMEOUT_MS {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            format!(
+                "tui.status_line_command.timeout_ms must be between 1 and {MAX_STATUS_LINE_COMMAND_TIMEOUT_MS}"
+            ),
+        ));
+    }
+    if !(MIN_STATUS_LINE_COMMAND_REFRESH_INTERVAL_MS..=MAX_STATUS_LINE_COMMAND_REFRESH_INTERVAL_MS)
+        .contains(&config.refresh_interval_ms)
+    {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            format!(
+                "tui.status_line_command.refresh_interval_ms must be between {MIN_STATUS_LINE_COMMAND_REFRESH_INTERVAL_MS} and {MAX_STATUS_LINE_COMMAND_REFRESH_INTERVAL_MS}"
+            ),
+        ));
+    }
+    Ok(())
+}

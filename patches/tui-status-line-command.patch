+#[test]
+fn a_current_failure_retains_the_last_success_for_the_same_context() {
+    let (tx, _rx) = sender();
+    let thread_id = ThreadId::new();
+    let mut state = StatusLineCommandState::default();
+    state.sync_context(Some(&config(vec!["renderer".to_string()])), Some(thread_id));
+    state.last_success = Some(CachedOutput {
+        thread_id: Some(thread_id),
+        command_generation: state.command_generation,
+        lines: vec![Line::from("last good")],
+    });
+    let key = StatusLineCommandRequestKey {
+        thread_id: Some(thread_id),
+        command_generation: state.command_generation,
+        request_id: 1,
+        status_generation: state.desired_status_generation,
+    };
+    state.in_flight = Some(InFlightRequest {
+        key,
+        cancellation: CancellationToken::new(),
+    });
+
+    assert!(state.complete(
+        StatusLineCommandCompletion {
+            key,
+            result: Err("boom".to_string()),
+        },
+        &tx,
+    ));
+    assert_eq!(state.output().unwrap()[0].to_string(), "last good");
+}

+#[tokio::test]
+async fn waits_for_a_real_terminal_and_coalesces_semantic_changes() {
+    let (tx, _rx) = sender();
+    let mut state = StatusLineCommandState::default();
+    state.sync_context(
+        Some(&config(vec!["unused".to_string()])),
+        Some(ThreadId::new()),
+    );
+    let now = Instant::now();
+
+    assert!(
+        !state
+            .request(&input("idle"), PathBuf::from("/repo"), now, &tx)
+            .unwrap()
+    );
+
+    state.set_terminal(Size::new(120, 40));
+    assert!(
+        state
+            .request(&input("idle"), PathBuf::from("/repo"), now, &tx)
+            .unwrap()
+    );
+    assert!(state.in_flight.is_some());
+    assert!(
+        !state
+            .request(
+                &input("idle"),
+                PathBuf::from("/repo"),
+                now + Duration::from_secs(11),
+                &tx,
+            )
+            .unwrap()
+    );
+
+    assert!(
+        state
+            .request(
+                &input("working"),
+                PathBuf::from("/repo"),
+                now + Duration::from_secs(11),
+                &tx,
+            )
+            .unwrap()
+    );
+    assert!(
+        state
+            .request(
+                &input("action-required"),
+                PathBuf::from("/repo"),
+                now + Duration::from_secs(12),
+                &tx,
+            )
+            .unwrap()
+    );
+    let pending = state.pending.as_ref().expect("newest snapshot is pending");
+    let pending_json: serde_json::Value = serde_json::from_slice(&pending.stdin_json).unwrap();
+    assert_eq!(pending_json["turn_state"], "action-required");
+    state.cancel_for_handoff();
+    assert!(state.pending.is_none());
+    assert!(
+        state
+            .in_flight
+            .as_ref()
+            .unwrap()
+            .cancellation
+            .is_cancelled()
+    );

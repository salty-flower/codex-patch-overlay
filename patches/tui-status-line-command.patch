+use std::process::Stdio;
+use std::time::Duration;
+
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio_util::sync::CancellationToken;
+
+use super::PendingRequest;
+use super::ansi::parse_status_line_output;
+
+const MAX_STDOUT_BYTES: usize = 16 * 1024;
+
+pub(super) async fn run_status_line_command(
+    request: PendingRequest,
+    cancellation: CancellationToken,
+) -> Result<Vec<ratatui::text::Line<'static>>, String> {
+    if cancellation.is_cancelled() {
+        return Err("command cancelled".to_string());
+    }
+    let Some((program, args)) = request.config.command.split_first() else {
+        return Err("command argv is empty".to_string());
+    };
+    let mut command = tokio::process::Command::new(program);
+    command
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .env("COLUMNS", request.terminal.width.to_string())
+        .env("LINES", request.terminal.height.to_string())
+        .kill_on_drop(true);
+    #[cfg(unix)]
+    command.process_group(0);
+    if request.cwd.is_dir() {
+        command.current_dir(&request.cwd);
+    }
+
+    let mut child = command
+        .spawn()
+        .map_err(|err| format!("failed to spawn command: {err}"))?;
+    let mut stdin = child
+        .stdin
+        .take()
+        .ok_or_else(|| "stdin pipe missing".to_string())?;
+    let mut stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| "stdout pipe missing".to_string())?;
+    let stdin_json = request.stdin_json;
+    let timeout_ms = request.config.timeout_ms;
+    let timeout = Duration::from_millis(timeout_ms);
+    let result = {
+        let operation = async {
+            let write = async move {
+                stdin
+                    .write_all(&stdin_json)
+                    .await
+                    .map_err(|err| format!("failed to write stdin: {err}"))?;
+                stdin
+                    .shutdown()
+                    .await
+                    .map_err(|err| format!("failed to close stdin: {err}"))
+            };
+            let read = async move {
+                let mut output = Vec::with_capacity(MAX_STDOUT_BYTES.min(4096));
+                let mut chunk = [0_u8; 4096];
+                loop {
+                    let count = stdout
+                        .read(&mut chunk)
+                        .await
+                        .map_err(|err| format!("failed to read stdout: {err}"))?;
+                    if count == 0 {
+                        return Ok(output);
+                    }
+                    if output.len().saturating_add(count) > MAX_STDOUT_BYTES {
+                        return Err(format!("stdout exceeded {MAX_STDOUT_BYTES} bytes"));
+                    }
+                    output.extend_from_slice(&chunk[..count]);
+                }
+            };
+            let wait = async {
+                child
+                    .wait()
+                    .await
+                    .map_err(|err| format!("failed to wait for command: {err}"))
+            };
+            tokio::try_join!(write, read, wait)
+        };
+        tokio::pin!(operation);
+
+        tokio::select! {
+            result = &mut operation => result,
+            _ = tokio::time::sleep(timeout) => Err(format!("command timed out after {timeout_ms} ms")),
+            _ = cancellation.cancelled() => Err("command cancelled".to_string()),
+        }
+    };
+    let ((), stdout, status) = match result {
+        Ok(result) => result,
+        Err(err) => {
+            kill_and_reap(&mut child).await;
+            return Err(err);
+        }
+    };
+    if !status.success() {
+        return Err(format!("command exited with {status}"));
+    }
+    parse_status_line_output(stdout)
+}
+
+async fn kill_and_reap(child: &mut tokio::process::Child) {
+    #[cfg(unix)]
+    if let Some(pid) = child.id() {
+        // The renderer is spawned as its own process group, so helpers cannot outlive a timeout,
+        // cancellation, or terminal handoff.
+        let _ = unsafe { libc::killpg(pid as libc::pid_t, libc::SIGKILL) };
+    }
+    let _ = child.kill().await;
+    let _ = child.wait().await;
+}

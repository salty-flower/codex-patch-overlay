+        refresh_interval_ms: 10_000,
+    });
+
+    // Match the real startup order: construction refreshes before the first draw has supplied a
+    // terminal size, so the built-in status line remains active and no command is launched.
+    chat.refresh_status_surfaces();
+    assert_eq!(chat.status_line_command_output(), None);
+    assert!(!invocations.exists());
+
+    chat.on_terminal_resize(Size::new(80, 25));
+    chat.on_terminal_resize(Size::new(80, 25));
+
+    let completion = tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        loop {
+            if let AppEvent::StatusLineCommandCompleted(completion) =
+                rx.recv().await.expect("status-line event channel closed")
+            {
+                break completion;
+            }
+        }
+    })
+    .await
+    .expect("status-line command did not complete");
+    assert!(chat.complete_status_line_command(completion));
+    tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+    assert_eq!(fs::read(&invocations).unwrap(), b"x");
+    while let Ok(event) = rx.try_recv() {
+        assert!(!matches!(event, AppEvent::StatusLineCommandCompleted(_)));
+    }
+    assert_eq!(
+        chat.status_line_command_output()
+            .unwrap()
+            .iter()
+            .map(Line::to_string)
+            .collect::<Vec<_>>(),
+        vec!["startup-custom".to_string()]
+    );
+}

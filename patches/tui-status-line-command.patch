+#[tokio::test]
+async fn runtime_config_rejects_invalid_status_line_command_values() {
+    for (toml, expected) in [
+        (
+            "[tui.status_line_command]\ncommand = []\n",
+            "command must contain an executable",
+        ),
+        (
+            "[tui.status_line_command]\ncommand = [\"\"]\n",
+            "command executable must not be empty",
+        ),
+        (
+            "[tui.status_line_command]\ncommand = [\"renderer\"]\ntimeout_ms = 0\n",
+            "timeout_ms must be between 1 and 5000",
+        ),
+        (
+            "[tui.status_line_command]\ncommand = [\"renderer\"]\ntimeout_ms = 5001\n",
+            "timeout_ms must be between 1 and 5000",
+        ),
+        (
+            "[tui.status_line_command]\ncommand = [\"renderer\"]\nrefresh_interval_ms = 999\n",
+            "refresh_interval_ms must be between 1000 and 3600000",
+        ),
+        (
+            "[tui.status_line_command]\ncommand = [\"renderer\"]\nrefresh_interval_ms = 3600001\n",
+            "refresh_interval_ms must be between 1000 and 3600000",
+        ),
+    ] {
+        let cfg = toml::from_str(toml).expect("test config should deserialize");
+        let err = Config::load_from_base_config_with_overrides(
+            cfg,
+            ConfigOverrides::default(),
+            tempdir().expect("tempdir").abs(),
+        )
+        .await
+        .expect_err("invalid status-line command should fail config loading");
+        assert!(
+            err.to_string().contains(expected),
+            "unexpected error: {err}"
+        );
+    }
+}

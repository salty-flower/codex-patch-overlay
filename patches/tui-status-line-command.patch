+        thread_id: Some(old_thread),
+        command_generation: state.command_generation,
+        lines: vec![Line::from("old thread")],
+    });
+    let stale_key = StatusLineCommandRequestKey {
+        thread_id: Some(old_thread),
+        command_generation: state.command_generation,
+        request_id: 7,
+        status_generation: state.desired_status_generation,
+    };
+    state.in_flight = Some(InFlightRequest {
+        key: stale_key,
+        cancellation: CancellationToken::new(),
+    });
+
+    state.sync_context(Some(&config), Some(new_thread));
+    assert_eq!(state.output(), None);
+    assert!(!state.complete(
+        StatusLineCommandCompletion {
+            key: stale_key,
+            result: Ok(vec![Line::from("stale")]),
+        },
+        &tx,
+    ));
+    assert_eq!(state.output(), None);
+}

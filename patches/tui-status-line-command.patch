+//! Snapshot construction and orchestration for the command-backed status line.
+
+use super::rate_limits::get_limits_duration;
+use super::status_surfaces::approval_mode_display;
+use super::status_surfaces::permissions_display;
+use super::*;
+use crate::status_line_command::StatusLineCommandCompletion;
+use crate::status_line_command::StatusLineCommandInputV1;
+use crate::status_line_command::StatusLineContextWindowV1;
+use crate::status_line_command::StatusLineCurrentUsageV1;
+use crate::status_line_command::StatusLineModelV1;
+use crate::status_line_command::StatusLineRateLimitWindowV1;
+use crate::status_line_command::StatusLineRateLimitsV1;
+use crate::status_line_command::StatusLineTerminalV1;
+use crate::status_line_command::StatusLineWorkspaceV1;
+use codex_protocol::models::BUILT_IN_PERMISSION_PROFILE_DANGER_FULL_ACCESS;
+use codex_protocol::models::BUILT_IN_PERMISSION_PROFILE_READ_ONLY;
+use codex_protocol::models::BUILT_IN_PERMISSION_PROFILE_WORKSPACE;
+
+impl ChatWidget {
+    pub(super) fn refresh_status_line_command_if_due(&mut self) {
+        let config = self.config.tui_status_line_command.clone();
+        self.status_line_command
+            .sync_context(config.as_ref(), self.thread_id);
+        if config.is_none() {
+            return;
+        }
+
+        let input = self.status_line_command_input_v1();
+        let cwd = self.status_line_cwd().to_path_buf();
+        match self
+            .status_line_command
+            .request(&input, cwd, Instant::now(), &self.app_event_tx)
+        {
+            Ok(true) => {
+                if let Some(config) = config {
+                    self.frame_requester
+                        .schedule_frame_in_guaranteed(Duration::from_millis(
+                            config.refresh_interval_ms,
+                        ));
+                }
+            }
+            Ok(false) => {}
+            Err(err) => tracing::debug!(error = %err, "failed to serialize status-line snapshot"),
+        }
+    }
+
+    pub(crate) fn complete_status_line_command(
+        &mut self,
+        completion: StatusLineCommandCompletion,
+    ) -> bool {
+        let accepted = self
+            .status_line_command
+            .complete(completion, &self.app_event_tx);
+        if accepted {
+            self.refresh_status_surfaces();
+        }
+        accepted
+    }
+
+    pub(crate) fn cancel_status_line_command_for_handoff(&mut self) {
+        self.status_line_command.cancel_for_handoff();
+    }
+
+    pub(super) fn status_line_command_output(&self) -> Option<Vec<Line<'static>>> {
+        self.status_line_command.output()
+    }
+
+    pub(super) fn set_status_line_terminal_size(&mut self, size: ratatui::layout::Size) -> bool {
+        self.status_line_command.set_terminal(size)
+    }
+
+    fn status_line_command_input_v1(&mut self) -> StatusLineCommandInputV1 {
+        let cwd = self.status_line_cwd().to_path_buf();
+        let project_dir = self.status_line_project_root();
+        let total = self.status_line_total_usage();
+        let current = self
+            .token_info
+            .as_ref()
+            .map(|info| info.last_token_usage.clone())
+            .unwrap_or_default();
+        let remaining = self.status_line_context_remaining_percent().unwrap_or(100) as f64;
+        let used = (100.0 - remaining).clamp(0.0, 100.0);
+        let terminal = self.status_line_command.terminal();
+
+        StatusLineCommandInputV1 {
+            schema_version: 1,
+            source: "codex",
+            workspace: StatusLineWorkspaceV1 {
+                current_dir: cwd.display().to_string(),
+                project_dir: project_dir.map(|path| path.display().to_string()),
+            },
+            model: StatusLineModelV1 {
+                id: self.current_model().to_string(),
+                display_name: self.model_display_name().to_string(),
+                provider: self.config.model_provider_id.clone(),
+            },
+            effort_level: self
+                .effective_reasoning_effort()
+                .and_then(|effort| serde_json::to_value(effort).ok())
+                .and_then(|value| value.as_str().map(str::to_string)),
+            permission_mode: status_line_permission_mode(&self.config),
+            // Mirror the built-in `approval-mode` status item: under `on-request` the
+            // "Approve for me" / "Ask for approval" toggle only changes
+            // `approvals_reviewer`, so the raw approval policy alone cannot distinguish it.
+            approval_mode: approval_mode_display(&self.config)
+                .to_ascii_lowercase()
+                .replace(' ', "-"),
+            collaboration_mode: match self.active_mode_kind() {
+                ModeKind::Plan => "plan",
+                ModeKind::Default => "default",
+            }
+            .to_string(),
+            turn_state: if self.bottom_pane.terminal_title_requires_action() {
+                "action-required"
+            } else if self.bottom_pane.is_task_running() {
+                "working"
+            } else {
+                "idle"
+            }
+            .to_string(),
+            context_window: StatusLineContextWindowV1 {
+                used_percentage: used,
+                remaining_percentage: remaining,
+                context_window_size: self.status_line_context_window_size(),
+                total_input_tokens: total.input_tokens,
+                total_output_tokens: total.output_tokens,
+                current_usage: StatusLineCurrentUsageV1 {
+                    input_tokens: current.non_cached_input(),
+                    cache_creation_input_tokens: None,
+                    cache_read_input_tokens: current.cached_input_tokens,
+                    output_tokens: current.output_tokens,
+                    reasoning_output_tokens: current.reasoning_output_tokens,
+                },
+            },
+            rate_limits: self.status_line_command_rate_limits(),
+            session_id: self.thread_id.map(|id| id.to_string()),
+            session_name: self.thread_name.clone(),
+            version: CODEX_CLI_VERSION.to_string(),
+            git_branch: self.status_line_branch.clone(),
+            terminal: StatusLineTerminalV1 {
+                columns: terminal.width,
+                rows: terminal.height,
+            },
+        }
+    }
+
+    fn status_line_command_rate_limits(&self) -> StatusLineRateLimitsV1 {
+        let mut windows = Vec::new();
+        let mut five_hour = None;
+        let mut seven_day = None;
+        for (limit_id, snapshot) in &self.rate_limit_snapshots_by_limit_id {
+            for (name, window) in [
+                ("primary", snapshot.primary.as_ref()),
+                ("secondary", snapshot.secondary.as_ref()),
+            ] {
+                let Some(window) = window else {
+                    continue;
+                };
+                let name = if limit_id == "codex" {
+                    name.to_string()
+                } else {
+                    format!("{limit_id}.{name}")
+                };
+                let serialized = StatusLineRateLimitWindowV1 {
+                    name,
+                    window_minutes: window.window_minutes,
+                    used_percentage: window.used_percent,
+                    resets_at: window.resets_at_unix,
+                };
+                if limit_id == "codex" {
+                    match window
+                        .window_minutes
+                        .and_then(get_limits_duration)
+                        .as_deref()
+                    {
+                        Some("5h") => five_hour = Some(serialized.clone()),
+                        Some("weekly") => seven_day = Some(serialized.clone()),
+                        _ => {}
+                    }
+                }
+                windows.push(serialized);
+            }
+        }
+        StatusLineRateLimitsV1 {
+            five_hour,
+            seven_day,
+            windows,
+        }
+    }
+}
+
+fn status_line_permission_mode(config: &Config) -> String {
+    if let Some(active) = config.permissions.active_permission_profile() {
+        return match active.id.as_str() {
+            BUILT_IN_PERMISSION_PROFILE_READ_ONLY => "read-only".to_string(),
+            BUILT_IN_PERMISSION_PROFILE_WORKSPACE => "workspace-write".to_string(),
+            BUILT_IN_PERMISSION_PROFILE_DANGER_FULL_ACCESS => "danger-full-access".to_string(),
+            id => id.to_string(),
+        };
+    }
+    match config.permissions.effective_permission_profile() {
+        PermissionProfile::Disabled => "danger-full-access".to_string(),
+        PermissionProfile::External { .. } => "external".to_string(),
+        PermissionProfile::Managed { .. } => permissions_display(config)
+            .to_ascii_lowercase()
+            .replace(' ', "-"),
+    }
+}

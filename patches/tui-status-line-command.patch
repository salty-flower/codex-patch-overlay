+#[tokio::test]
+async fn snapshot_uses_cumulative_totals_current_context_and_terminal_size() {
+    let (mut chat, _sender, _rx, _op_rx) = make_chatwidget_manual_with_sender().await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.thread_name = Some("named session".to_string());
+    chat.status_line_branch = Some("feature/status".to_string());
+    chat.token_info = Some(TokenUsageInfo {
+        total_token_usage: TokenUsage {
+            input_tokens: 123_456,
+            cached_input_tokens: 40_000,
+            output_tokens: 23_456,
+            reasoning_output_tokens: 3_456,
+            total_tokens: 146_912,
+        },
+        last_token_usage: TokenUsage {
+            input_tokens: 50_000,
+            cached_input_tokens: 32_000,
+            output_tokens: 4_000,
+            reasoning_output_tokens: 1_200,
+            total_tokens: 54_000,
+        },
+        model_context_window: Some(272_000),
+    });
+    chat.set_status_line_terminal_size(Size::new(120, 40));
+
+    let snapshot = chat.status_line_command_input_v1();
+
+    assert_eq!(snapshot.context_window.total_input_tokens, 123_456);
+    assert_eq!(snapshot.context_window.total_output_tokens, 23_456);
+    assert_eq!(snapshot.context_window.current_usage.input_tokens, 18_000);
+    assert_eq!(
+        snapshot
+            .context_window
+            .current_usage
+            .cache_read_input_tokens,
+        32_000
+    );
+    assert_eq!(
+        snapshot
+            .context_window
+            .current_usage
+            .cache_creation_input_tokens,
+        None
+    );
+    // This deliberately freezes the same 12k-reserved calculation as the built-in status line.
+    assert_eq!(snapshot.context_window.used_percentage, 16.0);
+    assert_eq!(snapshot.context_window.remaining_percentage, 84.0);
+    assert_eq!(
+        snapshot.terminal,
+        StatusLineTerminalV1 {
+            columns: 120,
+            rows: 40
+        }
+    );
+    assert_eq!(snapshot.session_name.as_deref(), Some("named session"));
+    assert_eq!(snapshot.git_branch.as_deref(), Some("feature/status"));
+
+    chat.set_status_line_terminal_size(Size::new(72, 24));
+    assert_eq!(
+        chat.status_line_command_input_v1().terminal,
+        StatusLineTerminalV1 {
+            columns: 72,
+            rows: 24
+        }
+    );
+}

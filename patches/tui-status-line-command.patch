+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::text::Line;
+use ratatui::text::Span;
+
+use super::clip_status_line;
+use super::parse_status_line_output;
+
+fn text(lines: &[Line<'_>]) -> Vec<String> {
+    lines.iter().map(Line::to_string).collect()
+}
+
+#[test]
+fn parses_plain_unicode_and_at_most_two_lines() {
+    let lines = parse_status_line_output("ready ✓\n第二行\n".as_bytes().to_vec()).unwrap();
+    assert_eq!(text(&lines), ["ready ✓", "第二行"]);
+
+    let err = parse_status_line_output(b"one\ntwo\nthree".to_vec()).unwrap_err();
+    assert!(err.contains("more than two lines"));
+}
+
+#[test]
+fn whitespace_only_output_is_a_successful_empty_status_line() {
+    assert!(
+        parse_status_line_output(b" \t\r\n".to_vec())
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[allow(
+    clippy::disallowed_methods,
+    reason = "the parser must be asserted against ANSI 256-color and true-color values"
+)]
+#[test]
+fn parses_sgr_styles_and_resets_each_row() {
+    let lines = parse_status_line_output(
+        b"\x1b[1;31mred\x1b[22;39m plain\n\x1b[38;5;42mindexed \x1b[38;2;1;2;3mrgb".to_vec(),
+    )
+    .unwrap();
+
+    assert_eq!(lines[0].spans[0].content, "red");
+    assert_eq!(lines[0].spans[0].style.fg, Some(Color::Red));
+    assert!(
+        lines[0].spans[0]
+            .style
+            .add_modifier
+            .contains(Modifier::BOLD)
+    );
+    assert_eq!(lines[0].spans[1].style.fg, Some(Color::Reset));
+    assert_eq!(lines[1].spans[0].style.fg, Some(Color::Indexed(42)));
+    assert_eq!(lines[1].spans[1].style.fg, Some(Color::Rgb(1, 2, 3)));
+    assert!(
+        !lines[1].spans[0]
+            .style
+            .add_modifier
+            .contains(Modifier::BOLD)
+    );
+}
+
+#[test]
+fn rejects_non_sgr_terminal_controls_and_malformed_input() {
+    for unsafe_output in [
+        b"ok\x1b]0;owned\x07".as_slice(),
+        b"ok\x1b]8;;https://example.test\x07link\x1b]8;;\x07".as_slice(),
+        b"ok\x1b[2J".as_slice(),
+        b"ok\x1b[1A".as_slice(),
+        b"ok\x1bPpayload\x1b\\".as_slice(),
+        b"ok\x1b[31".as_slice(),
+        b"ok\0".as_slice(),
+        b"ok\tbad".as_slice(),
+    ] {
+        assert!(parse_status_line_output(unsafe_output.to_vec()).is_err());
+    }
+    assert!(parse_status_line_output(vec![0xff]).is_err());
+}
+
+#[test]
+fn no_escape_bytes_survive_parsing() {
+    let lines = parse_status_line_output(b"\x1b[32msafe\x1b[0m".to_vec()).unwrap();
+    assert!(
+        lines
+            .iter()
+            .all(|line| !line.to_string().contains('\u{1b}'))
+    );
+}
+
+#[test]
+fn clips_by_display_cells_preserving_styles_and_combining_marks() {
+    let line = Line::from(vec![
+        Span::styled("A界", ratatui::style::Style::default().fg(Color::Cyan)),
+        Span::raw("e\u{301}Z"),
+    ]);
+    let clipped = clip_status_line(&line, 4);
+
+    assert_eq!(clipped.to_string(), "A界e\u{301}");
+    assert_eq!(clipped.spans[0].style.fg, Some(Color::Cyan));
+}

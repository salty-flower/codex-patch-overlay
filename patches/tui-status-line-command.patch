diff --git a/codex-rs/tui/src/status_line_command/ansi.rs b/codex-rs/tui/src/status_line_command/ansi.rs
new file mode 100644
index 000000000..036d1a744
--- /dev/null
+++ b/codex-rs/tui/src/status_line_command/ansi.rs
@@ -0,0 +1,189 @@
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use ratatui::style::Styled;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use unicode_width::UnicodeWidthChar;
+
+pub(super) fn parse_status_line_output(stdout: Vec<u8>) -> Result<Vec<Line<'static>>, String> {
+    let mut text =
+        String::from_utf8(stdout).map_err(|_| "stdout is not valid UTF-8".to_string())?;
+    if text.ends_with('\n') {
+        text.pop();
+    }
+    if text.chars().all(char::is_whitespace) {
+        return Ok(Vec::new());
+    }
+
+    let mut lines = vec![Line::default()];
+    let mut style = Style::default();
+    let mut plain = String::new();
+    let mut chars = text.chars().peekable();
+    while let Some(ch) = chars.next() {
+        match ch {
+            '\n' => {
+                flush(&mut lines, &mut plain, style);
+                if lines.len() == 2 {
+                    return Err("stdout contains more than two lines".to_string());
+                }
+                lines.push(Line::default());
+                style = Style::default();
+            }
+            '\u{1b}' => {
+                flush(&mut lines, &mut plain, style);
+                if chars.next() != Some('[') {
+                    return Err("stdout contains a non-CSI escape sequence".to_string());
+                }
+                let mut sequence = String::new();
+                loop {
+                    let Some(next) = chars.next() else {
+                        return Err("stdout contains an unterminated CSI sequence".to_string());
+                    };
+                    if next == 'm' {
+                        break;
+                    }
+                    if !next.is_ascii_digit() && next != ';' {
+                        return Err("stdout contains a non-SGR CSI sequence".to_string());
+                    }
+                    sequence.push(next);
+                    if sequence.len() > 64 {
+                        return Err("stdout contains an oversized SGR sequence".to_string());
+                    }
+                }
+                style = apply_sgr(style, &sequence)?;
+            }
+            c if c.is_control() || ('\u{80}'..='\u{9f}').contains(&c) => {
+                return Err("stdout contains a disallowed control character".to_string());
+            }
+            _ => plain.push(ch),
+        }
+    }
+    flush(&mut lines, &mut plain, style);
+    Ok(lines)
+}
+
+fn flush(lines: &mut [Line<'static>], plain: &mut String, style: Style) {
+    if !plain.is_empty()
+        && let Some(line) = lines.last_mut()
+    {
+        line.spans
+            .push(Span::from(std::mem::take(plain)).set_style(style));
+    }
+}
+
+fn apply_sgr(mut style: Style, sequence: &str) -> Result<Style, String> {
+    let params = if sequence.is_empty() {
+        vec![0]
+    } else {
+        sequence
+            .split(';')
+            .map(|part| {
+                part.parse::<u16>()
+                    .map_err(|_| "invalid SGR parameter".to_string())
+            })
+            .collect::<Result<Vec<_>, _>>()?
+    };
+    let mut index = 0;
+    while index < params.len() {
+        let param = params[index];
+        match param {
+            0 => style = Style::default(),
+            1 => style = style.add_modifier(Modifier::BOLD),
+            2 => style = style.add_modifier(Modifier::DIM),
+            3 => style = style.add_modifier(Modifier::ITALIC),
+            4 => style = style.add_modifier(Modifier::UNDERLINED),
+            7 => style = style.add_modifier(Modifier::REVERSED),
+            9 => style = style.add_modifier(Modifier::CROSSED_OUT),
+            22 => style = style.remove_modifier(Modifier::BOLD | Modifier::DIM),
+            23 => style = style.remove_modifier(Modifier::ITALIC),
+            24 => style = style.remove_modifier(Modifier::UNDERLINED),
+            27 => style = style.remove_modifier(Modifier::REVERSED),
+            29 => style = style.remove_modifier(Modifier::CROSSED_OUT),
+            30..=37 | 90..=97 => style = style.fg(ansi_color(param)),
+            39 => style = style.fg(Color::Reset),
+            40..=47 | 100..=107 => style = style.bg(ansi_color(param - 10)),
+            49 => style = style.bg(Color::Reset),
+            38 | 48 => {
+                let foreground = param == 38;
+                let (color, consumed) = extended_color(&params[index + 1..])?;
+                style = if foreground {
+                    style.fg(color)
+                } else {
+                    style.bg(color)
+                };
+                index += consumed;
+            }
+            _ => return Err(format!("unsupported SGR parameter {param}")),
+        }
+        index += 1;
+    }
+    Ok(style)
+}
+
+#[allow(
+    clippy::disallowed_methods,
+    reason = "ANSI 256-color and true-color SGR sequences require these ratatui variants"
+)]
+fn extended_color(params: &[u16]) -> Result<(Color, usize), String> {
+    match params {
+        [5, index, ..] if *index <= 255 => Ok((Color::Indexed(*index as u8), 2)),
+        [2, red, green, blue, ..] if *red <= 255 && *green <= 255 && *blue <= 255 => {
+            Ok((Color::Rgb(*red as u8, *green as u8, *blue as u8), 4))
+        }
+        _ => Err("invalid extended SGR color".to_string()),
+    }
+}
+
+fn ansi_color(code: u16) -> Color {
+    match code {
+        30 => Color::Black,
+        31 => Color::Red,
+        32 => Color::Green,
+        33 => Color::Yellow,
+        34 => Color::Blue,
+        35 => Color::Magenta,
+        36 => Color::Cyan,
+        37 => Color::Gray,
+        90 => Color::DarkGray,
+        91 => Color::LightRed,
+        92 => Color::LightGreen,
+        93 => Color::LightYellow,
+        94 => Color::LightBlue,
+        95 => Color::LightMagenta,
+        96 => Color::LightCyan,
+        97 => Color::White,
+        _ => Color::Reset,
+    }
+}
+
+pub(crate) fn clip_status_line(line: &Line<'static>, max_width: usize) -> Line<'static> {
+    let mut width = 0;
+    let mut clipped = Line::default();
+    'spans: for span in &line.spans {
+        let mut content = String::new();
+        for ch in span.content.chars() {
+            let char_width = ch.width().unwrap_or(0);
+            if width + char_width > max_width {
+                if !content.is_empty() {
+                    clipped
+                        .spans
+                        .push(Span::from(content).set_style(span.style));
+                }
+                break 'spans;
+            }
+            content.push(ch);
+            width += char_width;
+        }
+        if !content.is_empty() {
+            clipped
+                .spans
+                .push(Span::from(content).set_style(span.style));
+        }
+    }
+    clipped
+}
+

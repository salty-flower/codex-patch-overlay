+#[cfg(unix)]
+mod runner_tests {
+    use std::fs;
+    use std::os::unix::fs::PermissionsExt;
+
+    use pretty_assertions::assert_eq;
+    use tempfile::TempDir;
+
+    use super::*;
+
+    fn helper(temp: &TempDir) -> PathBuf {
+        let path = temp.path().join("renderer");
+        fs::write(
+            &path,
+            r#"#!/bin/sh
+mode=$1
+case "$mode" in
+  record)
+    input=
+    while IFS= read -r chunk || [ -n "$chunk" ]; do input="${input}${chunk}"; done
+    printf '%s' "$input" > "$2"
+    printf '%s|%s|%s' "$PWD" "$COLUMNS" "$LINES"
+    ;;
+  argv) printf '%s' "$2" ;;
+  one) printf '\033[31mone\033[0m' ;;
+  two) printf 'one\ntwo' ;;
+  empty) printf '  \n' ;;
+  fail) exit 23 ;;
+  invalid) printf '\377' ;;
+  timeout) printf '%s' "$$" > "$2"; while :; do :; done ;;
+  oversized) i=0; while [ "$i" -lt 17000 ]; do printf x; i=$((i + 1)); done; while :; do :; done ;;
+  stderr) i=0; while [ "$i" -lt 20000 ]; do printf 'diagnostic\n' >&2; i=$((i + 1)); done; printf done ;;
+esac
+"#,
+        )
+        .unwrap();
+        let mut permissions = fs::metadata(&path).unwrap().permissions();
+        permissions.set_mode(0o755);
+        fs::set_permissions(&path, permissions).unwrap();
+        path
+    }
+
+    async fn run(
+        command: Vec<String>,
+        cwd: PathBuf,
+        timeout_ms: u64,
+        cancellation: CancellationToken,
+    ) -> Result<Vec<Line<'static>>, String> {
+        runner::run_status_line_command(
+            PendingRequest {
+                key: StatusLineCommandRequestKey {
+                    thread_id: Some(ThreadId::new()),
+                    command_generation: 1,
+                    request_id: 1,
+                    status_generation: 1,
+                },
+                config: StatusLineCommandConfig {
+                    command,
+                    timeout_ms,
+                    refresh_interval_ms: 10_000,
+                },
+                stdin_json: br#"{"schema_version":1}"#.to_vec(),
+                cwd,
+                terminal: Size::new(83, 27),
+            },
+            cancellation,
+        )
+        .await
+    }
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn sends_json_cwd_and_terminal_environment_without_shell_expansion() {
+        let temp = TempDir::new().unwrap();
+        let helper = helper(&temp);
+        let recorded = temp.path().join("input.json");
+        let lines = run(
+            vec![
+                helper.display().to_string(),
+                "record".to_string(),
+                recorded.display().to_string(),
+            ],
+            temp.path().to_path_buf(),
+            1_000,
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+
+        assert_eq!(fs::read(&recorded).unwrap(), br#"{"schema_version":1}"#);
+        assert_eq!(
+            lines[0].to_string(),
+            format!("{}|83|27", temp.path().canonicalize().unwrap().display())
+        );
+
+        let literal = "$(touch should-not-exist); *";
+        let lines = run(
+            vec![
+                helper.display().to_string(),
+                "argv".to_string(),
+                literal.to_string(),
+            ],
+            temp.path().to_path_buf(),
+            1_000,
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(lines[0].to_string(), literal);
+        assert!(!temp.path().join("should-not-exist").exists());
+    }
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn handles_one_two_and_empty_successful_outputs() {
+        let temp = TempDir::new().unwrap();
+        let helper = helper(&temp);
+        for (mode, expected) in [
+            ("one", vec!["one"]),
+            ("two", vec!["one", "two"]),
+            ("empty", Vec::new()),
+        ] {
+            let lines = run(
+                vec![helper.display().to_string(), mode.to_string()],
+                temp.path().to_path_buf(),
+                1_000,
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+            assert_eq!(
+                lines.iter().map(Line::to_string).collect::<Vec<_>>(),
+                expected
+            );
+        }
+    }
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn reports_nonzero_invalid_utf8_and_oversized_stdout() {
+        let temp = TempDir::new().unwrap();
+        let helper = helper(&temp);
+        for (mode, expected) in [
+            ("fail", "command exited"),
+            ("invalid", "not valid UTF-8"),
+            ("oversized", "stdout exceeded"),
+        ] {
+            let err = run(
+                vec![helper.display().to_string(), mode.to_string()],
+                temp.path().to_path_buf(),
+                1_000,
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap_err();
+            assert!(err.contains(expected), "unexpected error: {err}");
+        }
+    }
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn timeout_and_cancellation_kill_and_reap_the_child() {
+        let temp = TempDir::new().unwrap();
+        let helper = helper(&temp);
+        let pid_file = temp.path().join("pid");
+        let err = run(
+            vec![
+                helper.display().to_string(),
+                "timeout".to_string(),
+                pid_file.display().to_string(),
+            ],
+            temp.path().to_path_buf(),
+            500,
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap_err();
+        assert!(err.contains("timed out"));
+        let pid: i32 = fs::read_to_string(&pid_file).unwrap().parse().unwrap();
+        assert_eq!(
+            unsafe { libc::kill(pid, 0) },
+            -1,
+            "timed-out child still exists"
+        );
+
+        let pid_file = temp.path().join("cancelled-pid");
+        let cancellation = CancellationToken::new();
+        let cancel = cancellation.clone();
+        let cancel_pid_file = pid_file.clone();
+        tokio::spawn(async move {
+            for _ in 0..100 {
+                if cancel_pid_file.exists() {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+            cancel.cancel();
+        });
+        let err = run(
+            vec![
+                helper.display().to_string(),
+                "timeout".to_string(),
+                pid_file.display().to_string(),
+            ],
+            temp.path().to_path_buf(),
+            1_000,
+            cancellation,
+        )
+        .await
+        .unwrap_err();
+        assert!(err.contains("cancelled"));
+        let pid: i32 = fs::read_to_string(&pid_file).unwrap().parse().unwrap();
+        assert_eq!(
+            unsafe { libc::kill(pid, 0) },
+            -1,
+            "cancelled child still exists"
+        );
+    }
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn discarded_stderr_cannot_deadlock_the_child() {
+        let temp = TempDir::new().unwrap();
+        let helper = helper(&temp);
+        let lines = run(
+            vec![helper.display().to_string(), "stderr".to_string()],
+            temp.path().to_path_buf(),
+            1_000,
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(lines[0].to_string(), "done");
+    }
+}

+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn responses_websocket_blackholed_reuse_reconnects_with_full_context() {
+    skip_if_no_network!();
+
+    let server = start_blackholed_websocket_recovery_server(
+        vec![
+            ev_response_created("resp-1"),
+            ev_assistant_message("msg_1", "assistant output"),
+            ev_completed("resp-1"),
+        ],
+        vec![ev_response_created("resp-2"), ev_completed("resp-2")],
+    )
+    .await;
+    let harness = websocket_harness_with_v2(&server, /*runtime_metrics_enabled*/ true).await;
+    let mut session = harness.client.new_session();
+    let prompt_one = prompt_with_input(vec![message_item("hello")]);
+    let prompt_two = prompt_with_input(vec![
+        message_item("hello"),
+        assistant_message_item("1", "assistant output"),
+        message_item("second"),
+    ]);
+
+    stream_until_complete(&mut session, &harness, &prompt_one).await;
+    let reconnect_started = tokio::time::Instant::now();
+    stream_until_complete(&mut session, &harness, &prompt_two).await;
+    assert!(
+        reconnect_started.elapsed() < Duration::from_secs(10),
+        "reconnect should be bounded by the five-second liveness probe"
+    );
+
+    assert_eq!(server.handshakes().len(), 2);
+    let connections = server.connections();
+    assert_eq!(connections.len(), 2);
+    let recovery_request = connections[1][0].body_json();
+    assert_eq!(recovery_request["type"].as_str(), Some("response.create"));
+    assert_eq!(recovery_request.get("previous_response_id"), None);
+    assert_eq!(
+        recovery_request["input"],
+        serde_json::to_value(&prompt_two.input).expect("serialize full recovery context")
+    );
+
+    server.shutdown().await;
+}

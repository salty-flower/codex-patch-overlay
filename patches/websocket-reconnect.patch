+
+async fn probe_liveness_with_timeout(
+    tx_command: &mpsc::Sender<WsCommand>,
+    timeout: Duration,
+) -> Result<(), ApiError> {
+    let deadline = Instant::now() + timeout;
+    let (tx_result, rx_result) = oneshot::channel();
+    match tokio::time::timeout_at(
+        deadline,
+        tx_command.send(WsCommand::Probe {
+            deadline,
+            tx_result,
+        }),
+    )
+    .await
+    {
+        Ok(Ok(())) => {}
+        Ok(Err(_)) => {
+            return Err(ApiError::Stream(
+                "websocket connection closed before liveness probe".to_string(),
+            ));
+        }
+        Err(_) => {
+            return Err(ApiError::Stream(
+                WEBSOCKET_LIVENESS_TIMEOUT_MESSAGE.to_string(),
+            ));
+        }
+    }
+
+    match tokio::time::timeout_at(deadline, rx_result).await {
+        // A probe that answered inside the budget carries real information even
+        // if this task happens to be polled at the boundary; reporting it as a
+        // timeout would tear down a healthy socket and hide a resumed-session
+        // rejection. The pump keeps authority over the connection state.
+        Ok(Ok(result)) => result.map_err(ApiError::Stream),
+        Ok(Err(_)) => Err(ApiError::Stream(
+            "websocket connection closed during liveness probe".to_string(),
+        )),
+        Err(_) => Err(ApiError::Stream(
+            WEBSOCKET_LIVENESS_TIMEOUT_MESSAGE.to_string(),
+        )),
+    }
+}
+
+async fn begin_liveness_probe<S>(inner: &mut S, deadline: Instant) -> Result<PendingProbe, WsError>
+where
+    S: futures::Sink<Message, Error = WsError> + Unpin,
+{
+    if deadline <= Instant::now() {
+        return Err(liveness_timeout_error());
+    }
+    let payload = NEXT_PROBE_ID
+        .fetch_add(1, Ordering::Relaxed)
+        .to_be_bytes()
+        .to_vec();
+    tokio::time::timeout_at(deadline, inner.send(Message::Ping(payload.clone().into())))
+        .await
+        .map_err(|_| liveness_timeout_error())??;
+    Ok(PendingProbe {
+        payload,
+        deadline,
+        waiters: Vec::new(),
+    })
+}
+
+fn liveness_timeout_error() -> WsError {
+    WsError::Io(std::io::Error::new(
+        std::io::ErrorKind::TimedOut,
+        WEBSOCKET_LIVENESS_TIMEOUT_MESSAGE,
+    ))
+}
+
+fn sample_clock(
+    last_clock_sample: &mut (Instant, SystemTime),
+    now: (Instant, SystemTime),
+    resume_gap: Duration,
+) -> bool {
+    let resumed = sleep_gap_detected(*last_clock_sample, now, resume_gap);
+    *last_clock_sample = now;
+    resumed
+}
+
+fn invalidate_pending_probe(pending_probe: &mut Option<PendingProbe>) {
+    if let Some(probe) = pending_probe.take() {
+        for waiter in probe.waiters {
+            let _ = waiter.send(Err(WEBSOCKET_LIVENESS_RESUMED_MESSAGE.to_string()));
+        }
+    }
+}
+
+fn sleep_gap_detected(
+    previous: (Instant, SystemTime),
+    current: (Instant, SystemTime),
+    resume_gap: Duration,
+) -> bool {
+    let awake_elapsed = current.0.saturating_duration_since(previous.0);
+    let wall_elapsed = current
+        .1
+        .duration_since(previous.1)
+        .unwrap_or(Duration::ZERO);
+    wall_elapsed.saturating_sub(awake_elapsed) >= resume_gap
+}

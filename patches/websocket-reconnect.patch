+/// Serves one response, silently blackholes that retained socket, then accepts a recovery socket.
+///
+/// Unlike `close_after_requests = false`, this fixture keeps accepting connections while the
+/// first peer remains open and unresponsive, so a reconnect can complete instead of deadlocking
+/// behind the original connection handler.
+pub async fn start_blackholed_websocket_recovery_server(
+    first_response: Vec<Value>,
+    recovery_response: Vec<Value>,
+) -> WebSocketTestServer {
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind websocket recovery server");
+    let addr = listener.local_addr().expect("websocket server address");
+    let uri = format!("ws://{addr}");
+    let connections_log = Arc::new(Mutex::new(Vec::new()));
+    let handshakes_log = Arc::new(Mutex::new(Vec::new()));
+    let request_log_updated = Arc::new(Notify::new());
+    let requests = Arc::clone(&connections_log);
+    let handshakes = Arc::clone(&handshakes_log);
+    let request_log = Arc::clone(&request_log_updated);
+    let (shutdown_tx, mut shutdown_rx) = oneshot::channel();
+
+    let task = tokio::spawn(async move {
+        let mut sockets = Vec::new();
+        for (connection_index, response_events) in
+            [first_response, recovery_response].into_iter().enumerate()
+        {
+            let (stream, _) = tokio::select! {
+                _ = &mut shutdown_rx => return,
+                accepted = listener.accept() => accepted.expect("accept websocket client"),
+            };
+            let handshake_log = Arc::clone(&handshakes);
+            let callback = move |req: &Request, response: Response| {
+                let headers = req
+                    .headers()
+                    .iter()
+                    .filter_map(|(name, value)| {
+                        value
+                            .to_str()
+                            .ok()
+                            .map(|value| (name.as_str().to_string(), value.to_string()))
+                    })
+                    .collect();
+                handshake_log.lock().unwrap().push(WebSocketHandshake {
+                    uri: req.uri().to_string(),
+                    headers,
+                });
+                Ok(response)
+            };
+            let mut websocket =
+                accept_hdr_async_with_config(stream, callback, Some(websocket_accept_config()))
+                    .await
+                    .expect("accept websocket handshake");
+            requests.lock().unwrap().push(Vec::new());
+
+            let body = loop {
+                let Some(Ok(message)) = websocket.next().await else {
+                    return;
+                };
+                if let Some(body) = parse_ws_request_body(message) {
+                    break body;
+                }
+            };
+            requests.lock().unwrap()[connection_index].push(WebSocketRequest { body });
+            request_log.notify_waiters();
+            for event in response_events {
+                let payload = serde_json::to_string(&event).expect("serialize websocket event");
+                websocket
+                    .send(Message::Text(payload.into()))
+                    .await
+                    .expect("send websocket event");
+            }
+
+            // Keeping the first socket alive without polling it simulates a silent network path:
+            // Tungstenite cannot observe Ping and therefore cannot synthesize Pong.
+            sockets.push(websocket);
+        }
+    });
+
+    WebSocketTestServer {
+        uri,
+        connections: connections_log,
+        handshakes: handshakes_log,
+        request_log_updated,
+        shutdown: shutdown_tx,
+        task,
+    }
+}

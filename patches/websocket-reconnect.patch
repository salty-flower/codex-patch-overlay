+    async fn resume_reprobes_before_accepting_a_buffered_pre_suspend_pong() {
+        let (socket, mut server) = memory_websocket_pair(1024).await;
+        let offset = Arc::new(AtomicU64::new(0));
+        let clock_offset = Arc::clone(&offset);
+        let started = Instant::now();
+        let mut liveness = test_liveness_config();
+        liveness.heartbeat_interval = Duration::from_secs(15);
+        let mut client = WsStream::new_with_liveness_and_clock(socket, liveness, move || {
+            SystemTime::UNIX_EPOCH
+                + started.elapsed()
+                + Duration::from_secs(clock_offset.load(Ordering::Relaxed))
+        });
+        let (tx_result, rx_result) = oneshot::channel();
+        client
+            .tx_command
+            .send(WsCommand::Probe {
+                deadline: started + liveness.probe_timeout,
+                tx_result,
+            })
+            .await
+            .expect("enqueue pre-suspend probe");
+        let Some(Ok(Message::Ping(old_payload))) = server.next().await else {
+            panic!("expected pre-suspend Ping");
+        };
+
+        // Suspend advances wall time but not Tokio's monotonic clock. A buffered old
+        // Pong and the clock tick can race; neither may preserve pre-suspend evidence.
+        offset.store(10, Ordering::Relaxed);
+        server.flush().await.expect("flush pre-suspend Pong");
+        let Some(Ok(Message::Ping(new_payload))) = server.next().await else {
+            panic!("expected fresh post-resume Ping");
+        };
+        assert_ne!(old_payload, new_payload);
+        assert_eq!(
+            rx_result
+                .await
+                .expect("old probe result")
+                .expect_err("invalidated probe"),
+            WEBSOCKET_LIVENESS_RESUMED_MESSAGE
+        );
+        // Do not flush the fresh Pong: the old Pong must not satisfy the fresh probe.
+        let error = client
+            .next()
+            .await
+            .expect("fresh probe must time out")
+            .expect_err("timeout");
+        assert!(
+            error
+                .to_string()
+                .contains(WEBSOCKET_LIVENESS_TIMEOUT_MESSAGE)
+        );
+        assert_eq!(started.elapsed(), liveness.probe_timeout);
+    }

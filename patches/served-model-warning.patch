+async fn response_body_model_matching_requested_does_not_warn() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let response = sse_response(sse(vec![
+        response_created_with_model("resp-1", &REQUESTED_MODEL.to_ascii_uppercase()),
+        ev_assistant_message("msg-1", "done"),
+        core_test_support::responses::ev_completed("resp-1"),
+    ]));
+    let _mock = mount_response_once(&server, response).await;
+
+    let mut builder = test_codex().with_model(REQUESTED_MODEL);
+    let test = builder.build(&server).await?;
+
+    test.codex
+        .start_or_steer_turn(disabled_text_turn(&test, "trigger matching body model"))
+        .await?;
+
+    let (reroute_count, warnings) = count_reroutes_and_substitution_warnings(&test).await;
+    assert_eq!(reroute_count, 0);
+    assert_eq!(warnings, Vec::<String>::new());
+
+    Ok(())
+}

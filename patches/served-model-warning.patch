+fn response_created_with_model(id: &str, model: &str) -> serde_json::Value {
+    serde_json::json!({
+        "type": "response.created",
+        "response": {
+            "id": id,
+            "model": model
+        }
+    })
+}
+
+/// Counts reroute events and served-model warnings until the turn completes.
+async fn count_reroutes_and_substitution_warnings(test: &TestCodex) -> (usize, Vec<String>) {
+    let mut reroute_count = 0;
+    let mut warnings = Vec::new();
+    loop {
+        match wait_for_event(&test.codex, |_| true).await {
+            EventMsg::ModelReroute(_) => reroute_count += 1,
+            EventMsg::Warning(warning) if warning.message.contains("substituted the model") => {
+                warnings.push(warning.message);
+            }
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    (reroute_count, warnings)
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn response_body_model_mismatch_warns_once_without_header() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let tool_args = serde_json::json!({
+        "cmd": "echo hello",
+        "yield_time_ms": 1_000
+    });
+    // Two sampling requests in one turn, both served by another model, with no header.
+    let first_response = sse_response(sse(vec![
+        response_created_with_model("resp-1", SERVER_MODEL),
+        ev_function_call(
+            "call-1",
+            "exec_command",
+            &serde_json::to_string(&tool_args)?,
+        ),
+        core_test_support::responses::ev_completed("resp-1"),
+    ]));
+    let second_response = sse_response(sse(vec![
+        response_created_with_model("resp-2", SERVER_MODEL),
+        ev_assistant_message("msg-1", "done"),
+        core_test_support::responses::ev_completed("resp-2"),
+    ]));
+    let _mock = mount_response_sequence(&server, vec![first_response, second_response]).await;
+
+    let mut builder = test_codex().with_model(REQUESTED_MODEL);
+    let test = builder.build(&server).await?;
+
+    test.codex
+        .start_or_steer_turn(disabled_text_turn(&test, "trigger body model check"))
+        .await?;
+
+    let (reroute_count, warnings) = count_reroutes_and_substitution_warnings(&test).await;
+    assert_eq!(reroute_count, 0);
+    assert_eq!(
+        warnings,
+        vec![format!(
+            "This turn was answered by {SERVER_MODEL}, not {REQUESTED_MODEL}. The server substituted the model without a reroute notice."
+        )]
+    );
+
+    Ok(())
+}

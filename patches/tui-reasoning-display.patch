+/// Build a visible reasoning-summary cell from the accumulated summary parts.
+///
+/// Whitespace-only parts and standalone empty placeholders are omitted, while headings, literal
+/// comments, and the original text and newlines of every visible part are retained. Keeping the
+/// concrete cell type lets callers attach the source item ID.
+pub(crate) fn new_visible_reasoning_summary_block(
+    reasoning_parts: Vec<String>,
+    cwd: &Path,
+) -> Option<Box<ReasoningSummaryCell>> {
+    let visible_parts = reasoning_parts
+        .iter()
+        .filter_map(|part| {
+            let trimmed = part.trim();
+            if trimmed.is_empty() || trimmed == "<!-- -->" {
+                return None;
+            }
+            if let Some(after_open) = trimmed.strip_prefix("**")
+                && let Some(close) = after_open.find("**")
+                && close > 0
+            {
+                let header_end = close + 4;
+                if trimmed[header_end..].trim() == "<!-- -->" {
+                    return Some(&trimmed[..header_end]);
+                }
+            }
+            Some(part.as_str())
+        })
+        .collect::<Vec<_>>();
+    if visible_parts.is_empty() {
+        return None;
+    }
+
+    let (header, _) = split_reasoning_summary_parts(&reasoning_parts);
+    Some(Box::new(ReasoningSummaryCell::new(
+        header,
+        visible_parts.join("\n\n"),
+        cwd,
+        /*transcript_only*/ false,
+    )))
+}

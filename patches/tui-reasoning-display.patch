+/// Build a visible reasoning-summary cell for live streaming and persistent transcript display.
+/// Returns `None` for summaries that contain only an activity heading or an empty placeholder.
+pub(crate) fn new_visible_reasoning_summary_block(
+    reasoning_parts: Vec<String>,
+    cwd: &Path,
+) -> Option<Box<dyn HistoryCell>> {
+    let (header, content) = split_reasoning_summary_parts(&reasoning_parts);
+    if !reasoning_summary_has_visible_body(&content) {
+        return None;
+    }
+    let visible_content = if header.is_empty() {
+        content
+    } else {
+        format!("{header}{content}")
+    };
+    Some(Box::new(ReasoningSummaryCell::new(
+        header,
+        visible_content,
+        cwd,
+        /*transcript_only*/ false,
+    )))
+}
+
+/// Check that a streamed summary has body text after any leading bold activity heading.
+fn reasoning_summary_has_visible_body(content: &str) -> bool {
+    let trimmed = content.trim();
+    let body = match trimmed.strip_prefix("**") {
+        Some(after_open) => match after_open.split_once("**") {
+            Some((_, rest)) => rest,
+            None => "",
+        },
+        None => trimmed,
+    };
+    !body.trim().is_empty()
+}

+use super::RawReasoningVisibility;
+use super::thread_items_to_transcript_cells;
+use super::thread_items_to_transcript_cells_with_display;
+use codex_app_server_protocol::ThreadItem;
+use codex_config::types::TuiReasoningDisplay;
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+fn render_reasoning(
+    summary: Vec<&str>,
+    content: Vec<&str>,
+    raw_visibility: RawReasoningVisibility,
+    display: TuiReasoningDisplay,
+) -> String {
+    let item = ThreadItem::Reasoning {
+        id: String::from("reasoning-1"),
+        summary: summary.into_iter().map(String::from).collect(),
+        content: content.into_iter().map(String::from).collect(),
+    };
+    let cwd = AbsolutePathBuf::current_dir().expect("cwd");
+    thread_items_to_transcript_cells_with_display(
+        /*thread_id*/ None,
+        &cwd,
+        [item],
+        raw_visibility,
+        display,
+        /*config*/ None,
+    )
+    .into_iter()
+    .flat_map(|cell| cell.transcript_lines(/*width*/ 80))
+    .map(|line| line.to_string())
+    .collect::<Vec<_>>()
+    .join("\n")
+}
+
+#[tokio::test]
+async fn persisted_projection_uses_the_configured_reasoning_display() {
+    let codex_home = tempfile::tempdir().expect("temporary codex home");
+    let mut config =
+        crate::legacy_core::config::Config::load_default_with_cli_overrides_for_codex_home(
+            codex_home.path().to_path_buf(),
+            Vec::new(),
+        )
+        .await
+        .expect("config");
+    config.tui_reasoning_display = TuiReasoningDisplay::Persistent;
+
+    let cwd = AbsolutePathBuf::current_dir().expect("cwd");
+    let item = ThreadItem::Reasoning {
+        id: String::from("reasoning-configured"),
+        summary: vec![String::from("**Configured heading**\n\nConfigured body.")],
+        content: Vec::new(),
+    };
+    let rendered = thread_items_to_transcript_cells(
+        /*thread_id*/ None,
+        &cwd,
+        [item],
+        RawReasoningVisibility::Hidden,
+        Some(&config),
+    )
+    .into_iter()
+    .flat_map(|cell| cell.transcript_lines(/*width*/ 80))
+    .map(|line| line.to_string())
+    .collect::<Vec<_>>()
+    .join("\n");
+
+    assert!(rendered.contains("Configured heading"), "{rendered:?}");
+    assert!(rendered.contains("Configured body."), "{rendered:?}");
+}
+
+#[test]
+fn persistent_projection_keeps_summary_headings_and_removes_empty_placeholders() {
+    let rendered = render_reasoning(
+        vec!["**Step one**\n\nThe summary body."],
+        vec!["private raw detail"],
+        RawReasoningVisibility::Hidden,
+        TuiReasoningDisplay::Persistent,
+    );
+
+    assert!(rendered.contains("Step one"), "{rendered:?}");
+    assert!(rendered.contains("The summary body."), "{rendered:?}");
+    assert!(!rendered.contains("<!-- -->"), "{rendered:?}");
+    assert!(!rendered.contains("private raw detail"), "{rendered:?}");
+
+    let heading_only = render_reasoning(
+        vec!["**Step two**\n\n<!-- -->"],
+        Vec::new(),
+        RawReasoningVisibility::Hidden,
+        TuiReasoningDisplay::Persistent,
+    );
+    assert!(heading_only.contains("Step two"), "{heading_only:?}");
+    assert!(!heading_only.contains("<!-- -->"), "{heading_only:?}");
+}
+
+#[test]
+fn hidden_projection_suppresses_summary_independently_of_raw_visibility() {
+    let rendered = render_reasoning(
+        vec!["**Do not show this summary**\n\nSummary text."],
+        vec!["raw detail remains governed by the raw setting"],
+        RawReasoningVisibility::Visible,
+        TuiReasoningDisplay::Hidden,
+    );
+
+    assert!(
+        !rendered.contains("Do not show this summary"),
+        "{rendered:?}"
+    );
+    assert!(!rendered.contains("Summary text."), "{rendered:?}");
+    assert!(
+        rendered.contains("raw detail remains governed by the raw setting"),
+        "{rendered:?}"
+    );
+}
+
+#[test]
+fn status_only_projection_retains_existing_heading_extraction() {
+    let rendered = render_reasoning(
+        vec!["**Step one**\n\nThe summary body."],
+        Vec::new(),
+        RawReasoningVisibility::Hidden,
+        TuiReasoningDisplay::StatusOnly,
+    );
+
+    assert!(!rendered.contains("Step one"), "{rendered:?}");
+    assert!(rendered.contains("The summary body."), "{rendered:?}");
+}

+
+    let cells = take_inserted_cells(&mut rx);
+    let exec_position = cells
+        .iter()
+        .position(|cell| {
+            cell.as_any()
+                .downcast_ref::<ExecCell>()
+                .is_some_and(|exec| exec.iter_calls().any(|call| call.call_id == "exec-call"))
+        })
+        .expect("completed exec is committed to history");
+    let reasoning_position = cells
+        .iter()
+        .position(|cell| {
+            cell.as_any()
+                .downcast_ref::<history_cell::ReasoningSummaryCell>()
+                .is_some_and(|reasoning| reasoning.source_item_id() == Some("reasoning-after-exec"))
+        })
+        .expect("completed reasoning is committed to history");
+    assert!(
+        exec_position < reasoning_position,
+        "history order: {cells:?}"
+    );

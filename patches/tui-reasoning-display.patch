+#[test]
+fn persistent_projection_keeps_visible_summaries_between_tool_groups() {
+    let cwd = AbsolutePathBuf::current_dir().expect("cwd");
+    for computer in [false, true] {
+        let tool = |id: &str| {
+            let value = if computer {
+                serde_json::json!({
+                    "type": "mcpToolCall", "id": id, "server": "cua_repl", "tool": "js",
+                    "status": "completed", "arguments": {"title": format!("Inspect {id}")},
+                    "result": {"content": [{"type": "text", "text": format!("Result {id}")}]},
+                    "durationMs": 10
+                })
+            } else {
+                serde_json::json!({
+                    "type": "commandExecution", "id": id, "command": format!("cat {id}.rs"),
+                    "cwd": cwd.as_path(), "source": "agent", "status": "completed",
+                    "commandActions": [{"type": "read", "command": format!("cat {id}.rs"), "name": format!("{id}.rs"), "path": format!("{id}.rs")}],
+                    "aggregatedOutput": format!("Result {id}"), "exitCode": 0, "durationMs": 10
+                })
+            };
+            serde_json::from_value::<ThreadItem>(value).expect("tool fixture")
+        };
+        let cells = thread_items_to_transcript_cells_with_display(
+            None,
+            &cwd,
+            [
+                tool("before"),
+                ThreadItem::Reasoning {
+                    id: "between-tools".to_string(),
+                    summary: vec!["**Visible heading**\n\nRetained summary.".to_string()],
+                    content: Vec::new(),
+                },
+                tool("after"),
+            ],
+            RawReasoningVisibility::Hidden,
+            TuiReasoningDisplay::Persistent,
+            None,
+        );
+        assert_eq!(cells.len(), 3);
+        let summary = cells[1]
+            .as_any()
+            .downcast_ref::<crate::history_cell::ReasoningSummaryCell>()
+            .expect("standalone visible summary");
+        assert_eq!(summary.source_item_id(), Some("between-tools"));
+        let visible = cells[1]
+            .display_lines(80)
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(visible.contains("Visible heading"), "{visible}");
+        assert!(visible.contains("Retained summary"), "{visible}");
+    }
+}

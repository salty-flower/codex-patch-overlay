+//! Behavioral coverage for configurable reasoning-summary visibility.
+
+use super::*;
+use codex_config::types::TuiReasoningDisplay;
+use pretty_assertions::assert_eq;
+
+fn thread_id(chat: &ChatWidget) -> String {
+    chat.thread_id.map(|id| id.to_string()).unwrap_or_default()
+}
+
+fn active_turn_id(chat: &ChatWidget) -> String {
+    chat.turn_lifecycle
+        .last_turn_id
+        .clone()
+        .unwrap_or_else(|| "turn-1".to_string())
+}
+
+fn start_reasoning(chat: &mut ChatWidget, item_id: &str) {
+    let notification = ServerNotification::ItemStarted(ItemStartedNotification {
+        thread_id: thread_id(chat),
+        turn_id: active_turn_id(chat),
+        started_at_ms: 0,
+        item: AppServerThreadItem::Reasoning {
+            id: item_id.to_string(),
+            summary: Vec::new(),
+            content: Vec::new(),
+        },
+    });
+    chat.handle_server_notification(notification, /*replay_kind*/ None);
+}
+
+fn summary_delta(chat: &mut ChatWidget, item_id: &str, delta: &str) {
+    let notification =
+        ServerNotification::ReasoningSummaryTextDelta(ReasoningSummaryTextDeltaNotification {
+            thread_id: thread_id(chat),
+            turn_id: active_turn_id(chat),
+            item_id: item_id.to_string(),
+            delta: delta.to_string(),
+            summary_index: 0,
+        });
+    chat.handle_server_notification(notification, /*replay_kind*/ None);
+}
+
+fn raw_reasoning_delta(chat: &mut ChatWidget, item_id: &str, delta: &str) {
+    let notification = ServerNotification::ReasoningTextDelta(
+        codex_app_server_protocol::ReasoningTextDeltaNotification {
+            thread_id: thread_id(chat),
+            turn_id: active_turn_id(chat),
+            item_id: item_id.to_string(),
+            delta: delta.to_string(),
+            content_index: 0,
+        },
+    );
+    chat.handle_server_notification(notification, /*replay_kind*/ None);
+}
+
+fn complete_reasoning(
+    chat: &mut ChatWidget,
+    item_id: &str,
+    summary: Vec<String>,
+    content: Vec<String>,
+) {
+    let notification = ServerNotification::ItemCompleted(ItemCompletedNotification {
+        thread_id: thread_id(chat),
+        turn_id: active_turn_id(chat),
+        completed_at_ms: 0,
+        item: AppServerThreadItem::Reasoning {
+            id: item_id.to_string(),
+            summary,
+            content,
+        },
+    });
+    chat.handle_server_notification(notification, /*replay_kind*/ None);
+}
+
+fn take_inserted_cells(
+    rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> Vec<Box<dyn HistoryCell>> {
+    let mut cells = Vec::new();
+    while let Ok(event) = rx.try_recv() {
+        if let AppEvent::InsertHistoryCell(cell) = event {
+            cells.push(cell);
+        }
+    }
+    cells
+}
+
+fn reasoning_cells(cells: Vec<Box<dyn HistoryCell>>) -> Vec<Box<dyn HistoryCell>> {
+    cells
+        .into_iter()
+        .filter(|cell| cell.as_any().is::<history_cell::ReasoningSummaryCell>())
+        .collect()
+}
+
+fn reasoning_cell(cell: &dyn HistoryCell) -> &history_cell::ReasoningSummaryCell {
+    cell.as_any()
+        .downcast_ref::<history_cell::ReasoningSummaryCell>()
+        .expect("reasoning summary cell")
+}
+
+fn live_reasoning_text(chat: &ChatWidget, width: u16) -> Option<String> {
+    chat.transcript
+        .live_reasoning_cell
+        .as_deref()
+        .map(|cell| lines_to_single_string(&cell.transcript_lines(width)))
+}

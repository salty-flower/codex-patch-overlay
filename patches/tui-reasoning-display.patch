+#[test]
+fn tui_reasoning_display_defaults_to_status_only() {
+    let parsed = toml::from_str::<ConfigToml>("[tui]")
+        .expect("TUI config without a reasoning display should succeed");
+    assert_eq!(
+        parsed
+            .tui
+            .expect("config should include tui section")
+            .reasoning_display,
+        TuiReasoningDisplay::StatusOnly,
+    );
+}
+
+#[test]
+fn tui_reasoning_display_config_parses_all_modes() {
+    for (value, expected) in [
+        ("status-only", TuiReasoningDisplay::StatusOnly),
+        ("persistent", TuiReasoningDisplay::Persistent),
+        ("hidden", TuiReasoningDisplay::Hidden),
+    ] {
+        let config = format!("[tui]\nreasoning_display = {value:?}");
+        let parsed = toml::from_str::<ConfigToml>(&config).expect("reasoning display config");
+        assert_eq!(
+            parsed.tui.expect("tui config").reasoning_display,
+            expected,
+            "unexpected mode for {value:?}"
+        );
+    }
+}
+
+#[test]
+fn tui_reasoning_display_rejects_unknown_values() {
+    let error = toml::from_str::<ConfigToml>("[tui]\nreasoning_display = 'off'")
+        .expect_err("unknown reasoning display values must be rejected");
+    assert!(
+        error.to_string().contains("unknown variant `off`"),
+        "unexpected error: {error}"
+    );
+}
+
+#[tokio::test]
+async fn runtime_config_resolves_tui_reasoning_display() {
+    let default_config = Config::load_from_base_config_with_overrides(
+        ConfigToml::default(),
+        ConfigOverrides::default(),
+        tempdir().expect("tempdir").abs(),
+    )
+    .await
+    .expect("load default config");
+    assert_eq!(
+        default_config.tui_reasoning_display,
+        TuiReasoningDisplay::StatusOnly
+    );
+
+    for mode in [
+        TuiReasoningDisplay::StatusOnly,
+        TuiReasoningDisplay::Persistent,
+        TuiReasoningDisplay::Hidden,
+    ] {
+        let config = Config::load_from_base_config_with_overrides(
+            ConfigToml {
+                tui: Some(Tui {
+                    reasoning_display: mode,
+                    ..Default::default()
+                }),
+                ..Default::default()
+            },
+            ConfigOverrides::default(),
+            tempdir().expect("tempdir").abs(),
+        )
+        .await
+        .expect("load configured reasoning display");
+        assert_eq!(config.tui_reasoning_display, mode);
+    }
+}

+#[tokio::test]
+async fn persistent_reasoning_reconciles_streamed_and_completion_only_items() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.on_task_started();
+    chat.local_settings.tui.reasoning_display = TuiReasoningDisplay::Persistent;
+    drain_insert_history(&mut rx);
+
+    let long_word = "reasoningcontent".repeat(12);
+    start_reasoning(&mut chat, "reasoning-one");
+    summary_delta(
+        &mut chat,
+        "reasoning-one",
+        "**Step one**\n\nStreamed prefix that must be replaced.",
+    );
+
+    let preview = chat
+        .transcript
+        .live_reasoning_cell
+        .as_deref()
+        .expect("persistent mode exposes a live preview");
+    assert_eq!(
+        reasoning_cell(preview).source_item_id(),
+        Some("reasoning-one")
+    );
+    assert!(chat.transcript.active_cell.is_none());
+
+    let authoritative = format!(
+        "**Step one**\n\nAuthoritative opening paragraph.\n\n{long_word}\n\nAuthoritative closing paragraph."
+    );
+    complete_reasoning(
+        &mut chat,
+        "reasoning-one",
+        vec![authoritative.clone()],
+        Vec::new(),
+    );
+    assert!(chat.transcript.live_reasoning_cell.is_none());
+
+    let first = reasoning_cells(take_inserted_cells(&mut rx));
+    assert_eq!(first.len(), 1);
+    let first_cell = reasoning_cell(first[0].as_ref());
+    assert_eq!(first_cell.source_item_id(), Some("reasoning-one"));
+    assert_eq!(first_cell.markdown_source(), authoritative);
+    assert!(!first_cell.markdown_source().contains("Streamed prefix"));
+    assert_eq!(
+        first_cell
+            .markdown_source()
+            .matches("Authoritative opening")
+            .count(),
+        1
+    );
+
+    let mut rendered_lines = Vec::new();
+    for width in [24, 80] {
+        let rendered = lines_to_single_string(&first[0].transcript_lines(width));
+        assert!(rendered.contains("Step one"), "width {width}: {rendered:?}");
+        assert!(
+            rendered.contains("Authoritative opening"),
+            "width {width}: {rendered:?}"
+        );
+        assert!(
+            rendered.contains("Authoritative closing"),
+            "width {width}: {rendered:?}"
+        );
+        assert!(
+            rendered
+                .lines()
+                .map(str::trim)
+                .collect::<String>()
+                .contains(&long_word),
+            "width {width}: long word was lost: {rendered:?}"
+        );
+        rendered_lines.push(rendered.lines().count());
+    }
+    assert!(rendered_lines[0] > rendered_lines[1]);
+
+    // The next item has no deltas. A late notification for the previous item must not
+    // create a preview or contaminate its authoritative completion.
+    start_reasoning(&mut chat, "reasoning-two");
+    summary_delta(
+        &mut chat,
+        "reasoning-one",
+        "**Stale heading**\n\nStale body",
+    );
+    assert!(chat.transcript.live_reasoning_cell.is_none());
+    complete_reasoning(
+        &mut chat,
+        "reasoning-two",
+        vec!["**Step two**\n\nCompleted without deltas.".to_string()],
+        Vec::new(),
+    );
+
+    let second = reasoning_cells(take_inserted_cells(&mut rx));
+    assert_eq!(second.len(), 1);
+    assert_eq!(
+        reasoning_cell(second[0].as_ref()).source_item_id(),
+        Some("reasoning-two")
+    );
+    let second_text = lines_to_single_string(&second[0].transcript_lines(/*width*/ 80));
+    assert!(second_text.contains("Completed without deltas"));
+    assert!(!second_text.contains("Stale"));
+
+    start_reasoning(&mut chat, "reasoning-empty-completion");
+    summary_delta(
+        &mut chat,
+        "reasoning-empty-completion",
+        "Streamed fallback.",
+    );
+    complete_reasoning(
+        &mut chat,
+        "reasoning-empty-completion",
+        Vec::new(),
+        Vec::new(),
+    );
+    let fallback = reasoning_cells(take_inserted_cells(&mut rx));
+    assert_eq!(fallback.len(), 1);
+    assert!(
+        reasoning_cell(fallback[0].as_ref())
+            .markdown_source()
+            .contains("Streamed fallback.")
+    );
+}

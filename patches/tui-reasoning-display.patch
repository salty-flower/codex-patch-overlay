+#[tokio::test]
+async fn summary_modes_gate_summary_and_raw_reasoning_independently() {
+    for display in [
+        TuiReasoningDisplay::StatusOnly,
+        TuiReasoningDisplay::Persistent,
+        TuiReasoningDisplay::Hidden,
+    ] {
+        for show_raw in [false, true] {
+            let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+            chat.on_task_started();
+            chat.local_settings.tui.reasoning_display = display;
+            chat.config.show_raw_agent_reasoning = show_raw;
+            drain_insert_history(&mut rx);
+
+            start_reasoning(&mut chat, "mode-item");
+            summary_delta(
+                &mut chat,
+                "mode-item",
+                "**Summary heading**\n\nVisible summary marker",
+            );
+            raw_reasoning_delta(&mut chat, "mode-item", "Raw detail marker");
+
+            if display == TuiReasoningDisplay::Persistent {
+                assert!(
+                    live_reasoning_text(&chat, /*width*/ 80)
+                        .as_deref()
+                        .is_some_and(|text| text.contains("Visible summary marker"))
+                );
+            } else {
+                assert!(chat.transcript.live_reasoning_cell.is_none());
+            }
+            if display == TuiReasoningDisplay::Hidden {
+                assert_eq!(
+                    chat.bottom_pane.status_widget().unwrap().header(),
+                    "Working"
+                );
+            }
+
+            complete_reasoning(
+                &mut chat,
+                "mode-item",
+                vec!["**Summary heading**\n\nVisible summary marker".to_string()],
+                vec!["Raw detail marker".to_string()],
+            );
+            let cells = reasoning_cells(take_inserted_cells(&mut rx));
+            let rendered = cells
+                .iter()
+                .map(|cell| lines_to_single_string(&cell.transcript_lines(/*width*/ 80)))
+                .collect::<String>();
+            assert_eq!(
+                rendered.contains("Visible summary marker"),
+                display != TuiReasoningDisplay::Hidden,
+                "mode {display:?}, show_raw={show_raw}: {rendered:?}"
+            );
+            assert_eq!(
+                rendered.contains("Raw detail marker"),
+                show_raw,
+                "mode {display:?}, show_raw={show_raw}: {rendered:?}"
+            );
+            let expected_cell_count = if display != TuiReasoningDisplay::Hidden || show_raw {
+                1
+            } else {
+                0
+            };
+            assert_eq!(cells.len(), expected_cell_count);
+            if let Some(cell) = cells.first() {
+                assert_eq!(
+                    reasoning_cell(cell.as_ref()).source_item_id(),
+                    Some("mode-item")
+                );
+                assert_eq!(
+                    cell.display_lines(/*width*/ 80).is_empty(),
+                    display != TuiReasoningDisplay::Persistent
+                );
+            }
+
+            if display == TuiReasoningDisplay::Hidden {
+                chat.handle_thread_item(
+                    AppServerThreadItem::Reasoning {
+                        id: "hidden-replay-item".to_string(),
+                        summary: vec!["**Replay summary marker**".to_string()],
+                        content: if show_raw {
+                            vec!["Replay raw marker".to_string()]
+                        } else {
+                            Vec::new()
+                        },
+                    },
+                    "replay-turn".to_string(),
+                    ThreadItemRenderSource::Replay(ReplayKind::ThreadSnapshot),
+                );
+                let replay_cells = reasoning_cells(take_inserted_cells(&mut rx));
+                let replayed = replay_cells
+                    .iter()
+                    .map(|cell| lines_to_single_string(&cell.transcript_lines(/*width*/ 80)))
+                    .collect::<String>();
+                assert!(!replayed.contains("Replay summary marker"));
+                assert_eq!(replayed.contains("Replay raw marker"), show_raw);
+                assert_eq!(replay_cells.len(), if show_raw { 1 } else { 0 });
+            }
+        }
+    }
+}

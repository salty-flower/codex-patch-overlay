+#[tokio::test]
+async fn persistent_reasoning_clears_split_empty_placeholders_and_keeps_real_comments() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.on_task_started();

+                        active
+                            .as_any()
+                            .downcast_ref::<ExecCell>()
+                            .is_some_and(ExecCell::is_active)
+                            || active
+                                .as_any()
+                                .downcast_ref::<history_cell::ComputerActivityCell>()
+                                .is_some_and(history_cell::ComputerActivityCell::is_active)
+                    });
+                    if running_tool {
+                        // Keep the live tool at the tail so subsequent output and completion
+                        // still update it. Completed tool groups use ordinary insertion order.
+                        self.app_event_tx.send(AppEvent::InsertHistoryCell(cell));
+                    } else {
+                        self.add_boxed_history(cell);
+                    }
+                }
+            } else {
+                let mut cell =
+                    history_cell::new_reasoning_summary_block(reasoning_parts, &self.config.cwd);
+                if let Some(id) = &self.status_state.reasoning_item_id {
+                    cell.set_source_item_id(id.clone());
+                }
+                let cell: Box<dyn HistoryCell> = cell;
+                let result = match self.transcript.active_cell.as_mut() {
+                    Some(active) => active.append_reasoning(cell),
+                    None => Err(cell),
+                };

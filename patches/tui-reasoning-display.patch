+fn safety_buffering_update(
+    thread_id: ThreadId,
+    turn_id: &str,
+    show_buffering_ui: bool,
+) -> ModelSafetyBufferingUpdatedNotification {
+    ModelSafetyBufferingUpdatedNotification {
+        thread_id: thread_id.to_string(),
+        turn_id: turn_id.to_string(),
+        model: "current-model".to_string(),
+        use_cases: Vec::new(),
+        reasons: Vec::new(),
+        show_buffering_ui,
+        faster_model: None,
+    }
+}

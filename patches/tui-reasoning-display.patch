+    drain_insert_history(&mut rx);
+
+    let exec_item = begin_exec(&mut chat, "exec-during-reasoning", "printf output");
+    start_reasoning(&mut chat, "reasoning-during-exec");
+    summary_delta(
+        &mut chat,
+        "reasoning-during-exec",
+        "**Reviewing the command**\n\nThe summary completes while the command is still running.",
+    );
+    complete_reasoning(
+        &mut chat,
+        "reasoning-during-exec",
+        vec!["**Reviewing the command**\n\nThe authoritative summary is committed.".to_string()],
+        Vec::new(),
+    );
+
+    assert!(chat.running_commands.contains_key("exec-during-reasoning"));
+    let active = chat
+        .transcript
+        .active_cell
+        .as_deref()
+        .expect("reasoning completion must preserve the live exec row");
+    let exec = active
+        .as_any()
+        .downcast_ref::<ExecCell>()
+        .expect("the active row remains an exec cell");
+    assert!(
+        exec.iter_calls()
+            .any(|call| call.call_id == "exec-during-reasoning")
+    );
+
+    chat.on_exec_command_output_delta("exec-during-reasoning", "streamed-after-reasoning-marker\n");
+    let active_transcript = chat
+        .active_cell_transcript_lines(/*width*/ 80)
+        .expect("exec remains visible while it runs");
+    let active_transcript = lines_to_single_string(&active_transcript);
+    assert!(active_transcript.contains("streamed-after-reasoning-marker"));
+
+    end_exec(
+        &mut chat,
+        exec_item,
+        "completed-exec-output-marker\n",
+        "",
+        /*exit_code*/ 0,
+    );
+    assert!(!chat.running_commands.contains_key("exec-during-reasoning"));
+
+    let mut cells = take_inserted_cells(&mut rx);
+    if let Some(active) = chat.transcript.active_cell.take() {
+        cells.push(active);
+    }
+    let exec_cells = cells
+        .iter()
+        .filter(|cell| {
+            cell.as_any()
+                .downcast_ref::<ExecCell>()
+                .is_some_and(|exec| {
+                    exec.iter_calls()
+                        .any(|call| call.call_id == "exec-during-reasoning")
+                })
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(exec_cells.len(), 1, "exec identity must be committed once");
+    let completed = lines_to_single_string(&exec_cells[0].transcript_lines(/*width*/ 80));
+    assert!(completed.contains("completed-exec-output-marker"));
+}

+#[tokio::test]
+async fn persistent_resume_commits_authoritative_reasoning_once_without_a_duplicate() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.local_settings.tui.reasoning_display = TuiReasoningDisplay::Persistent;
+    chat.thread_id = Some(ThreadId::new());
+    drain_insert_history(&mut rx);
+
+    chat.replay_thread_turns(
+        vec![AppServerTurn {
+            id: "reasoning-resume-turn".to_string(),
+            items_view: codex_app_server_protocol::TurnItemsView::Full,
+            items: vec![AppServerThreadItem::Reasoning {
+                id: "reasoning-resume-item".to_string(),
+                summary: vec![
+                    "**Resumed heading**\n\nSnapshot text that completion will replace."
+                        .to_string(),
+                ],
+                content: Vec::new(),
+            }],
+            status: AppServerTurnStatus::InProgress,
+            error: None,
+            started_at: Some(0),
+            completed_at: None,
+            duration_ms: None,
+        }],
+        ReplayKind::ThreadSnapshot,
+    );
+
+    assert!(reasoning_cells(take_inserted_cells(&mut rx)).is_empty());
+    assert!(
+        live_reasoning_text(&chat, /*width*/ 80)
+            .as_deref()
+            .is_some_and(|text| text.contains("Snapshot text"))
+    );
+
+    let authoritative = "**Resumed heading**\n\nAuthoritative text after resume.".to_string();
+    complete_reasoning(
+        &mut chat,
+        "reasoning-resume-item",
+        vec![authoritative.clone()],
+        Vec::new(),
+    );
+    assert!(chat.transcript.live_reasoning_cell.is_none());
+
+    let first_completion = reasoning_cells(take_inserted_cells(&mut rx));
+    assert_eq!(first_completion.len(), 1);
+    let first_cell = reasoning_cell(first_completion[0].as_ref());
+    assert_eq!(first_cell.source_item_id(), Some("reasoning-resume-item"));
+    assert_eq!(first_cell.markdown_source(), authoritative);
+    assert!(
+        !first_cell
+            .markdown_source()
+            .contains("Snapshot text that completion will replace")
+    );
+
+    // A duplicate completion after the resumed item finalized is stale and must not insert a
+    // second copy of the summary into history.
+    complete_reasoning(
+        &mut chat,
+        "reasoning-resume-item",
+        vec![authoritative],
+        Vec::new(),
+    );
+    assert!(reasoning_cells(take_inserted_cells(&mut rx)).is_empty());
+}

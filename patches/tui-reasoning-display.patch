+            self.bump_active_cell_revision();
+            self.request_redraw();
+        }
+    }
+
+    pub(super) fn sync_live_reasoning_summary_cell(&mut self) {
+        if self.local_settings.tui.reasoning_display != TuiReasoningDisplay::Persistent
+            || self.safety_buffering_is_waiting()
+            || self.status_state.reasoning_item_id.is_none()
+        {
+            self.clear_live_reasoning_summary_cell();
+            return;
+        }
+        let mut parts = self.reasoning_summary_parts.clone();
+        if !self.reasoning_buffer.is_empty() {
+            parts.push(self.reasoning_buffer.clone());
+        }
+        let Some(mut cell) =
+            history_cell::new_visible_reasoning_summary_block(parts, &self.config.cwd)
+        else {
+            self.clear_live_reasoning_summary_cell();
+            return;
+        };
+        if let Some(id) = &self.status_state.reasoning_item_id {
+            cell.set_source_item_id(id.clone());
+        }
+        self.transcript.live_reasoning_cell = Some(cell);
+        self.bump_active_cell_revision();
+        self.request_redraw();
+    }

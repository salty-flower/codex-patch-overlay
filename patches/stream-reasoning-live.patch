+/// Build the transient, in-progress reasoning-summary cell shown in the active-cell slot while a
+/// reasoning item is still streaming.
+///
+/// Unlike [`new_reasoning_summary_block`], which keeps summaries transcript-only unless they carry
+/// a bold status header, this renders the accumulated summary live in the viewport so streamed
+/// reasoning is visible as it arrives. Returns `None` when the parts have no renderable body yet
+/// (only a still-forming/bold status header or empty `<!-- -->` placeholders) so the caller can
+/// keep the shimmer status header without flashing an empty cell.
+pub(crate) fn new_live_reasoning_summary_block(
+    reasoning_parts: Vec<String>,
+    cwd: &Path,
+) -> Option<Box<dyn HistoryCell>> {
+    let (header, content) = split_reasoning_summary_parts(&reasoning_parts);
+    if !reasoning_summary_has_visible_body(&content) {
+        return None;
+    }
+    Some(Box::new(ReasoningSummaryCell::new(
+        header,
+        content,
+        cwd,
+        /*transcript_only*/ false,
+    )))
+}
+
+/// Whether reasoning-summary `content` (already split from its status header) carries body text
+/// worth rendering live, as opposed to only a still-forming bold status header like `**Analyzing**`.
+fn reasoning_summary_has_visible_body(content: &str) -> bool {
+    let trimmed = content.trim();
+    let body = match trimmed.strip_prefix("**") {
+        // A closed leading bold header is a status header, not body; look past it.
+        Some(after_open) => match after_open.split_once("**") {
+            Some((_, rest)) => rest,
+            // Still forming the bold header; nothing renderable yet.
+            None => "",
+        },
+        None => trimmed,
+    };
+    !body.trim().is_empty()
+}

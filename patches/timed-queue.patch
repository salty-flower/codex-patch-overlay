+#[derive(Clone, Debug)]
+pub(super) struct ScheduleEntry {
+    pub(super) item_id: Uuid,
+    pub(super) wall_deadline: DateTime<Local>,
+    pub(super) monotonic_deadline: Instant,
+}
+
+#[derive(Debug)]
+enum SchedulerCommand {
+    Sync {
+        thread_id: ThreadId,
+        generation: Uuid,
+        entries: Vec<ScheduleEntry>,
+    },
+    Reconcile,
+}
+
+pub(super) struct ScheduledQueueController {
+    command_tx: Option<UnboundedSender<SchedulerCommand>>,
+    task: Option<tokio::task::JoinHandle<()>>,
+}
+
+impl Default for ScheduledQueueController {
+    fn default() -> Self {
+        Self {
+            command_tx: None,
+            task: None,
+        }
+    }
+}
+
+impl ScheduledQueueController {
+    pub(super) fn sync(
+        &mut self,
+        app_event_tx: &AppEventSender,
+        thread_id: Option<ThreadId>,
+        generation: Uuid,
+        entries: Vec<ScheduleEntry>,
+    ) {
+        let Some(thread_id) = thread_id else {
+            self.reconcile_sender(SchedulerCommand::Sync {
+                thread_id: ThreadId::default(),
+                generation,
+                entries: Vec::new(),
+            });
+            return;
+        };
+        self.ensure_started(app_event_tx);
+        self.reconcile_sender(SchedulerCommand::Sync {
+            thread_id,
+            generation,
+            entries,
+        });
+    }
+
+    pub(super) fn reconcile(&mut self) {
+        self.reconcile_sender(SchedulerCommand::Reconcile);
+    }
+
+    fn ensure_started(&mut self, app_event_tx: &AppEventSender) {
+        if self.command_tx.is_some() {
+            return;
+        }
+        let Ok(handle) = tokio::runtime::Handle::try_current() else {
+            tracing::warn!("scheduled queue unavailable outside a Tokio runtime");
+            return;
+        };
+        let (command_tx, command_rx) = tokio::sync::mpsc::unbounded_channel();
+        let event_tx = app_event_tx.app_event_tx.clone();
+        let task = handle.spawn(run_scheduler(command_rx, event_tx));
+        self.command_tx = Some(command_tx);
+        self.task = Some(task);
+    }
+
+    fn reconcile_sender(&mut self, command: SchedulerCommand) {
+        let Some(sender) = self.command_tx.as_ref() else {
+            return;
+        };
+        if sender.send(command).is_err() {
+            self.command_tx = None;
+            if let Some(task) = self.task.take() {
+                task.abort();
+            }
+        }
+    }
+}
+
+impl Drop for ScheduledQueueController {
+    fn drop(&mut self) {
+        self.command_tx.take();
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+}
+
+struct SchedulerState {
+    thread_id: ThreadId,
+    generation: Uuid,
+    entries: Vec<(ScheduleEntry, bool)>,
+}
+
+async fn run_scheduler(
+    mut command_rx: UnboundedReceiver<SchedulerCommand>,
+    event_tx: UnboundedSender<AppEvent>,
+) {
+    let mut state: Option<SchedulerState> = None;
+    loop {
+        let wait = state
+            .as_ref()
+            .map(next_wakeup)
+            .unwrap_or(Duration::from_secs(3600));
+        tokio::select! {
+            command = command_rx.recv() => match command {
+                Some(SchedulerCommand::Sync { thread_id, generation, entries }) => {
+                    state = Some(SchedulerState {
+                        thread_id,
+                        generation,
+                        entries: entries.into_iter().map(|entry| (entry, false)).collect(),
+                    });
+                    if !poll_scheduler(&mut state, &event_tx, /*emit_ticks*/ false) {
+                        break;
+                    }
+                }
+                Some(SchedulerCommand::Reconcile) => {
+                    if !poll_scheduler(&mut state, &event_tx, /*emit_ticks*/ true) {
+                        break;
+                    }
+                }
+                None => break,
+            },
+            _ = tokio::time::sleep(wait) => {
+                if !poll_scheduler(&mut state, &event_tx, /*emit_ticks*/ true) {
+                    break;
+                }
+            }
+        }
+    }
+}
+
+fn next_wakeup(state: &SchedulerState) -> Duration {
+    let now = Instant::now();
+    let wall_now = Local::now();
+    state
+        .entries
+        .iter()
+        .filter(|(_, due_sent)| !due_sent)
+        .map(|(entry, _)| {
+            let monotonic_wait = entry.monotonic_deadline.saturating_duration_since(now);
+            let wall_wait = entry
+                .wall_deadline
+                .signed_duration_since(wall_now)
+                .to_std()
+                .unwrap_or_default();
+            monotonic_wait.min(wall_wait).min(TICK_INTERVAL)
+        })
+        .min()
+        .unwrap_or(TICK_INTERVAL)
+}
+
+fn entry_is_due(entry: &ScheduleEntry, wall_now: DateTime<Local>, monotonic_now: Instant) -> bool {
+    wall_now >= entry.wall_deadline || monotonic_now >= entry.monotonic_deadline
+}
+
+fn poll_scheduler(
+    state: &mut Option<SchedulerState>,
+    event_tx: &UnboundedSender<AppEvent>,
+    emit_ticks: bool,
+) -> bool {
+    let Some(state) = state.as_mut() else {
+        return true;
+    };
+    let wall_now = Local::now();
+    let monotonic_now = Instant::now();
+    for (entry, due_sent) in &mut state.entries {
+        if entry_is_due(entry, wall_now, monotonic_now) {
+            if *due_sent {
+                continue;
+            }
+            if event_tx
+                .send(AppEvent::ScheduledQueueDue {
+                    thread_id: state.thread_id,
+                    item_id: entry.item_id,
+                    generation: state.generation,
+                })
+                .is_err()
+            {
+                return false;
+            }
+            *due_sent = true;
+        } else if emit_ticks
+            && event_tx
+                .send(AppEvent::ScheduledQueueTick {
+                    thread_id: state.thread_id,
+                    item_id: entry.item_id,
+                    generation: state.generation,
+                })
+                .is_err()
+        {
+            return false;
+        }
+    }
+    true
+}

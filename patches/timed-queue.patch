+        assert_eq!(parsed.delay, Duration::from_secs(10 * 60));
+        assert_eq!(parsed.prompt, "continue the review");
+        assert_eq!(parsed.label, "in 10m");
+    }
+
+    #[test]
+    fn parses_minutes_with_suffix() {
+        let parsed = parse_schedule_args("10m continue", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(600));
+        assert_eq!(parsed.label, "in 10m");
+    }
+
+    #[test]
+    fn parses_hours() {
+        let parsed = parse_schedule_args("2h continue", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(7200));
+        assert_eq!(parsed.label, "in 2h");
+    }
+
+    #[test]
+    fn parses_seconds() {
+        let parsed = parse_schedule_args("90s continue", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(90));
+        assert_eq!(parsed.label, "in 90s");
+    }
+
+    #[test]
+    fn parses_compound_duration() {
+        let parsed = parse_schedule_args("1h30m continue", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(5400));
+        assert_eq!(parsed.label, "in 1h30m");
+    }
+
+    #[test]
+    fn parses_full_hms_duration() {
+        let parsed = parse_schedule_args("1h2m3s continue", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(3723));
+        assert_eq!(parsed.label, "in 1h2m3s");
+    }
+
+    #[test]
+    fn parses_clock_today() {
+        let parsed = parse_schedule_args("09:30 continue the review", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(30 * 60));
+        assert_eq!(parsed.prompt, "continue the review");
+        assert_eq!(parsed.label, "at 09:30");
+    }
+
+    #[test]
+    fn parses_clock_tomorrow_when_time_has_passed() {
+        let parsed = parse_schedule_args("09:30 continue", now_at(10, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(23 * 60 * 60 + 30 * 60));
+        assert_eq!(parsed.label, "at 09:30");
+    }
+
+    #[test]
+    fn parses_clock_with_seconds() {
+        let parsed = parse_schedule_args("09:30:15 continue", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(30 * 60 + 15));
+        assert_eq!(parsed.label, "at 09:30:15");
+    }
+
+    #[test]
+    fn parses_absolute_date() {
+        let parsed = parse_schedule_args("2026-07-15 09:30 continue", now_at(9, 0)).unwrap();
+        assert_eq!(parsed.delay, Duration::from_secs(24 * 60 * 60 + 30 * 60));
+        assert_eq!(parsed.prompt, "continue");
+        assert_eq!(parsed.label, "at 2026-07-15 09:30");
+    }
+
+    #[test]
+    fn parses_absolute_date_with_seconds() {
+        let parsed = parse_schedule_args("2026-07-15 09:30:15 continue", now_at(9, 0)).unwrap();
+        assert_eq!(
+            parsed.delay,
+            Duration::from_secs(24 * 60 * 60 + 30 * 60 + 15)
+        );
+        assert_eq!(parsed.label, "at 2026-07-15 09:30:15");
+    }
+
+    #[test]
+    fn rejects_absolute_date_in_the_past() {
+        assert!(parse_schedule_args("2020-01-01 09:30 continue", now_at(9, 0)).is_err());
+    }
+
+    #[test]
+    fn rejects_absolute_date_without_time() {
+        assert!(parse_schedule_args("2026-07-15 continue", now_at(9, 0)).is_err());
+    }
+
+    #[test]
+    fn rejects_freeform_time() {
+        assert!(parse_schedule_args("after lunch continue", now_at(9, 0)).is_err());
+    }
+
+    #[test]
+    fn rejects_invalid_clock() {
+        assert!(parse_schedule_args("25:00 continue", now_at(9, 0)).is_err());
+    }
+
+    #[test]
+    fn rejects_zero_duration() {
+        assert!(parse_schedule_args("0 continue", now_at(9, 0)).is_err());
+        assert!(parse_schedule_args("0s continue", now_at(9, 0)).is_err());

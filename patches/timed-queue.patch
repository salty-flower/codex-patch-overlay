index 0000000..e7eaad5
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/scheduled_input.rs
@@ -0,0 +1,560 @@
+use std::time::Duration;
+use std::time::Instant;
+
+use chrono::DateTime;
+use chrono::Local;
+use chrono::NaiveDate;
+use chrono::NaiveDateTime;
+use chrono::NaiveTime;
+use chrono::TimeZone;
+use tokio::sync::mpsc::UnboundedReceiver;
+use tokio::sync::mpsc::UnboundedSender;
+use uuid::Uuid;
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use codex_protocol::ThreadId;
+
+const USAGE: &str = "Usage:\n  /later <delay> <prompt>\n  /later HH:MM[:SS] <prompt>\n  /later YYYY-MM-DD HH:MM[:SS] <prompt>\nDelay: 10m, 1h30m, 90s, 1h2m3s (bare number = minutes)";
+const TICK_INTERVAL: Duration = Duration::from_secs(10);
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) struct ScheduledPrompt {
+    pub(super) delay: Duration,
+    pub(super) deadline: NaiveDateTime,
+    pub(super) prompt: String,
+    pub(super) label: String,
+}
+
+fn parse_duration(input: &str) -> Option<(u64, String)> {
+    if input.is_empty() {
+        return None;
+    }
+    // Bare integer = minutes. Every multiplication and addition is checked so
+    // an otherwise valid-looking input can never wrap into a short delay.
+    if let Ok(minutes) = input.parse::<u64>() {
+        let seconds = minutes.checked_mul(60)?;
+        return (seconds > 0).then(|| (seconds, format!("{minutes}m")));
+    }
+    let mut total_secs: u64 = 0;
+    let mut label_parts = Vec::new();
+    let mut rest = input;
+    let mut matched_any = false;
+    for (suffix, factor, label_suffix) in [('h', 3600u64, "h"), ('m', 60, "m"), ('s', 1, "s")] {
+        if let Some(pos) = rest.find(suffix) {
+            let n: u64 = rest[..pos].parse().ok()?;
+            let component = n.checked_mul(factor)?;
+            total_secs = total_secs.checked_add(component)?;
+            label_parts.push(format!("{n}{label_suffix}"));
+            rest = &rest[pos + 1..];
+            matched_any = true;
+        }
+    }
+    if !matched_any || !rest.is_empty() || total_secs == 0 {
+        return None;
+    }
+    Some((total_secs, label_parts.join("")))
+}
+
+fn checked_chrono_duration(seconds: u64) -> Option<chrono::Duration> {
+    chrono::Duration::try_seconds(i64::try_from(seconds).ok()?)
+}
+
+pub(super) fn local_deadline(deadline: NaiveDateTime) -> Option<DateTime<Local>> {
+    Local
+        .from_local_datetime(&deadline)
+        .earliest()
+        .or_else(|| Local.from_local_datetime(&deadline).latest())
+}
+
+/// Parse a clock-time token, accepting `HH:MM` or `HH:MM:SS`. The label keeps
+/// the seconds field only when the caller supplied it.
+fn parse_clock(token: &str) -> Option<(NaiveTime, String)> {
+    if let Ok(time) = NaiveTime::parse_from_str(token, "%H:%M:%S") {
+        return Some((time, time.format("%H:%M:%S").to_string()));
+    }
+    if let Ok(time) = NaiveTime::parse_from_str(token, "%H:%M") {
+        return Some((time, time.format("%H:%M").to_string()));
+    }
+    None
+}
+
+fn delay_until(target: NaiveDateTime, now: NaiveDateTime) -> Result<Duration, String> {
+    let delta = target.signed_duration_since(now);
+    if delta <= chrono::Duration::zero() {
+        return Err("Scheduled time is in the past.".to_string());
+    }
+    delta
+        .to_std()
+        .map_err(|_| "Scheduled time is too far in the future.".to_string())
+}
+
+pub(super) fn parse_schedule_args(
+    args: &str,
+    now: NaiveDateTime,
+) -> Result<ScheduledPrompt, String> {
+    let trimmed = args.trim();
+    let Some((first, rest)) = trimmed.split_once(char::is_whitespace) else {
+        return Err(USAGE.to_string());
+    };
+    let rest = rest.trim_start();
+
+    // Absolute datetime: YYYY-MM-DD HH:MM[:SS] <prompt>
+    if let Ok(date) = NaiveDate::parse_from_str(first, "%Y-%m-%d") {
+        let Some((time_token, prompt)) = rest.split_once(char::is_whitespace) else {
+            return Err(USAGE.to_string());
+        };
+        let prompt = prompt.trim_start();
+        if prompt.is_empty() {
+            return Err(USAGE.to_string());
+        }
+        let (time, time_label) = parse_clock(time_token).ok_or_else(|| USAGE.to_string())?;
+        let deadline = NaiveDateTime::new(date, time);
+        let delay = delay_until(deadline, now)?;
+        return Ok(ScheduledPrompt {
+            delay,
+            deadline,
+            prompt: prompt.to_string(),
+            label: format!("at {} {time_label}", date.format("%Y-%m-%d")),
+        });
+    }
+
+    if rest.is_empty() {
+        return Err(USAGE.to_string());
+    }
+
+    // Clock time today or tomorrow: HH:MM[:SS] <prompt>
+    if let Some((time, time_label)) = parse_clock(first) {
+        let mut deadline = NaiveDateTime::new(now.date(), time);
+        if deadline <= now {
+            let tomorrow = now
+                .date()
+                .checked_add_signed(chrono::Duration::days(1))
+                .ok_or_else(|| "Scheduled time is too far in the future.".to_string())?;
+            deadline = NaiveDateTime::new(tomorrow, time);
+        }
+        let delay = delay_until(deadline, now)?;
+        return Ok(ScheduledPrompt {
+            delay,
+            deadline,
+            prompt: rest.to_string(),
+            label: format!("at {time_label}"),
+        });
+    }
+
+    // Relative delay: <delay> <prompt>
+    let (secs, label) = parse_duration(first).ok_or_else(|| USAGE.to_string())?;
+    let delta = checked_chrono_duration(secs).ok_or_else(|| "Delay is too large.".to_string())?;
+    let deadline = now
+        .checked_add_signed(delta)
+        .ok_or_else(|| "Delay is too large.".to_string())?;
+    let delay = delay_until(deadline, now)?;
+    Ok(ScheduledPrompt {
+        delay,
+        deadline,
+        prompt: rest.to_string(),
+        label: format!("in {label}"),
+    })
+}

+    );
+
+    assert_eq!(chat.input_queue.pending_steers.len(), 1);
+    assert_eq!(
+        chat.input_queue.pending_steers.front().unwrap().state,
+        PendingSteerState::Claimed
+    );
+    assert_eq!(chat.bottom_pane.composer_text(), "keep this draft");
+    assert!(chat.input_queue.preview().pending_steers.is_empty());
+    let _ = drain_insert_history(&mut rx);
+}

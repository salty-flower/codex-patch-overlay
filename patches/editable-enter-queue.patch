+#[tokio::test]
+async fn alt_up_recalls_latest_pending_steer_once_and_merges_new_draft() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.turn_lifecycle.last_turn_id = Some("turn-1".to_string());
+    chat.on_task_started();
+
+    let mut earlier = pending_steer("earlier");
+    earlier.edit_order = 1;
+    let mut latest = pending_steer("latest");
+    latest.edit_order = 2;
+    chat.input_queue.pending_steers.push_back(earlier);
+    chat.input_queue.pending_steers.push_back(latest);
+    chat.bottom_pane
+        .set_composer_text("new draft".to_string(), Vec::new(), Vec::new());
+    chat.refresh_pending_input_preview();
+
+    chat.handle_key_event(KeyEvent::new(KeyCode::Up, KeyModifiers::ALT));
+
+    match rx.try_recv().expect("Alt+Up should request a recall") {
+        AppEvent::RecallPendingSteer {
+            expected_turn_id,
+            client_user_message_id,
+            ..
+        } => {
+            assert_eq!(expected_turn_id, "turn-1");
+            assert_eq!(client_user_message_id, "id-latest");
+        }
+        event => panic!("expected recall event, got {event:?}"),
+    }
+    assert_eq!(
+        chat.input_queue.pending_steers[1].state,
+        PendingSteerState::Recalling
+    );
+
+    chat.handle_key_event(KeyEvent::new(KeyCode::Up, KeyModifiers::ALT));
+    assert!(
+        rx.try_recv().is_err(),
+        "a recalling steer must not issue a duplicate request"
+    );
+
+    chat.on_steer_recall_resolved(
+        "id-latest".to_string(),
+        Ok(codex_app_server_protocol::TurnSteerRecallStatus::Recalled),
+    );
+    assert_eq!(chat.input_queue.pending_steers.len(), 1);
+    assert_eq!(chat.bottom_pane.composer_text(), "latest\nnew draft");
+}

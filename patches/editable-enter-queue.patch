+// Construct the guard before spawning: cancellation before the first poll must also resolve
+// the keyed request. Dropping the request future on timeout never blocks the TUI event loop.
+pub(crate) fn spawn_steer_recall(
+    thread_id: ThreadId,
+    client_user_message_id: String,
+    app_event_tx: AppEventSender,
+    request: impl std::future::Future<
+        Output = std::result::Result<codex_app_server_protocol::TurnSteerRecallStatus, String>,
+    > + Send
+    + 'static,
+) -> tokio::task::JoinHandle<()> {
+    struct Completion {
+        thread_id: ThreadId,
+        client_user_message_id: String,
+        app_event_tx: AppEventSender,
+        result:
+            Option<std::result::Result<codex_app_server_protocol::TurnSteerRecallStatus, String>>,
+    }
+    impl Drop for Completion {
+        fn drop(&mut self) {
+            self.app_event_tx.send(AppEvent::SteerRecallResolved {
+                thread_id: self.thread_id,
+                client_user_message_id: self.client_user_message_id.clone(),
+                result: self
+                    .result
+                    .take()
+                    .unwrap_or_else(|| Err("request cancelled".to_string())),
+            });
+        }
+    }
+    let mut completion = Completion {
+        thread_id,
+        client_user_message_id,
+        app_event_tx,
+        result: None,
+    };
+    tokio::spawn(async move {
+        completion.result = Some(
+            tokio::time::timeout(STEER_RECALL_TIMEOUT, request)
+                .await
+                .unwrap_or_else(|_| Err("request timed out".to_string())),
+        );
+        drop(completion);
+    })
+}
 

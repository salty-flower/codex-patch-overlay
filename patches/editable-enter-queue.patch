+                user_input_with_id("last", "last"),
+            ])
+            .expect("initial IDs are unique");
+
+        assert_eq!(queue.recall("recalled"), SteerRecallStatus::Recalled);
+        assert_eq!(queue.recall("recalled"), SteerRecallStatus::AlreadyRecalled);
+
+        let drained = queue.take_all();
+        assert_eq!(
+            drained
+                .iter()
+                .filter_map(user_input_client_id)
+                .collect::<Vec<_>>(),
+            vec!["first", "last"]
+        );
+        assert_eq!(queue.recall("first"), SteerRecallStatus::AlreadyConsumed);
+        assert_eq!(queue.recall("last"), SteerRecallStatus::AlreadyConsumed);
+        assert_eq!(queue.recall("unknown"), SteerRecallStatus::NotFound);
+    }

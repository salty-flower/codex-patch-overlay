+    pub(crate) fn recall(&mut self, client_id: &str) -> SteerRecallStatus {
+        if let Some(terminal) = self.terminal_steers.get(client_id) {
+            return match terminal {
+                SteerTerminalState::Recalled => SteerRecallStatus::AlreadyRecalled,
+                SteerTerminalState::Consumed => SteerRecallStatus::AlreadyConsumed,
+            };
+        }
+

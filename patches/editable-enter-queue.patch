+        Ok(TurnSteerRecallStatus::Recalled),
+        Ok(TurnSteerRecallStatus::AlreadyRecalled),
+        Ok(TurnSteerRecallStatus::AlreadyConsumed),
+        Ok(TurnSteerRecallStatus::NotFound),
+        Err("transport error".to_string()),
+    ] {
+        for switch_back_before_reply in [false, true] {
+            let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+            let owner = ThreadId::new();
+            prepare_recall_test_thread(&mut app, owner).await;
+            let input = app.chat_widget.capture_thread_input_state().unwrap();
+            let client_id = input.pending_steers[0].client_id.clone();
+            while events.try_recv().is_ok() {}
+            let (reply_tx, reply_rx) = tokio::sync::oneshot::channel();
+            let task = crate::app_server_session::spawn_steer_recall(
+                owner,
+                client_id.clone(),
+                app.app_event_tx.clone(),
+                async move { reply_rx.await.expect("test reply") },
+            );
+            tokio::task::yield_now().await;
+            assert!(
+                !task.is_finished(),
+                "recall is still waiting for the server"
+            );
+            app.store_active_thread_receiver().await;
+            app.agents_overview
+                .input_states
+                .insert(owner, input.clone());
+            let other = ThreadId::new();
+            app.active_thread_id = Some(other);
+            app.chat_widget
+                .handle_thread_session(test_thread_session(other, app.config.cwd.to_path_buf()));
+            app.chat_widget.restore_thread_input_state(
+                None,
+                ThreadInputStateRestoreMode {
+                    preserve_in_flight_turn: true,
+                },
+            );
+            app.chat_widget.apply_external_edit("other draft".into());
+            if switch_back_before_reply {
+                app.active_thread_id = Some(owner);
+                app.chat_widget.handle_thread_session(test_thread_session(
+                    owner,
+                    app.config.cwd.to_path_buf(),
+                ));
+                app.chat_widget.restore_thread_input_state(
+                    Some(input),
+                    ThreadInputStateRestoreMode {
+                        preserve_in_flight_turn: true,
+                    },
+                );
+            }
+            reply_tx
+                .send(result.clone())
+                .expect("pending recall receiver");
+            task.await?;
+            let event = std::iter::from_fn(|| events.try_recv().ok())
+                .find(|event| matches!(event, AppEvent::SteerRecallResolved { .. }))
+                .expect("keyed completion");
+            let AppEvent::SteerRecallResolved {
+                thread_id,
+                client_user_message_id,
+                result: received,
+            } = event
+            else {
+                unreachable!()
+            };
+            assert_eq!((thread_id, &client_user_message_id), (owner, &client_id));
+            assert_eq!(received, result);
+            app.resolve_steer_recall(thread_id, client_user_message_id, received)
+                .await;
+            let saved = app.thread_event_channels[&owner]
+                .store
+                .lock()
+                .await
+                .input_state
+                .clone()
+                .unwrap();
+            assert_eq!(saved, app.agents_overview.input_states[&owner]);
+            if !switch_back_before_reply {
+                assert_eq!(app.chat_widget.composer_text_with_pending(), "other draft");
+                app.active_thread_id = Some(owner);
+                app.chat_widget.handle_thread_session(test_thread_session(
+                    owner,
+                    app.config.cwd.to_path_buf(),
+                ));
+                app.chat_widget.restore_thread_input_state(
+                    Some(saved),
+                    ThreadInputStateRestoreMode {
+                        preserve_in_flight_turn: true,
+                    },
+                );
+            }
+            let recalled = matches!(
+                result,
+                Ok(TurnSteerRecallStatus::Recalled | TurnSteerRecallStatus::AlreadyRecalled)
+            );
+            assert_eq!(
+                app.chat_widget.composer_text_with_pending(),
+                if recalled {
+                    "recall me\nsaved draft"
+                } else {
+                    "saved draft"
+                }
+            );
+            let pending = app
+                .chat_widget
+                .capture_thread_input_state()
+                .unwrap()
+                .pending_steers;
+            assert_eq!(
+                pending.len(),
+                usize::from(
+                    result.is_err() || result == Ok(TurnSteerRecallStatus::AlreadyConsumed)
+                )
+            );
+            while events.try_recv().is_ok() {}
+            app.chat_widget
+                .handle_key_event(KeyEvent::new(KeyCode::Up, KeyModifiers::ALT));
+            let can_retry = std::iter::from_fn(|| events.try_recv().ok())
+                .any(|event| matches!(event, AppEvent::RecallPendingSteer { .. }));
+            assert_eq!(
+                can_retry,
+                result.is_err(),
+                "only failed recall becomes editable again"
+            );
+        }
+    }
+    Ok(())
+}

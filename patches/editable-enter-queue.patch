+    fn turn_input_queue_fixed_interleavings_have_one_recall_drain_winner() {
+        let mut seed = 0x5eed_u64;
+        for _ in 0..1000 {
+            seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+            let recall_first = seed & 1 == 0;
+            let mut queue = TurnInputQueue::default();
+            queue
+                .try_extend(vec![
+                    user_input_with_id("before", "before"),
+                    user_input_with_id("target", "target"),
+                    user_input_with_id("after", "after"),
+                ])
+                .expect("fixed test IDs are unique");
+
+            let (recall_status, drained) = if recall_first {
+                let status = queue.recall("target");
+                let drained = queue.take_all();
+                (status, drained)
+            } else {
+                let drained = queue.take_all();
+                let status = queue.recall("target");
+                (status, drained)
+            };
+
+            let target_count = drained
+                .iter()
+                .filter(|item| user_input_client_id(item) == Some("target"))
+                .count();
+            match recall_status {
+                SteerRecallStatus::Recalled => assert_eq!(target_count, 0),
+                SteerRecallStatus::AlreadyConsumed => assert_eq!(target_count, 1),
+                status => panic!("unexpected barrier result: {status:?}"),
+            }
+            assert_eq!(
+                drained
+                    .iter()
+                    .filter_map(user_input_client_id)
+                    .filter(|id| *id != "target")
+                    .collect::<Vec<_>>(),
+                vec!["before", "after"]
+            );
+        }
+    }

+async fn inactive_committed_steer_is_removed_out_of_order_before_recall_reply() -> Result<()> {
+    let (mut app, _events, _ops) = make_test_app_with_channels().await;
+    let owner = ThreadId::new();
+    prepare_recall_test_thread(&mut app, owner).await;
+    let mut input = app.chat_widget.capture_thread_input_state().unwrap();
+    let target_id = input.pending_steers[0].client_id.clone();
+    let mut first = input.pending_steers[0].clone();
+    first.client_id = "different-id-same-text".into();
+    input.pending_steers.push_front(first.clone());
+    app.thread_event_channels[&owner]
+        .store
+        .lock()
+        .await
+        .input_state = Some(input.clone());
+    app.agents_overview.input_states.insert(owner, input);
+    app.active_thread_id = Some(ThreadId::new());
+    let server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    for id in ["unknown-id", target_id.as_str(), target_id.as_str()] {
+        app.handle_app_server_event(
+            &server,
+            codex_app_server_client::AppServerEvent::ServerNotification(Box::new(
+                ServerNotification::ItemCompleted(
+                    codex_app_server_protocol::ItemCompletedNotification {
+                        thread_id: owner.to_string(),
+                        turn_id: "turn-1".into(),
+                        completed_at_ms: 0,
+                        item: ThreadItem::UserMessage {
+                            id: "committed".into(),
+                            client_id: Some(id.into()),
+                            content: vec![],
+                        },
+                    },
+                ),
+            )),
+        )
+        .await;
+        let saved = app.thread_event_channels[&owner]
+            .store
+            .lock()
+            .await
+            .input_state
+            .clone()
+            .unwrap();
+        assert_eq!(saved, app.agents_overview.input_states[&owner]);
+        assert_eq!(
+            saved.pending_steers.len(),
+            if id == "unknown-id" { 2 } else { 1 }
+        );
+        assert_eq!(saved.pending_steers[0], first);
+    }
+    let before_reply = app.agents_overview.input_states[&owner].clone();
+    app.resolve_steer_recall(
+        owner,
+        target_id,
+        Ok(codex_app_server_protocol::TurnSteerRecallStatus::AlreadyConsumed),
+    )
+    .await;
+    assert_eq!(app.agents_overview.input_states[&owner], before_reply);
+    server.shutdown().await?;
+    Ok(())
+}

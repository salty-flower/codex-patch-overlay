+#[tokio::test(start_paused = true)]
+async fn recall_timeout_and_cancellation_post_recoverable_keyed_completion() {
+    for cancel in [false, true] {
+        let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+        let owner = ThreadId::new();
+        prepare_recall_test_thread(&mut app, owner).await;
+        let client_id = app
+            .chat_widget
+            .capture_thread_input_state()
+            .unwrap()
+            .pending_steers[0]
+            .client_id
+            .clone();
+        while events.try_recv().is_ok() {}
+        let task = crate::app_server_session::spawn_steer_recall(
+            owner,
+            client_id.clone(),
+            app.app_event_tx.clone(),
+            std::future::pending(),
+        );
+        if cancel {
+            task.abort(); // Also exercises cancellation before the first poll.
+        } else {
+            tokio::task::yield_now().await;
+            tokio::time::advance(crate::app_server_session::STEER_RECALL_TIMEOUT).await;
+        }
+        let _ = task.await;
+        let AppEvent::SteerRecallResolved {
+            thread_id,
+            client_user_message_id,
+            result,
+        } = events.try_recv().expect("completion on every exit")
+        else {
+            panic!("expected recall completion")
+        };
+        assert_eq!((thread_id, &client_user_message_id), (owner, &client_id));
+        assert_eq!(
+            result,
+            Err(if cancel {
+                "request cancelled"
+            } else {
+                "request timed out"
+            }
+            .to_string())
+        );
+        app.resolve_steer_recall(thread_id, client_user_message_id, result)
+            .await;
+        while events.try_recv().is_ok() {}
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Up, KeyModifiers::ALT));
+        assert!(matches!(
+            events.try_recv(),
+            Ok(AppEvent::RecallPendingSteer { .. })
+        ));
+    }
+}

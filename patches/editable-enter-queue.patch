+            user_input_client_id(item).is_some_and(|existing_id| existing_id == client_id)
+        }) else {
+            return SteerRecallStatus::NotFound;
+        };
+        self.items.remove(index);
+        self.terminal_steers
+            .insert(client_id.to_string(), SteerTerminalState::Recalled);
+        SteerRecallStatus::Recalled
+    }

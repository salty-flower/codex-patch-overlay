+/// Serves one token exchange whose identity token carries `auth_claims`.
+#[cfg(unix)]
+fn start_mock_issuer_with_auth_claims(
+    auth_claims: serde_json::Value,
+) -> (SocketAddr, thread::JoinHandle<()>) {
+    let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+    let addr = listener.local_addr().unwrap();
+    let server = tiny_http::Server::from_listener(listener, None).unwrap();
+    let handle = thread::spawn(move || {
+        while let Ok(req) = server.recv() {
+            if !req.url().starts_with("/oauth/token") {
+                let _ = req
+                    .respond(tiny_http::Response::from_string("not found").with_status_code(404));
+                continue;
+            }
+            let b64 = |b: &[u8]| base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(b);
+            let payload = serde_json::json!({
+                "email": "user@example.com",
+                "https://api.openai.com/auth": auth_claims,
+            });
+            let id_token = format!(
+                "{}.{}.{}",
+                b64(br#"{"alg":"none","typ":"JWT"}"#),
+                b64(&serde_json::to_vec(&payload).unwrap()),
+                b64(b"sig")
+            );
+            let tokens = serde_json::json!({
+                "id_token": id_token,
+                "access_token": "access-123",
+                "refresh_token": "refresh-123",
+            });
+            let mut resp = tiny_http::Response::from_data(serde_json::to_vec(&tokens).unwrap());
+            resp.add_header(
+                tiny_http::Header::from_bytes(&b"Content-Type"[..], &b"application/json"[..])
+                    .expect("header bytes should be valid"),
+            );
+            let _ = req.respond(resp);
+        }
+    });
+    (addr, handle)
+}
+
+/// Runs one browser login through a synthetic auth helper that records its request.
+#[cfg(unix)]
+async fn auth_helper_login(
+    auth_claims: serde_json::Value,
+    helper_response: serde_json::Value,
+    existing_auth: Option<serde_json::Value>,
+) -> Result<(
+    codex_http_client::HttpResponse,
+    Option<String>,
+    io::Result<LoginCallbackResult>,
+    tempfile::TempDir,
+)> {
+    let (issuer_addr, _issuer) = start_mock_issuer_with_auth_claims(auth_claims);
+    let tmp = tempdir()?;
+    let codex_home = tmp.path().to_path_buf();
+    let response_path = codex_home.join("helper-response.json");
+    std::fs::write(&response_path, serde_json::to_vec(&helper_response)?)?;
+    if let Some(existing_auth) = existing_auth {
+        std::fs::write(
+            codex_home.join("auth.json"),
+            serde_json::to_vec(&existing_auth)?,
+        )?;
+    }
+    let helper = vec![
+        "/bin/sh".to_string(),
+        "-c".to_string(),
+        r#"IFS= read -r request; printf '%s' "$request" > "$2"; cat "$1""#.to_string(),
+        "auth-helper-test".to_string(),
+        response_path.display().to_string(),
+        codex_home.join("helper-request.json").display().to_string(),
+    ];
+    let opts = ServerOptions {
+        chatgpt_auth_helper: Some(helper),
+        codex_home: codex_home.clone(),
+        cli_auth_credentials_store_mode: AuthCredentialsStoreMode::File,
+        auth_route_config: codex_login::test_support::transport_default_auth_route_config(),
+        client_id: codex_login::CLIENT_ID.to_string(),
+        issuer: format!("http://{}:{}", issuer_addr.ip(), issuer_addr.port()),
+        port: 0,
+        open_browser: false,
+        force_state: Some("helper_state".to_string()),
+        workspace_login: None,
+        forced_chatgpt_workspace_id: None,
+        codex_streamlined_login: false,
+        auth_keyring_backend_kind: AuthKeyringBackendKind::Direct,
+        login_success_page: LoginSuccessPage::Local,
+    };
+    let server = run_login_server(opts)?;
+    let port = server.actual_port;
+    let client = HttpClientBuilder::new()
+        .without_redirects()
+        .build_direct()?;
+    let mut response = client
+        .get(format!(
+            "http://127.0.0.1:{port}/auth/callback?code=abc&state=helper_state"
+        ))
+        .send()
+        .await?;
+    let mut location = None;
+    if response.status() == 302 {
+        let target = response.headers()["location"].to_str()?.to_string();
+        response = client.get(&target).send().await?;
+        location = Some(target);
+    }
+    let result = server.block_until_done_with_callback_result().await;
+    Ok((response, location, result, tmp))
+}

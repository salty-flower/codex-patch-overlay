+fn with_auth_helper_notice(
+    redirect: LoginSuccessRedirect,
+    port: u16,
+    notice: &str,
+) -> LoginSuccessRedirect {
+    let url = match redirect {
+        LoginSuccessRedirect::Local(url) => url,
+        LoginSuccessRedirect::Hosted(_) => format!("http://127.0.0.1:{port}/success"),
+    };

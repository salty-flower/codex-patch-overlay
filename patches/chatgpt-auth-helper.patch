+#[tokio::test]
+async fn auth_helper_owner_refresh_restores_local_network_restrictions() -> Result<()> {
+    let home = tempdir()?;
+    let cloud_loads = Arc::new(AtomicUsize::new(0));
+    let cloud_config_bundle = CloudConfigBundleLoader::from_getter({
+        let cloud_loads = Arc::clone(&cloud_loads);
+        move || {
+            let cloud_loads = Arc::clone(&cloud_loads);
+            async move {
+                cloud_loads.fetch_add(1, Ordering::SeqCst);
+                Ok(None)
+            }
+        }
+    });
+    let (manager, _) = manager_with_local_requirements(
+        home.path(),
+        "[application.network.domains]\n'allowed.example' = 'allow'",
+        cloud_config_bundle,
+    )?;
+    manager.refresh_application_network_policy().await?;
+    assert_eq!(cloud_loads.load(Ordering::SeqCst), 1);
+    let auth = auth_helper_personal_auth().await?;
+
+    // Account ownership changes revoke the previous policy while leaving its
+    // cloud=None snapshot available to authorize a local-only reload.
+    manager.network_policy.policy().invalidate();
+    let revision = manager.network_policy.policy().revision();
+    manager
+        .refresh_auth_helper_application_network_policy(&auth, revision)
+        .await?;
+
+    assert_eq!(cloud_loads.load(Ordering::SeqCst), 1);
+    assert_local_network_restrictions(&manager)?;
+    Ok(())
+}

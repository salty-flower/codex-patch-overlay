+fn assert_local_network_restrictions(manager: &ConfigManager) -> Result<()> {
+    let policy = manager.network_policy.policy();
+    assert_eq!(
+        policy
+            .acquire(&"https://allowed.example".parse()?)
+            .map(|_| ()),
+        Ok(()),
+    );
+    assert_eq!(
+        policy
+            .acquire(&"https://blocked.example".parse()?)
+            .map(|_| ()),
+        Err(NetworkPolicyDenied::Destination),
+    );
+    assert_eq!(
+        policy.acquire_for_unsupported_sdk().map(|_| ()),
+        Err(NetworkPolicyDenied::UnsupportedTransport),
+    );
+    Ok(())
+}

+#[tokio::test]
+async fn auth_helper_workspace_credential_uses_its_account_and_shows_the_helper_notice()
+-> Result<()> {
+    let codex_home = TempDir::new()?;
+    let server = MockServer::start().await;
+    let notice = "Organization account work: workspace admin policies not applied.";
+    let id_token = encode_id_token(
+        &ChatGptIdTokenClaims::new()
+            .email("helper@example.com")
+            .plan_type("business")
+            .chatgpt_user_id("helper-user")
+            .chatgpt_account_id("helper-account"),
+    )?;
+    write_config(
+        codex_home.path(),
+        &server.uri(),
+        json!({"version": 1, "ok": true, "snapshot": {
+            "account_key": "workspace-profile", "account_id": "helper-account",
+            "selection_epoch": 1, "credential_revision": 1,
+            "access_token": "synthetic-access", "id_token": id_token,
+            "expires_at": chrono::Utc::now().timestamp() + 3600,
+            "managed_config": "not_applied", "notice": notice
+        }}),
+    )
+    .await?;
+    // The model turn below needs the automatic environment.
+    let mut app = start_app(codex_home.path(), &server, /*with_auto_env*/ true).await?;
+    let workspace_account = Account::Chatgpt {
+        email: Some("helper@example.com".into()),
+        plan_type: PlanType::Business,
+        workspace_name: None,
+    };
+    assert_account(&mut app, workspace_account.clone()).await?;
+    assert_updated(
+        &mut app,
+        AuthMode::Chatgpt,
+        Some(PlanType::Business),
+        Some(AccountUpdateReason::WorkspaceRoutingReady),
+    )
+    .await?;
+    let request = app
+        .send_request("account/credentialNotice/read", Some(json!({})))
+        .await?;
+    let response: GetAccountCredentialNoticeResponse =
+        timeout(READ_TIMEOUT, app.read_response(request)).await??;
+    assert_eq!(response.notice.as_deref(), Some(notice));
+
+    mount_model_response(&server).await?;
+    let started = timeout(READ_TIMEOUT, app.start_thread(ThreadStartParams::default())).await??;
+    let request = app
+        .send_turn_start_request(TurnStartParams {
+            thread_id: started.thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Use the workspace account.".to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: TurnStartResponse = timeout(READ_TIMEOUT, app.read_response(request)).await??;
+    let completed: TurnCompletedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("turn/completed")).await??;
+    assert_eq!(completed.turn.status, TurnStatus::Completed);
+
+    let requests = server.received_requests().await.unwrap_or_default();
+    let model_requests = requests
+        .iter()
+        .filter(|request| request.url.path() == "/v1/responses")
+        .collect::<Vec<_>>();
+    assert!(!model_requests.is_empty());
+    for request in model_requests {
+        assert_eq!(
+            request
+                .headers
+                .get("chatgpt-account-id")
+                .and_then(|value| value.to_str().ok()),
+            Some("helper-account")
+        );
+    }
+    assert!(
+        !requests
+            .iter()
+            .any(|request| request.url.path().ends_with("/config/bundle")),
+        "a declared helper credential must not load the workspace's cloud config bundle"
+    );
+    assert_account(&mut app, workspace_account).await?;
+    Ok(())
+}

+#[cfg(unix)]
+#[tokio::test]
+async fn auth_helper_login_forwards_workspace_plans_and_shows_the_enrollment_notice() -> Result<()>
+{
+    skip_if_no_network!(Ok(()));
+    let notice = "Enrolled work without selecting it; switch to it with your helper.";
+    let (response, location, result, home) = auth_helper_login(
+        serde_json::json!({
+            "chatgpt_plan_type": "business",
+            "chatgpt_account_id": "workspace-account",
+            "chatgpt_user_id": "workspace-user",
+        }),
+        serde_json::json!({"version": 1, "ok": true, "account_key": "work",
+            "selected": false, "notice": notice}),
+        Some(serde_json::json!({"auth_mode": "apikey", "OPENAI_API_KEY": "sk-existing"})),
+    )
+    .await?;
+    assert!(response.status().is_success());
+    let page = response.text().await?;
+    assert!(page.contains(notice), "{page}");
+    // The notice rides along with the normal success-page parameters.
+    let location = Url::parse(&location.expect("success redirect"))?;
+    let query = location
+        .query_pairs()
+        .collect::<std::collections::HashMap<_, _>>();
+    assert_eq!(location.path(), "/success");
+    assert_eq!(
+        query.get("auth_helper_notice").map(|v| v.as_ref()),
+        Some(notice)
+    );
+    assert!(query.contains_key("needs_setup"), "{location}");
+    result?;
+    let request: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(
+        home.path().join("helper-request.json"),
+    )?)?;
+    assert_eq!(request["op"], "register");
+    assert_eq!(request["select"], true);
+    assert_eq!(request["auth"]["account_id"], "workspace-account");
+    // An enrollment the helper left unselected keeps the previous API-key login.
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(&std::fs::read_to_string(
+            home.path().join("auth.json")
+        )?)?,
+        serde_json::json!({"auth_mode": "apikey", "OPENAI_API_KEY": "sk-existing"})
+    );
+    Ok(())

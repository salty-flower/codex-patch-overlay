+#[tokio::test]
+async fn self_invalidating_refresh_yields_gate_without_losing_dirty_state() {
+    let thread_id = ThreadId::new();
+    let refresh = McpRefresh::new();
+    let gate = refresh.acquire().await.unwrap();
+    let mut budget = 2;
+    for _ in 0..2 {
+        refresh.invalidate(McpRefreshReason::RuntimeAuthChanged);
+        let claimed = refresh
+            .claim_with_budget(thread_id, &mut budget)
+            .expect("budget remains");
+        assert!(publish(claimed));
+    }
+    refresh.invalidate(McpRefreshReason::RuntimeAuthChanged);
+    assert!(refresh.claim_with_budget(thread_id, &mut budget).is_err());
+    assert!(refresh.is_pending());
+    drop(gate);
+    let _next_gate = refresh.acquire().await.unwrap();
+    let mut next_budget = 2;
+    let claimed = refresh
+        .claim_with_budget(thread_id, &mut next_budget)
+        .expect("fresh budget");
+    assert!(publish(claimed));
+    assert!(matches!(
+        refresh.claim_with_budget(thread_id, &mut next_budget),
+        Ok(None)
+    ));
+}
+
+#[test]
+fn a_spent_round_pauses_then_a_fresh_round_claims_again() {
+    let thread_id = ThreadId::new();
+    let refresh = McpRefresh::new();
+    let mut rounds = PublicationRounds::new();
+    for _ in 0..PUBLICATIONS_PER_ROUND {
+        refresh.invalidate(McpRefreshReason::RuntimeAuthChanged);
+        assert!(matches!(
+            publish_round(rounds.claim(&refresh, thread_id)),
+            PublicationClaim::Claimed(_)
+        ));
+    }
+    refresh.invalidate(McpRefreshReason::RuntimeAuthChanged);
+    assert!(matches!(
+        rounds.claim(&refresh, thread_id),
+        PublicationClaim::Pause
+    ));
+    assert!(refresh.is_pending());
+    // The pause is what makes the next publication possible at all.
+    assert!(matches!(
+        publish_round(rounds.claim(&refresh, thread_id)),
+        PublicationClaim::Claimed(_)
+    ));
+    assert!(!refresh.is_pending());
+    assert!(matches!(
+        rounds.claim(&refresh, thread_id),
+        PublicationClaim::Idle
+    ));
+}
+
+#[test]
+fn exhausted_rounds_stop_retrying_with_work_still_pending() {
+    let thread_id = ThreadId::new();
+    let refresh = McpRefresh::new();
+    let mut rounds = PublicationRounds::new();
+    let mut pauses = 0;
+    loop {
+        refresh.invalidate(McpRefreshReason::RuntimeAuthChanged);
+        match publish_round(rounds.claim(&refresh, thread_id)) {
+            PublicationClaim::Claimed(_) => continue,
+            PublicationClaim::Pause => {
+                pauses += 1;
+                assert!(pauses < PUBLICATION_ROUNDS);
+            }
+            PublicationClaim::Exhausted => break,
+            PublicationClaim::Idle => panic!("pending work must never report idle"),
+        }
+    }
+    assert_eq!(pauses, PUBLICATION_ROUNDS - 1);
+    assert!(refresh.is_pending());
+}

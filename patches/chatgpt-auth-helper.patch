+/// Publications allowed before an in-gate refresh pauses to let a
+/// self-invalidating publisher settle.
+const PUBLICATIONS_PER_ROUND: usize = 2;
+/// Rounds of publications plus backoff before a refresh reports failure.
+const PUBLICATION_ROUNDS: usize = 3;
+/// Pause between rounds. Bounded, so a wedged publisher cannot hold the gate.
+pub(super) const PUBLICATION_BACKOFF: Duration = Duration::from_millis(/*millis*/ 50);
+
+/// How the next in-gate publication attempt should proceed.
+pub(super) enum PublicationClaim<'a> {
+    /// Publish now; the guard restores the claimed causes unless publication completes.
+    Claimed(McpRefreshInvalidationGuard<'a>),
+    /// Nothing is pending; the refresh is already up to date.
+    Idle,
+    /// This round is spent while work is still pending; pause and start a
+    /// fresh round.
+    Pause,
+    /// Every round is spent and work is still pending.
+    Exhausted,
+}
+
+/// Bounded retry policy for a publisher whose own publication dirties its
+/// inputs. Retrying once is not enough for a transient invalidation, and
+/// retrying forever monopolizes an idle task, so a spent round buys a short
+/// pause and a fresh round until the rounds run out.
+pub(super) struct PublicationRounds {
+    remaining_publications: usize,
+    remaining_rounds: usize,
+}
+
+impl PublicationRounds {
+    pub(super) fn new() -> Self {
+        Self {
+            remaining_publications: PUBLICATIONS_PER_ROUND,
+            remaining_rounds: PUBLICATION_ROUNDS,
+        }
+    }
+
+    pub(super) fn claim<'a>(
+        &mut self,
+        refresh: &'a McpRefresh,
+        thread_id: ThreadId,
+    ) -> PublicationClaim<'a> {
+        match refresh.claim_with_budget(thread_id, &mut self.remaining_publications) {
+            Ok(Some(guard)) => PublicationClaim::Claimed(guard),
+            Ok(None) => PublicationClaim::Idle,
+            Err(()) => {
+                if self.remaining_rounds <= 1 {
+                    return PublicationClaim::Exhausted;
+                }
+                self.remaining_rounds -= 1;
+                self.remaining_publications = PUBLICATIONS_PER_ROUND;
+                PublicationClaim::Pause
+            }
+        }
+    }
+}

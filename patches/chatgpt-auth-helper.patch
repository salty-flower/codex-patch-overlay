+#[tokio::test]
+async fn credential_notice_is_scoped_to_the_account_that_requested_it() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let first = chat.credential_notice_generation();
+    chat.on_credential_notice_loaded(first, Some("Workspace policies not applied.".into()));
+    assert_eq!(
+        chat.credential_notice(),
+        Some("Workspace policies not applied.")
+    );
+
+    chat.update_account_state(
+        /*status_account_display*/ None, /*plan_type*/ None,
+        /*has_chatgpt_account*/ true, /*has_codex_backend_auth*/ true,
+    );
+    assert_eq!(chat.credential_notice(), None);
+    // A read that started for the previous account must not label the new one.
+    chat.on_credential_notice_loaded(first, Some("Workspace policies not applied.".into()));
+    assert_eq!(chat.credential_notice(), None);
+    let second = chat.credential_notice_generation();
+    chat.on_credential_notice_loaded(second, Some("Second account notice.".into()));
+    assert_eq!(chat.credential_notice(), Some("Second account notice."));
+}

+#[cfg(unix)]
+#[tokio::test]
+async fn auth_helper_owner_refresh_does_not_publish_after_admission_revision_goes_stale()
+-> Result<()> {
+    let home = tempdir()?;
+    let (manager, _) = manager_with_local_requirements(
+        home.path(),
+        "[application.network.domains]\n'allowed.example' = 'allow'",
+        CloudConfigBundleLoader::default(),
+    )?;
+    manager.refresh_application_network_policy().await?;
+    let auth = auth_helper_personal_auth().await?;
+
+    let reload_permit = Arc::clone(&manager.network_policy_reload)
+        .acquire_owned()
+        .await?;
+    manager.network_policy.policy().invalidate();
+    let admitted_revision = manager.network_policy.policy().revision();
+    let refresh = tokio::spawn({
+        let manager = manager.clone();
+        async move {
+            manager
+                .refresh_auth_helper_application_network_policy(&auth, admitted_revision)
+                .await
+        }
+    });
+    let mut refresh = refresh;
+    assert!(
+        timeout(Duration::from_millis(100), &mut refresh)
+            .await
+            .is_err(),
+        "refresh should wait for the held policy reload permit"
+    );
+
+    manager.network_policy.policy().invalidate();
+    drop(reload_permit);
+    let stale = refresh.await?.unwrap_err();
+    assert_eq!(
+        stale.get_ref().and_then(|error| error.downcast_ref()),
+        Some(&NetworkPolicyDenied::Revoked),
+    );
+    assert_eq!(
+        manager
+            .network_policy
+            .policy()
+            .acquire(&"https://allowed.example".parse()?)
+            .map(|_| ()),
+        Err(NetworkPolicyDenied::Unavailable),
+    );
+    assert_eq!(
+        manager
+            .network_policy
+            .policy()
+            .acquire_for_unsupported_sdk()
+            .map(|_| ()),
+        Err(NetworkPolicyDenied::Unavailable),
+    );
+    Ok(())

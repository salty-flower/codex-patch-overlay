+use super::*;
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use codex_http_client::DestinationPolicy;
+use codex_http_client::NetworkPolicyController;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use tokio::sync::Notify;
+use tokio::sync::mpsc;
+
+fn helper_auth(account: &str, credential_revision: u64) -> CodexAuth {
+    helper_auth_with_epoch(account, credential_revision, 7)
+}
+
+fn helper_auth_with_epoch(
+    account: &str,
+    credential_revision: u64,
+    selection_epoch: u64,
+) -> CodexAuth {
+    helper_auth_with_credentials(
+        account,
+        credential_revision,
+        selection_epoch,
+        "synthetic-access",
+    )
+}
+
+fn helper_auth_with_credentials(
+    account: &str,
+    credential_revision: u64,
+    selection_epoch: u64,
+    access_token: &str,
+) -> CodexAuth {
+    let claims = json!({
+        "https://api.openai.com/auth": {
+            "chatgpt_account_id": account,
+            "chatgpt_user_id": "synthetic-user",
+            "chatgpt_plan_type": "pro"
+        }
+    });
+    let id_token = format!(
+        "e30.{}.signature",
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(&claims).unwrap())
+    );
+    let snapshot = serde_json::from_value(json!({
+        "account_key": account,
+        "account_id": account,
+        "selection_epoch": selection_epoch,
+        "credential_revision": credential_revision,
+        "id_token": id_token,
+        "access_token": access_token,
+        "expires_at": chrono::Utc::now().timestamp() + 3600
+    }))
+    .unwrap();
+    CodexAuth::from_auth_helper_snapshot(snapshot, None).unwrap()
+}
+
+fn install_auth_helper(manager: &mut Arc<AuthManager>) {
+    let helper: Arc<dyn super::ExternalAuth> = Arc::new(
+        super::ChatgptAuthHelper::new(vec!["/synthetic/missing-auth-helper".to_string()])
+            .expect("absolute synthetic helper path should be accepted"),
+    );
+    let manager = Arc::get_mut(manager).expect("test manager should not have been cloned");
+    *manager.external_auth.write().unwrap() = Some(helper);
+}
+
+fn managed_manager(
+    auth: CodexAuth,
+) -> (
+    Arc<AuthManager>,
+    NetworkPolicyController,
+    codex_http_client::NetworkPolicy,
+) {
+    let mut manager = AuthManager::from_auth_for_testing(auth);
+    let controller = NetworkPolicyController::default();
+    let policy = controller.policy();
+    Arc::get_mut(&mut manager)
+        .expect("test manager should not have been cloned")
+        .auth_route_config = AuthRouteConfig::from_http_client_factory(
+        manager
+            .http_client_factory()
+            .with_network_policy(policy.clone()),
+    );
+    (manager, controller, policy)
+}
+
+#[tokio::test]
+async fn request_waits_for_application_network_policy_refresh() {
+    let auth = helper_auth("account-a", 3);
+    let (manager, controller, policy) = managed_manager(auth.clone());
+    let (callback_tx, mut callback_rx) = mpsc::unbounded_channel();
+    let callback_gate = Arc::new(Notify::new());
+    let callback_gate_for_refresh = Arc::clone(&callback_gate);
+    manager
+        .set_application_network_policy_refresh_callback(move |callback_auth, revision| {
+            let callback_tx = callback_tx.clone();
+            let callback_gate = Arc::clone(&callback_gate_for_refresh);
+            let controller = controller.clone();
+            async move {
+                callback_tx
+                    .send((callback_auth, revision))
+                    .map_err(std::io::Error::other)?;
+                callback_gate.notified().await;
+                if !controller.publish(revision, DestinationPolicy::Unrestricted) {
+                    return Err(std::io::Error::other("policy revision changed"));
+                }
+                Ok(())
+            }
+        })
+        .unwrap();
+
+    let request_manager = Arc::clone(&manager);
+    let request_auth = auth.clone();
+    let request = tokio::spawn(async move {
+        request_manager
+            .refresh_application_network_policy_for_request(&request_auth)
+            .await
+    });
+
+    let (callback_auth, callback_revision) =
+        tokio::time::timeout(std::time::Duration::from_secs(1), callback_rx.recv())
+            .await
+            .expect("refresh callback should start")
+            .expect("refresh callback should report its request");
+    assert_eq!(
+        callback_auth.auth_helper_identity(),
+        auth.auth_helper_identity()
+    );
+    assert_eq!(callback_auth.get_account_id(), Some("account-a".into()));
+    assert_eq!(callback_revision, policy.revision());
+    assert!(!policy.is_available());
+    assert!(
+        !request.is_finished(),
+        "request admission must wait for policy publication"
+    );
+
+    callback_gate.notify_one();
+    request
+        .await
+        .expect("policy refresh task should finish")
+        .expect("policy refresh should succeed");
+    assert!(policy.is_available());
+}
+
+#[tokio::test]
+async fn captured_policy_factory_cannot_rebind_after_account_switch() {
+    let auth = helper_auth("account-a", 3);
+    let (manager, controller, policy) = managed_manager(auth.clone());
+    let controller_for_refresh = controller.clone();
+    manager
+        .set_application_network_policy_refresh_callback(move |_, revision| {
+            let controller = controller_for_refresh.clone();
+            async move {
+                assert!(controller.publish(revision, DestinationPolicy::Unrestricted));
+                Ok(())
+            }
+        })
+        .unwrap();
+
+    let factory = manager
+        .refresh_application_network_policy_for_request(&auth)
+        .await
+        .expect("account A policy should be captured");
+    let endpoint = "https://policy-pin.example/".parse().unwrap();
+    assert!(factory.network_policy().acquire(&endpoint).is_ok());
+
+    manager.set_cached_auth(Some(helper_auth("account-b", 1)));
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+
+    let repeated_account_binding = factory.network_policy().clone().for_current_account();
+    assert_eq!(
+        repeated_account_binding.acquire(&endpoint).err(),
+        Some(codex_http_client::NetworkPolicyDenied::Revoked),
+        "reusing a captured factory must retain account A's binding"
+    );
+    assert!(
+        manager
+            .http_client_factory()
+            .network_policy()
+            .acquire(&endpoint)
+            .is_ok(),
+        "the current manager should create a factory for account B"
+    );
+}
+
+#[tokio::test]
+async fn same_auth_helper_owner_can_capture_policy_after_credential_refresh() {
+    let previous_auth = helper_auth("account-a", 3);
+    let refreshed_auth =
+        helper_auth_with_credentials("account-a", 4, 7, "refreshed-synthetic-access");
+    let (manager, controller, policy) = managed_manager(previous_auth.clone());
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+    manager.set_cached_auth(Some(refreshed_auth));
+
+    let factory = manager
+        .http_client_factory_for_auth(&previous_auth, None)
+        .expect("same account and selection epoch should retain the policy binding");
+
+    assert!(factory.network_policy().is_available());
+}
+
+#[tokio::test]
+async fn same_auth_helper_token_with_new_selection_epoch_is_rejected() {
+    let current_auth = helper_auth_with_epoch("account-a", 3, 7);
+    let stale_epoch_auth = helper_auth_with_epoch("account-a", 3, 8);
+    let (manager, controller, policy) = managed_manager(current_auth);
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+
+    let error = manager
+        .http_client_factory_for_auth(&stale_epoch_auth, None)
+        .expect_err("a different selection epoch must not capture the current policy");
+
+    assert_eq!(
+        error.to_string(),
+        codex_http_client::NetworkPolicyDenied::Revoked.to_string()
+    );
+}
+
+#[tokio::test]
+async fn request_snapshot_factory_cannot_rebind_after_account_switch() {
+    let auth = helper_auth("account-a", 3);
+    let (mut manager, controller, policy) = managed_manager(auth.clone());
+    install_auth_helper(&mut manager);
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+
+    let request_snapshot = manager
+        .for_request_snapshot(auth)
+        .expect("request snapshot should capture its owner's factory");
+
+    manager.set_cached_auth(Some(helper_auth("account-b", 1)));
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+    let endpoint = "https://policy-pin.example/".parse().unwrap();
+
+    assert_eq!(
+        request_snapshot
+            .http_client_factory()
+            .network_policy()
+            .acquire(&endpoint)
+            .err(),
+        Some(codex_http_client::NetworkPolicyDenied::Revoked),
+        "a long-lived MCP request snapshot must retain account A's policy binding"
+    );
+}
+
+#[tokio::test]
+async fn scoped_old_auth_is_not_paired_with_current_policy() {
+    let auth_a = helper_auth("account-a", 3);
+    let auth_b = helper_auth("account-b", 1);
+    let manager = AuthManager::from_auth_for_testing(auth_a.clone());
+
+    manager
+        .scope_request_auth(auth_a, async {
+            manager.set_cached_auth(Some(auth_b));
+            assert!(
+                manager.auth_with_http_client_factory().await.is_none(),
+                "scoped account A auth must fail closed after the manager switches to B"
+            );
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn application_network_policy_callback_error_keeps_policy_unavailable() {
+    let auth = helper_auth("account-a", 1);
+    let (manager, _controller, policy) = managed_manager(auth.clone());
+    manager
+        .set_application_network_policy_refresh_callback(|_, _| async {
+            Err(std::io::Error::other("synthetic refresh failure"))
+        })
+        .unwrap();
+
+    let error = manager
+        .refresh_application_network_policy_for_request(&auth)
+        .await
+        .unwrap_err();
+
+    assert_eq!(error.to_string(), "synthetic refresh failure");
+    assert!(!policy.is_available());
+}
+
+#[tokio::test]
+async fn owner_change_revokes_a_waiting_policy_refresh() {
+    let auth = helper_auth("account-a", 1);
+    let (manager, controller, policy) = managed_manager(auth.clone());
+    let (callback_tx, mut callback_rx) = mpsc::unbounded_channel();
+    let callback_gate = Arc::new(Notify::new());
+    let callback_gate_for_refresh = Arc::clone(&callback_gate);
+    let stale_publish_succeeded = Arc::new(AtomicBool::new(false));
+    let stale_publish_succeeded_for_refresh = Arc::clone(&stale_publish_succeeded);
+    manager
+        .set_application_network_policy_refresh_callback(move |_, revision| {
+            let callback_tx = callback_tx.clone();
+            let callback_gate = Arc::clone(&callback_gate_for_refresh);
+            let stale_publish_succeeded = Arc::clone(&stale_publish_succeeded_for_refresh);
+            let controller = controller.clone();
+            async move {
+                callback_tx.send(revision).map_err(std::io::Error::other)?;
+                callback_gate.notified().await;
+                stale_publish_succeeded.store(
+                    controller.publish(revision, DestinationPolicy::Unrestricted),
+                    Ordering::SeqCst,
+                );
+                Ok(())
+            }
+        })
+        .unwrap();
+
+    let request_manager = Arc::clone(&manager);
+    let request_auth = auth.clone();
+    let request = tokio::spawn(async move {
+        request_manager
+            .refresh_application_network_policy_for_request(&request_auth)
+            .await
+    });
+    let old_revision = tokio::time::timeout(std::time::Duration::from_secs(1), callback_rx.recv())
+        .await
+        .expect("refresh callback should start")
+        .expect("refresh callback should report its revision");
+    assert_eq!(old_revision, policy.revision());
+
+    manager.set_cached_auth(Some(helper_auth("account-b", 1)));
+    assert!(!policy.is_available());
+    callback_gate.notify_one();
+
+    let error = request
+        .await
+        .expect("policy refresh task should finish")
+        .expect_err("old owner refresh must be rejected");
+    assert_eq!(
+        error.to_string(),
+        codex_http_client::NetworkPolicyDenied::Revoked.to_string()
+    );
+    assert!(!stale_publish_succeeded.load(Ordering::SeqCst));
+    assert!(!policy.is_available());
+}
+

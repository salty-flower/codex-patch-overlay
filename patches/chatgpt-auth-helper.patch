+        return LoginSuccessRedirect::Local(url);
+    };
+    parsed
+        .query_pairs_mut()
+        .append_pair(AUTH_HELPER_NOTICE_QUERY_KEY, notice);
+    LoginSuccessRedirect::Local(parsed.into())
+}

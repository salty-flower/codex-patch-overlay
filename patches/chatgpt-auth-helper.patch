 impl ConfigManager {
+    /// Reinstalls the local application policy for an admitted auth helper owner.
+    ///
+    /// Auth helper identities never load a cloud configuration bundle.
+    /// Requiring the previous snapshot to prove that it contained no cloud bundle keeps
+    /// this recovery path from reusing another account's cached managed policy.
+    pub(crate) async fn refresh_auth_helper_application_network_policy(
+        &self,
+        auth: &codex_login::CodexAuth,
+        expected_revision: codex_http_client::NetworkPolicyRevision,
+    ) -> io::Result<()> {
+        if auth.auth_helper_identity().is_none() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "application network policy refresh requires a ChatGPT auth helper owner",
+            ));
+        }
+
+        let policy = self.network_policy.policy();
+        if policy.revision() != expected_revision {
+            return Err(io::Error::other(NetworkPolicyDenied::Revoked));
+        }
+
+        let _reload = self
+            .network_policy_reload
+            .acquire()
+            .await
+            .map_err(io::Error::other)?;
+        if policy.revision() != expected_revision {
+            return Err(io::Error::other(NetworkPolicyDenied::Revoked));
+        }
+
+        let cached_cloud = self
+            .network_policy_snapshot
+            .read()
+            .map_err(|_| io::Error::other("application network policy snapshot lock poisoned"))?
+            .as_ref()
+            .map(|snapshot| snapshot.cloud.is_some());
+        match cached_cloud {
+            Some(false) => {}
+            Some(true) => {
+                self.fail_application_policy(expected_revision)?;
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "cached managed cloud policy cannot be applied to a ChatGPT auth helper owner",
+                ));
+            }
+            None => {
+                self.fail_application_policy(expected_revision)?;
+                return Err(io::Error::other(NetworkPolicyDenied::Unavailable));
+            }
+        }
+
+        if policy.is_available()
+            && self
+                .network_policy_snapshot
+                .read()
+                .map_err(|_| io::Error::other("application network policy snapshot lock poisoned"))?
+                .as_ref()
+                .is_some_and(|snapshot| snapshot.revision == expected_revision)
+        {
+            return Ok(());
+        }
+
+        let local_sources = self.load_local_network_policy(expected_revision).await?;
+        let application = match local_sources.compose(Default::default()) {
+            Ok(application) => application,
+            Err(error) => {
+                self.fail_application_policy(expected_revision)?;
+                return Err(error);
+            }
+        };
+        let policy = destination_policy(application.as_ref());
+
+        let mut current = self
+            .network_policy_snapshot
+            .write()
+            .map_err(|_| io::Error::other("application network policy snapshot lock poisoned"))?;
+        if !self
+            .network_policy
+            .publish(expected_revision, policy.clone())
+        {
+            *current = None;
+            return Err(io::Error::other(NetworkPolicyDenied::Revoked));
+        }
+        *current = Some(Arc::new(ApplicationPolicySnapshot {
+            revision: expected_revision,
+            policy,
+            cloud: None,
+        }));
+        Ok(())
+    }
+

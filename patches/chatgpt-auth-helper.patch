+fn counting_helper(response: Value, counter: &std::path::Path) -> ChatgptAuthHelper {
+    let response = serde_json::to_string(&response)
+        .unwrap()
+        .replace('\'', "'\\''");
+    let counter = counter.display();
+    ChatgptAuthHelper::new(vec![
+        "/bin/sh".into(),
+        "-c".into(),
+        format!("printf x >> '{counter}'; IFS= read -r request; printf '%s' '{response}'"),
+    ])
+    .unwrap()
+}

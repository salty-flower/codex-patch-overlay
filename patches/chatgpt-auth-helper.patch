+//! Auth helper account admission before any account-dependent step preparation.
+//!
+//! Auth helper credentials never load a workspace cloud configuration bundle.
+//! Never replace process-global cloud state asynchronously after starting a request.
+
+use super::*;
+use codex_config::ConfigLayerSource;
+use codex_config::ConfigRequirements;
+use codex_config::RequirementSource;
+use codex_core_plugins::PluginsConfigInput;
+use codex_core_plugins::remote::RemotePluginCatalogError;
+use codex_http_client::RouteAwareRequestError;
+use codex_protocol::config_types::ForcedLoginMethod;
+use std::time::Duration;
+use std::time::Instant;
+
+/// Settings, environments, and account transport captured before tool preparation.
+pub(super) struct PreparedStepContext<F> {
+    pub(super) helper_auth: Option<CodexAuth>,
+    pub(super) helper_http_client_factory: Option<codex_http_client::HttpClientFactory>,
+    pub(super) settings: Arc<ResolvedStepSettings>,
+    pub(super) environments: F,
+    pub(super) inherited_environments: Option<TurnEnvironmentSnapshot>,
+}
+
+fn validate_helper_step(config: &Config, auth: &CodexAuth) -> CodexResult<()> {
+    // Managed configuration loaded for another login must never govern a helper credential.
+    if config
+        .config_layer_stack
+        .layers_low_to_high()
+        .any(|layer| matches!(layer.name, ConfigLayerSource::EnterpriseManaged { .. }))
+        || has_cloud_requirements(config.config_layer_stack.requirements())
+    {
+        return Err(CodexErr::InvalidRequest(
+            "ChatGPT auth helper credentials cannot run under a workspace's managed cloud configuration; restart Codex or remove chatgpt_auth_helper".to_string(),
+        ));
+    }
+    let requirements = config.config_layer_stack.requirements();
+    if config
+        .forced_login_method
+        .is_some_and(|method| method != ForcedLoginMethod::Chatgpt)
+        || config
+            .forced_chatgpt_workspace_id
+            .as_ref()
+            .is_some_and(|allowed| {
+                !auth
+                    .get_account_id()
+                    .is_some_and(|account| allowed.contains(&account))
+            })
+        || requirements
+            .allowed_login_methods
+            .as_ref()
+            .is_some_and(|allowed| !allowed.value.contains(&ForcedLoginMethod::Chatgpt))
+        || requirements
+            .allowed_chatgpt_workspaces
+            .as_ref()
+            .is_some_and(|allowed| {
+                !auth
+                    .get_account_id()
+                    .is_some_and(|account| allowed.value.contains(&account))
+            })
+    {
+        return Err(CodexErr::InvalidRequest(
+            "ChatGPT auth helper account is not permitted by the current session requirements"
+                .to_string(),
+        ));
+    }
+    Ok(())
+}
+
+fn is_cloud_source(source: &RequirementSource) -> bool {
+    match source {
+        RequirementSource::EnterpriseManaged { .. } => true,
+        RequirementSource::Composite { sources } => sources.iter().any(is_cloud_source),
+        RequirementSource::Unknown
+        | RequirementSource::MdmManagedPreferences { .. }
+        | RequirementSource::SystemRequirementsToml { .. }
+        | RequirementSource::LegacyManagedConfigTomlFromFile { .. }
+        | RequirementSource::LegacyManagedConfigTomlFromMdm => false,
+    }
+}
+
+fn has_cloud_requirements(requirements: &ConfigRequirements) -> bool {
+    // Exhaustive destructuring keeps newly introduced managed authority visible
+    // at this fail-closed boundary, including requirement-only cloud bundles.
+    let ConfigRequirements {
+        allowed_login_methods,
+        allowed_chatgpt_workspaces,
+        cli_auth_credentials_store,
+        chatgpt_base_url,
+        sqlite_home,
+        unsafe_enforce_sqlite_journal_mode,
+        log_dir,
+        model_catalog_json,
+        model_provider,
+        model_providers,
+        check_for_update_on_startup,
+        allow_login_shell,
+        feedback,
+        approval_policy,
+        approvals_reviewer,
+        auto_review_required_models,
+        permission_profile,
+        windows_sandbox_mode,
+        web_search_mode,
+        allow_managed_hooks_only,
+        allow_appshots,
+        allow_remote_control,
+        computer_use,
+        feature_requirements,
+        managed_hooks,
+        mcp_servers,
+        plugins,
+        marketplaces,
+        otel,
+        exec_policy,
+        enforce_residency,
+        network,
+        application,
+        filesystem,
+        additional_developer_instructions,
+        guardian_policy_config_source,
+        guardian_extra_policy_source,
+    } = requirements;
+    [
+        allowed_login_methods.as_ref().map(|value| &value.source),
+        allowed_chatgpt_workspaces
+            .as_ref()
+            .map(|value| &value.source),
+        cli_auth_credentials_store
+            .as_ref()
+            .map(|value| &value.source),
+        chatgpt_base_url.as_ref().map(|value| &value.source),
+        sqlite_home.as_ref().map(|value| &value.source),
+        unsafe_enforce_sqlite_journal_mode
+            .as_ref()
+            .map(|value| &value.source),
+        log_dir.as_ref().map(|value| &value.source),
+        model_catalog_json.as_ref().map(|value| &value.source),
+        model_provider.as_ref().map(|value| &value.source),
+        model_providers.as_ref().map(|value| &value.source),
+        check_for_update_on_startup
+            .as_ref()
+            .map(|value| &value.source),
+        allow_login_shell.as_ref().map(|value| &value.source),
+        feedback.as_ref().map(|value| &value.source),
+        approval_policy.source.as_ref(),
+        approvals_reviewer.source.as_ref(),
+        auto_review_required_models
+            .as_ref()
+            .map(|value| &value.source),
+        permission_profile.source.as_ref(),
+        windows_sandbox_mode.source.as_ref(),
+        web_search_mode.source.as_ref(),
+        allow_managed_hooks_only.as_ref().map(|value| &value.source),
+        allow_appshots.as_ref().map(|value| &value.source),
+        allow_remote_control.as_ref().map(|value| &value.source),
+        computer_use.as_ref().map(|value| &value.source),
+        feature_requirements.as_ref().map(|value| &value.source),
+        managed_hooks
+            .as_ref()
+            .and_then(|value| value.source.as_ref()),
+        mcp_servers.as_ref().map(|value| &value.source),
+        plugins.as_ref().map(|value| &value.source),
+        marketplaces.as_ref().map(|value| &value.source),
+        otel.as_ref().map(|value| &value.source),
+        exec_policy.as_ref().map(|value| &value.source),
+        enforce_residency.source.as_ref(),
+        network.as_ref().map(|value| &value.source),
+        application.as_ref().map(|value| &value.source),
+        filesystem.as_ref().map(|value| &value.source),
+        additional_developer_instructions
+            .as_ref()
+            .map(|value| &value.source),
+        guardian_policy_config_source.as_ref(),
+        guardian_extra_policy_source.as_ref(),
+    ]
+    .into_iter()
+    .flatten()
+    .any(is_cloud_source)
+}
+
+const PLUGIN_INVENTORY_RETRY_DELAY: Duration = Duration::from_secs(1);
+
+/// How long step preparation waits for an in-flight installed-plugin sync.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct PluginSyncWait {
+    timeout: Duration,
+    notice_after: Duration,
+}
+
+impl PluginSyncWait {
+    /// On a fresh `CODEX_HOME` the startup sync downloads every installed bundle while it holds
+    /// the gate, which can outlast the shared two-minute mutation wait; the turn stays
+    /// cancellable while it waits.
+    pub(super) const INTERRUPTIBLE: Self = Self {
+        timeout: Duration::from_secs(10 * 60),
+        notice_after: Duration::from_secs(30),
+    };
+    /// A request with no turn to interrupt keeps the shared mutation wait.
+    pub(super) const UNCANCELLABLE: Self = Self {
+        timeout: Duration::from_secs(120),
+        notice_after: Duration::from_secs(30),
+    };
+}
+
+/// Publishes the selected account's installed-plugin snapshot, failing closed with the cause.
+async fn prepare_selected_plugin_inventory<F>(
+    plugins: &PluginsManager,
+    plugins_config: &PluginsConfigInput,
+    auth: &CodexAuth,
+    cancellation_token: &CancellationToken,
+    thread_id: ThreadId,
+    sync_wait: PluginSyncWait,
+    on_slow_sync: impl FnOnce(u64) -> F + Send,
+) -> CodexResult<()>
+where
+    F: std::future::Future<Output = ()> + Send,
+{
+    let unprepared = |stage: &str, err: String| {
+        warn!(
+            %thread_id,
+            stage,
+            error = %err,
+            "ChatGPT auth helper could not prepare the selected account's plugin inventory"
+        );
+        CodexErr::InvalidRequest(format!(
+            "ChatGPT auth helper could not prepare the selected account's plugin inventory ({stage}: {err}); no model request was sent"
+        ))
+    };
+    // A bundle reconcile in flight, such as the startup sync, fences the metadata refresh below
+    // from publishing; wait for its snapshot instead of preparing tools from an inventory that
+    // is still unpublished.
+    let wait_started = Instant::now();
+    let wait = plugins.wait_for_remote_installed_plugin_sync(sync_wait.timeout);
+    let wait = async {
+        tokio::pin!(wait);
+        tokio::select! {
+            synced = &mut wait => synced,
+            () = tokio::time::sleep(sync_wait.notice_after) => {
+                let elapsed_secs = wait_started.elapsed().as_secs();
+                info!(
+                    %thread_id,
+                    elapsed_secs,
+                    "ChatGPT auth helper is waiting for the installed-plugin sync before the next request"
+                );
+                on_slow_sync(elapsed_secs).await;
+                wait.await
+            }
+        }
+    };
+    wait.or_cancel(cancellation_token)
+        .await?
+        .map_err(|err| unprepared("waiting for the installed-plugin sync", err.to_string()))?;
+    if plugins
+        .build_remote_installed_plugin_marketplaces_from_cache(&[])
+        .is_some()
+    {
+        return Ok(());
+    }
+    let fetch = || {
+        plugins.build_and_cache_remote_installed_plugin_marketplaces(
+            plugins_config,
+            Some(auth),
+            &[],
+            /*on_effective_plugins_changed*/ None,
+        )
+    };
+    let result = match fetch().or_cancel(cancellation_token).await? {
+        Err(err) if is_transient_inventory_error(&err) => {
+            warn!(
+                %thread_id,
+                error = %inventory_error_cause(&err),
+                "retrying the selected account's installed-plugin fetch"
+            );
+            tokio::time::sleep(PLUGIN_INVENTORY_RETRY_DELAY)
+                .or_cancel(cancellation_token)
+                .await?;
+            fetch().or_cancel(cancellation_token).await?
+        }
+        result => result,
+    };
+    result.map(drop).map_err(|err| {
+        unprepared(
+            "fetching the installed plugins",
+            inventory_error_cause(&err),
+        )
+    })
+}
+
+/// Describes a fetch failure without the request URL or response body, which reach rollouts.
+fn inventory_error_cause(err: &RemotePluginCatalogError) -> String {
+    match err {
+        RemotePluginCatalogError::Request { source, .. } if source.is_timeout() => {
+            "the request timed out".to_string()
+        }
+        RemotePluginCatalogError::Request { source, .. } if source.is_connect() => {
+            "the connection failed".to_string()
+        }
+        RemotePluginCatalogError::Request { .. } => "the request failed".to_string(),
+        RemotePluginCatalogError::UnexpectedStatus { status, .. } => {
+            format!("the backend returned HTTP {status}")
+        }
+        RemotePluginCatalogError::Decode { .. } => "the response was malformed".to_string(),
+        other => other.to_string(),
+    }
+}
+
+/// Transport failures and server-side statuses; auth and response-shape errors repeat.
+fn is_transient_inventory_error(err: &RemotePluginCatalogError) -> bool {
+    match err {
+        RemotePluginCatalogError::InstalledPluginsFetchTimeout => true,
+        RemotePluginCatalogError::Request { source, .. } => matches!(
+            source,
+            RouteAwareRequestError::Request(_) | RouteAwareRequestError::Timeout
+        ),
+        RemotePluginCatalogError::UnexpectedStatus { status, .. } => {
+            status.is_server_error() || status.as_u16() == 429
+        }
+        _ => false,
+    }
+}
+
+impl Session {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "step settings and both environment snapshots must be captured under active_turn then state"
+    )]
+    pub(super) async fn capture_step_context_inner(
+        self: &Arc<Self>,
+        turn_context: Arc<TurnContext>,
+        cancellation_token: &CancellationToken,
+        required_servers: &[String],
+        required_plugins: &HashSet<String>,
+        plugin_sync_wait: PluginSyncWait,
+    ) -> CodexResult<Arc<StepContext>> {
+        // Capture settings and environment selection at the same publication boundary
+        // before account admission can await.
+        // Match apply_turn_settings and activate_turn_environments: active_turn before state.
+        let (settings, environments, inherited_environments) = {
+            let _active = self
+                .active_turn
+                .lock()
+                .or_cancel(cancellation_token)
+                .await?;
+            let _state = self.state.lock().or_cancel(cancellation_token).await?;
+            (
+                turn_context.next_step_settings.load_full(),
+                self.services.turn_environments.snapshot(),
+                self.features
+                    .enabled(Feature::SubagentThreadEnvironments)
+                    .then(|| self.services.turn_environments.configured_snapshot_now()),
+            )
+        };
+        let manager = Arc::clone(&self.services.auth_manager);
+        let helper_auth = if manager.has_auth_helper()
+            && turn_context.provider.info().requires_openai_auth
+        {
+            Some(
+                manager
+                    .auth_for_request(Some(&settings.model_info.slug), /*pinned*/ None)
+                    .or_cancel(cancellation_token)
+                    .await??
+                    .ok_or_else(|| {
+                        CodexErr::InvalidRequest("ChatGPT auth helper is signed out".to_string())
+                    })?,
+            )
+        } else {
+            None
+        };
+        let prepare = async {
+            let mut helper_http_client_factory = None;
+            if let Some(auth) = &helper_auth {
+                validate_helper_step(&turn_context.config, auth)?;
+                {
+                    let state = self.state.lock().await;
+                    let current = &state.session_configuration.original_config_do_not_use;
+                    validate_helper_step(current, auth)?;
+                    if current.enforce_residency.value()
+                        != turn_context.config.enforce_residency.value()
+                    {
+                        return Err(CodexErr::InvalidRequest(
+                            "ChatGPT auth helper cannot change the admitted turn's residency requirements"
+                                .to_string(),
+                        ));
+                    }
+                }
+                helper_http_client_factory = Some(
+                    manager
+                        .refresh_application_network_policy_for_request(auth)
+                        .or_cancel(cancellation_token)
+                        .await??,
+                );
+                let plugins = &self.services.plugins_manager;
+                let plugins_config = turn_context.config.plugins_config_input();
+                if plugins_config.plugins_enabled
+                    && plugins_config.remote_plugin_enabled
+                    && plugins
+                        .build_remote_installed_plugin_marketplaces_from_cache(&[])
+                        .is_none()
+                {
+                    prepare_selected_plugin_inventory(
+                        plugins,
+                        &plugins_config,
+                        auth,
+                        cancellation_token,
+                        self.thread_id,
+                        plugin_sync_wait,
+                        |elapsed_secs| {
+                            let message = format!(
+                                "Waiting for the plugin sync to finish before the next request ({elapsed_secs}s so far); the first request after Codex starts can take a few minutes"
+                            );
+                            let turn_context = &turn_context;
+                            async move {
+                                self.send_event(
+                                    turn_context,
+                                    EventMsg::Warning(WarningEvent { message }),
+                                )
+                                .await;
+                            }
+                        },
+                    )
+                    .await?;
+                    // The awaited metadata refresh does not run background bundle
+                    // reconciliation or delete files retained by another account's turn.
+                    plugins.clear_cache();
+                    self.services.skills_service.clear_cache();
+                    self.mark_mcp_runtime_dirty(crate::McpRefreshReason::AccountPluginCacheChanged);
+                }
+            }
+            let step = self
+                .capture_prepared_step_context(
+                    turn_context,
+                    cancellation_token,
+                    required_servers,
+                    required_plugins,
+                    PreparedStepContext {
+                        helper_auth: helper_auth.clone(),
+                        helper_http_client_factory,
+                        settings,
+                        environments,
+                        inherited_environments,
+                    },
+                )
+                .await?;
+            if let Some(auth) = &helper_auth {
+                let state = self.state.lock().await;
+                let current = &state.session_configuration.original_config_do_not_use;
+                validate_helper_step(current, auth)?;
+                if current.enforce_residency.value() != step.turn.config.enforce_residency.value() {
+                    return Err(CodexErr::InvalidRequest(
+                        "ChatGPT auth helper residency requirements changed during request preparation"
+                            .to_string(),
+                    ));
+                }
+                let plugins = step.turn.config.plugins_config_input();
+                if plugins.plugins_enabled
+                    && plugins.remote_plugin_enabled
+                    && self
+                        .services
+                        .plugins_manager
+                        .build_remote_installed_plugin_marketplaces_from_cache(&[])
+                        .is_none()
+                {
+                    return Err(CodexErr::InvalidRequest(
+                        "ChatGPT auth helper plugin inventory changed during request preparation; retry this turn".to_string(),
+                    ));
+                }
+            }
+            Ok(step)
+        };
+        if let Some(auth) = helper_auth.clone() {
+            manager.scope_request_auth(auth, prepare).await
+        } else {
+            prepare.await
+        }
+    }
+}

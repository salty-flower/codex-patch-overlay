index 0000000000..3382c0af60
--- /dev/null
+++ b/codex-rs/login/src/auth/auth_helper.rs
@@ -0,0 +1,565 @@
+//! Opt-in external ChatGPT credential authority. No refresh credential enters this adapter.
+
+use super::manager::CodexAuth;
+use super::manager::ExternalAuth;
+use super::manager::ExternalAuthFuture;
+use super::manager::ExternalAuthRefreshContext;
+use super::storage::AuthDotJson;
+use super::storage::AuthStorageBackend;
+use codex_protocol::protocol::RateLimitSnapshot;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashMap;
+use std::io;
+use std::path::Path;
+use std::process::Stdio;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::process::Command;
+
+const MAX_MESSAGE_BYTES: u64 = 128 * 1024;
+const HELPER_TIMEOUT: Duration = Duration::from_secs(50);
+const OBSERVATION_TIMEOUT: Duration = Duration::from_secs(1);
+
+#[cfg(unix)]
+mod unix_process {
+    const SIGKILL: i32 = 9;
+
+    unsafe extern "C" {
+        fn kill(pid: i32, signal: i32) -> i32;
+    }
+
+    pub(super) fn kill_group(pid: i32) {
+        // SAFETY: the caller created a process group whose positive PGID is
+        // `pid`; negating it targets that group and can never target ours.
+        let _ = unsafe { kill(-pid, SIGKILL) };
+    }
+
+    #[cfg(test)]
+    pub(super) fn process_exists(pid: i32) -> bool {
+        // SAFETY: signal zero checks existence/permission without sending a signal.
+        unsafe {
+            kill(pid, /*signal*/ 0) == 0
+        }
+    }
+}
+
+// Keep this guard alive until after wait(), including when the RPC future is
+// cancelled by either timeout. kill_on_drop alone only kills the direct child.
+#[cfg(unix)]
+struct HelperProcessGroup {
+    pid: u32,
+    // A helper that answered and exited is finished work, not abandoned work.
+    // Only an abandoned RPC may signal the group, so a completed call can never
+    // SIGKILL a recycled process group.
+    armed: bool,
+}
+
+#[cfg(unix)]
+impl HelperProcessGroup {
+    fn new(pid: u32) -> Self {
+        Self { pid, armed: true }
+    }
+
+    fn disarm(&mut self) {
+        self.armed = false;
+    }
+}
+
+#[cfg(unix)]
+impl Drop for HelperProcessGroup {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+        if let Ok(pid) = i32::try_from(self.pid) {
+            // The guard is armed only while `process_group(0)` makes this
+            // helper's PID its own PGID, and `kill_group` negates it.
+            unix_process::kill_group(pid);
+        }
+    }
+}
+
+/// Secret-free identity used to bind a request, retry and socket to its credentials.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct AuthHelperIdentity {
+    pub account_key: String,
+    pub selection_epoch: u64,
+    pub credential_revision: u64,
+}
+
+#[derive(Deserialize)]
+pub(crate) struct AuthHelperSnapshot {
+    #[serde(flatten)]
+    pub identity: AuthHelperIdentity,
+    pub account_id: String,
+    pub access_token: String,
+    pub id_token: Option<String>,
+    pub expires_at: i64,
+    /// `not_applied` declares that the account's workspace managed configuration
+    /// does not apply to this credential.
+    #[serde(default)]
+    pub managed_config: Option<String>,
+    /// Single-line text to show while this credential is in use.
+    #[serde(default)]
+    pub notice: Option<String>,
+}
+
+const MAX_HELPER_TEXT_CHARS: usize = 400;
+
+/// Helper-supplied text the protocol marks as user-facing, flattened to one bounded line.
+pub(crate) fn helper_display_text(text: &str) -> Option<String> {
+    let flattened = text
+        .chars()
+        .map(|c| if c.is_control() { ' ' } else { c })
+        .collect::<String>();
+    let mut line = flattened.split_whitespace().collect::<Vec<_>>().join(" ");
+    if line.chars().count() > MAX_HELPER_TEXT_CHARS {
+        line = line.chars().take(MAX_HELPER_TEXT_CHARS - 1).collect();
+        line.push('…');
+    }
+    (!line.is_empty()).then_some(line)
+}
+
+/// Helper declarations that travel with one credential snapshot.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(super) struct AuthHelperDisclosure {
+    pub managed_config_not_applied: bool,
+    pub notice: Option<String>,
+}
+
+/// A successful enrollment; the helper may leave the previous account selected.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AuthHelperRegistration {
+    pub selected: bool,
+    pub notice: Option<String>,
+}
+
+/// Runs the machine-state helper without a shell or secret-bearing diagnostics.
+pub struct ChatgptAuthHelper {
+    argv: Vec<String>,
+    auth: Mutex<HashMap<String, CodexAuth>>,
+}
+
+pub(super) struct RequestSnapshotAuth {
+    authority: Arc<dyn ExternalAuth>,
+    current: Mutex<CodexAuth>,
+    update_lock: tokio::sync::Semaphore,
+}
+
+impl RequestSnapshotAuth {
+    pub fn new(authority: Arc<dyn ExternalAuth>, auth: CodexAuth) -> Self {
+        Self {
+            authority,
+            current: Mutex::new(auth),
+            update_lock: tokio::sync::Semaphore::new(/*permits*/ 1),
+        }
+    }
+}
+
+impl ExternalAuth for RequestSnapshotAuth {
+    fn is_request_bound(&self) -> bool {
+        true
+    }
+
+    fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async {
+            let _update =
+                self.update_lock.acquire().await.map_err(|_| {
+                    io::Error::other("ChatGPT auth helper request auth unavailable")
+                })?;
+            let current = self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("ChatGPT auth helper request auth unavailable"))?
+                .clone();
+            let helper = self
+                .authority
+                .auth_helper()
+                .ok_or_else(|| io::Error::other("ChatGPT auth helper authority is unavailable"))?;
+            let auth = helper.acquire(/*model*/ None, Some(&current)).await?;
+            *self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("ChatGPT auth helper request auth unavailable"))? =
+                auth.clone();
+            Ok(auth)
+        })
+    }
+
+    fn refresh(&self, _context: ExternalAuthRefreshContext) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async {
+            let _update =
+                self.update_lock.acquire().await.map_err(|_| {
+                    io::Error::other("ChatGPT auth helper request auth unavailable")
+                })?;
+            let current = self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("ChatGPT auth helper request auth unavailable"))?
+                .clone();
+            let helper = self
+                .authority
+                .auth_helper()
+                .ok_or_else(|| io::Error::other("ChatGPT auth helper authority is unavailable"))?;
+            let auth = helper.refresh_snapshot(&current).await?;
+            *self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("ChatGPT auth helper request auth unavailable"))? =
+                auth.clone();
+            Ok(auth)
+        })
+    }
+}
+
+pub(super) struct SnapshotStorage(Mutex<Option<AuthDotJson>>);
+
+impl SnapshotStorage {
+    pub fn new(auth: AuthDotJson) -> Self {
+        Self(Mutex::new(Some(auth)))
+    }
+}
+
+impl std::fmt::Debug for SnapshotStorage {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("AuthHelperSnapshotStorage")
+            .finish_non_exhaustive()
+    }
+}
+
+impl AuthStorageBackend for SnapshotStorage {
+    fn load(&self) -> io::Result<Option<AuthDotJson>> {
+        Ok(self
+            .0
+            .lock()
+            .map_err(|_| io::Error::other("ChatGPT auth helper snapshot unavailable"))?
+            .clone())
+    }
+    fn save(&self, auth: &AuthDotJson) -> io::Result<()> {
+        if auth
+            .tokens
+            .as_ref()
+            .is_some_and(|tokens| !tokens.refresh_token.is_empty())
+        {
+            return Err(io::Error::other(
+                "ChatGPT auth helper snapshots cannot store refresh credentials",
+            ));
+        }
+        *self
+            .0
+            .lock()
+            .map_err(|_| io::Error::other("ChatGPT auth helper snapshot unavailable"))? =
+            Some(auth.clone());
+        Ok(())
+    }
+    fn delete(&self) -> io::Result<bool> {
+        Ok(self
+            .0
+            .lock()
+            .map_err(|_| io::Error::other("ChatGPT auth helper snapshot unavailable"))?
+            .take()
+            .is_some())
+    }
+}
+
+impl ChatgptAuthHelper {
+    pub fn new(argv: Vec<String>) -> io::Result<Self> {
+        if !argv
+            .first()
+            .is_some_and(|program| Path::new(program).is_absolute())
+        {
+            return Err(io::Error::other(
+                "chatgpt_auth_helper requires an absolute executable",
+            ));
+        }
+        Ok(Self {
+            argv,
+            auth: Mutex::new(HashMap::new()),
+        })
+    }
+
+    pub async fn rpc(&self, request: Value) -> io::Result<Value> {
+        self.rpc_with_messages(request, /*surface_any_error_message*/ false)
+            .await
+    }
+
+    /// Enrolls a fresh native login. A refusal surfaces the helper's own message.
+    pub async fn register(&self, auth: Value, select: bool) -> io::Result<AuthHelperRegistration> {
+        let response = self
+            .rpc_with_messages(
+                json!({"op": "register", "select": select, "auth": auth}),
+                /*surface_any_error_message*/ true,
+            )
+            .await?;
+        Ok(AuthHelperRegistration {
+            // Helpers predating the field always honored `select`.
+            selected: response["selected"].as_bool().unwrap_or(select),
+            notice: response["notice"].as_str().and_then(helper_display_text),
+        })
+    }
+
+    async fn rpc_with_messages(
+        &self,
+        mut request: Value,
+        surface_any_error_message: bool,
+    ) -> io::Result<Value> {
+        request["version"] = json!(1);
+        let input = serde_json::to_vec(&request)
+            .map_err(|_| io::Error::other("invalid ChatGPT auth helper request"))?;
+        if input.len() as u64 > MAX_MESSAGE_BYTES {
+            return Err(io::Error::other(
+                "ChatGPT auth helper request exceeds size limit",
+            ));
+        }
+        tokio::time::timeout(HELPER_TIMEOUT, async {
+            let mut command = Command::new(&self.argv[0]);
+            command
+                .args(&self.argv[1..])
+                .stdin(Stdio::piped())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null())
+                .kill_on_drop(true);
+            #[cfg(unix)]
+            command.process_group(0);
+            let mut child = command
+                .spawn()
+                .map_err(|_| io::Error::other("ChatGPT auth helper process could not start"))?;
+            #[cfg(unix)]
+            let mut process_group = child.id().map(HelperProcessGroup::new);
+            let mut stdin = child
+                .stdin
+                .take()
+                .ok_or_else(|| io::Error::other("ChatGPT auth helper process stdin unavailable"))?;
+            let stdout = child.stdout.take().ok_or_else(|| {
+                io::Error::other("ChatGPT auth helper process stdout unavailable")
+            })?;
+            let write = async move {
+                stdin.write_all(&input).await?;
+                drop(stdin);
+                Ok::<_, io::Error>(())
+            };
+            let read = async {
+                let mut bytes = Vec::new();
+                stdout
+                    .take(MAX_MESSAGE_BYTES + 1)
+                    .read_to_end(&mut bytes)
+                    .await?;
+                if bytes.len() as u64 > MAX_MESSAGE_BYTES {
+                    return Err(io::Error::other(
+                        "ChatGPT auth helper response exceeds size limit",
+                    ));
+                }
+                Ok::<_, io::Error>(bytes)
+            };
+            let (_, bytes) = tokio::try_join!(write, read)
+                .map_err(|_| io::Error::other("ChatGPT auth helper process I/O failed"))?;
+            let status = child
+                .wait()
+                .await
+                .map_err(|_| io::Error::other("ChatGPT auth helper process failed"))?;
+            #[cfg(unix)]
+            if let Some(group) = process_group.as_mut() {
+                group.disarm();
+            }
+            let response: Value = serde_json::from_slice(&bytes)
+                .map_err(|_| io::Error::other("invalid ChatGPT auth helper response"))?;
+            if response.get("version") != Some(&json!(1))
+                || response.get("ok") != Some(&json!(true))
+                || !status.success()
+            {
+                if response.get("version") == Some(&json!(1))
+                    && !surface_any_error_message
+                    && matches!(
+                        response["error"]["code"].as_str(),
+                        Some("signed_out" | "no_accounts")
+                    )
+                {
+                    return Err(io::Error::new(
+                        io::ErrorKind::NotFound,
+                        "ChatGPT auth helper is signed out; run codex login",
+                    ));
+                }
+                // Only the envelope message of a user-actionable error is echoed,
+                // never other helper-controlled codes, stdout or stderr.
+                if response.get("version") == Some(&json!(1))
+                    && (surface_any_error_message
+                        || response["error"]["code"].as_str() == Some("user_action_required"))
+                    && let Some(message) = response["error"]["message"]
+                        .as_str()
+                        .and_then(helper_display_text)
+                {
+                    return Err(io::Error::new(io::ErrorKind::PermissionDenied, message));
+                }
+                return Err(io::Error::other(
+                    "ChatGPT auth helper unavailable; check the configured chatgpt_auth_helper",
+                ));
+            }
+            Ok(response)
+        })
+        .await
+        .map_err(|_| io::Error::other("ChatGPT auth helper process timed out"))?
+    }
+
+    pub(super) async fn report(&self, request: Value) {
+        // Advisory reports never refresh credentials. Dropping a slow helper is
+        // safe and the next preflight can fetch an authoritative usage snapshot.
+        if !matches!(
+            tokio::time::timeout(OBSERVATION_TIMEOUT, self.rpc(request)).await,
+            Ok(Ok(_))
+        ) {
+            tracing::warn!("ChatGPT auth helper usage observation unavailable");
+        }
+    }
+
+    async fn request_auth(&self, request: Value) -> io::Result<CodexAuth> {
+        let response = self.rpc(request).await?;
+        let snapshot: AuthHelperSnapshot = serde_json::from_value(response["snapshot"].clone())
+            .map_err(|_| io::Error::other("invalid ChatGPT auth helper credential snapshot"))?;
+        if snapshot.identity.account_key.is_empty()
+            || snapshot.account_id.is_empty()
+            || snapshot.access_token.is_empty()
+            || snapshot.expires_at <= chrono::Utc::now().timestamp()
+        {
+            return Err(io::Error::other(
+                "ChatGPT auth helper returned unusable credentials",
+            ));
+        }
+        let mut cache = self
+            .auth
+            .lock()
+            .map_err(|_| io::Error::other("ChatGPT auth helper cache unavailable"))?;
+        let key = snapshot.identity.account_key.clone();
+        let auth = CodexAuth::from_auth_helper_snapshot(snapshot, cache.get(&key))?;
+        if cache.len() >= 32
+            && !cache.contains_key(&key)
+            && let Some(oldest) = cache.keys().next().cloned()
+        {
+            cache.remove(&oldest);
+        }
+        cache.insert(key, auth.clone());
+        Ok(auth)
+    }
+
+    /// Reuse a refresh already completed by this authority without doing I/O or
+    /// consulting its global selection. Old steps must never adopt a new epoch.
+    pub(super) fn latest_request_auth(&self, pinned: &CodexAuth) -> CodexAuth {
+        let Some(expected) = pinned.auth_helper_identity() else {
+            return pinned.clone();
+        };
+        self.auth
+            .lock()
+            .ok()
+            .and_then(|cache| cache.get(&expected.account_key).cloned())
+            .filter(|auth| {
+                auth.auth_helper_identity().is_some_and(|actual| {
+                    actual.account_key == expected.account_key
+                        && actual.selection_epoch == expected.selection_epoch
+                        && actual.credential_revision >= expected.credential_revision
+                }) && auth.get_account_id() == pinned.get_account_id()
+            })
+            .unwrap_or_else(|| pinned.clone())
+    }
+
+    pub async fn acquire(
+        &self,
+        model: Option<&str>,
+        pinned: Option<&CodexAuth>,
+    ) -> io::Result<CodexAuth> {
+        let mut request = json!({"op": "acquire", "model": model});
+        if let Some(identity) = pinned.and_then(CodexAuth::auth_helper_identity) {
+            request["account_key"] = json!(identity.account_key);
+            request["selection_epoch"] = json!(identity.selection_epoch);
+        }
+        let auth = self.request_auth(request).await?;
+        if let Some(expected) = pinned.and_then(CodexAuth::auth_helper_identity)
+            && !auth.auth_helper_identity().is_some_and(|actual| {
+                actual.account_key == expected.account_key
+                    && actual.selection_epoch == expected.selection_epoch
+            })
+        {
+            return Err(io::Error::other(
+                "ChatGPT auth helper changed a pinned request owner",
+            ));
+        }
+        Ok(auth)
+    }
+
+    pub async fn refresh_snapshot(&self, rejected: &CodexAuth) -> io::Result<CodexAuth> {
+        let identity = rejected
+            .auth_helper_identity()
+            .ok_or_else(|| io::Error::other("ChatGPT auth helper rejected snapshot missing"))?;
+        let auth = self
+            .request_auth(json!({
+                "op": "refresh", "account_key": identity.account_key,
+                "selection_epoch": identity.selection_epoch,
+                "rejected_revision": identity.credential_revision,
+            }))
+            .await?;
+        if !auth.auth_helper_identity().is_some_and(|actual| {
+            actual.account_key == identity.account_key
+                && actual.selection_epoch == identity.selection_epoch
+                && actual.credential_revision > identity.credential_revision
+        }) || auth.get_account_id() != rejected.get_account_id()
+        {
+            return Err(io::Error::other(
+                "ChatGPT auth helper returned an invalid refresh owner or revision",
+            ));
+        }
+        Ok(auth)
+    }
+}
+
+/// Partial response buckets cannot establish model headroom or a full reset
+/// bound. They can only confirm exhaustion for ordinary or exact-model quota.
+pub(super) fn confirms_exhaustion(limits: &RateLimitSnapshot, model: Option<&str>) -> bool {
+    let ordinary = limits.normal_model_slug.is_none()
+        && limits.limit_id.as_deref().is_none_or(|id| id == "codex");
+    let exact_model = model.is_some_and(|model| {
+        limits.normal_model_slug.as_deref() == Some(model)
+            || limits.limit_id.as_deref() == Some(model)
+            || limits.limit_name.as_deref() == Some(model)
+    });
+    if !ordinary && !exact_model {
+        return false;
+    }
+    limits.spend_control_reached == Some(true)
+        || [&limits.primary, &limits.secondary]
+            .into_iter()
+            .flatten()
+            .any(|window| {
+                window.used_percent.is_finite()
+                    && window.used_percent >= 100.0
+                    && window
+                        .resets_at
+                        .is_none_or(|reset| reset > chrono::Utc::now().timestamp())
+            })
+}
+
+impl ExternalAuth for ChatgptAuthHelper {
+    fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(self.acquire(/*model*/ None, /*pinned*/ None))
+    }
+
+    fn refresh(&self, _context: ExternalAuthRefreshContext) -> ExternalAuthFuture<'_, CodexAuth> {
+        // Shared-cache 401 recovery cannot safely identify the rejected request.
+        Box::pin(async {
+            Err(io::Error::other(
+                "ChatGPT auth helper refresh requires a request snapshot",
+            ))
+        })
+    }
+
+    fn auth_helper(&self) -> Option<&ChatgptAuthHelper> {
+        Some(self)
+    }
+}

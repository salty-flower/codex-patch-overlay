+
+    manager
+        .wait_for_remote_installed_plugin_sync(Duration::from_secs(10))
+        .await
+        .expect("startup reconcile should finish");
+    assert_eq!(
+        manager.build_remote_installed_plugin_marketplaces_from_cache(&[]),
+        Some(Vec::new())
+    );
+    server.verify().await;

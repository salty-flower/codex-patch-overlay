+/// Mark a claimed refresh as published, as a successful runtime publication does.
+fn publish(claim: Option<McpRefreshInvalidationGuard<'_>>) -> bool {
+    match claim {
+        Some(mut guard) => {
+            guard.published = true;
+            true
+        }
+        None => false,
+    }
+}
+
+fn publish_round(claim: PublicationClaim<'_>) -> PublicationClaim<'_> {
+    if let PublicationClaim::Claimed(mut guard) = claim {
+        guard.published = true;
+        return PublicationClaim::Claimed(guard);
+    }
+    claim
+}

+                        params: GetAccountCredentialNoticeParams {},
+                    },
+                ),
+            )
+            .await;
+            let notice = match result {
+                Ok(Ok(response)) => response.notice,
+                Ok(Err(_)) | Err(_) => {
+                    tracing::debug!("credential notice unavailable for the current account");
+                    None
+                }
+            };
+            app_event_tx.send(AppEvent::AccountCredentialNoticeLoaded { generation, notice });
+        });
+    }

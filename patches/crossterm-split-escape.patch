+    /// Advances over input, holding a trailing lone `ESC` for its ambiguity window.
+    ///
+    /// A read can end between an escape sequence's introducer and its body, as with a split
+    /// SGR mouse report. Emitting `Esc` at once would turn the body into typed text.
+    fn advance_with_escape_window(&mut self, buffer: &[u8], more: bool) {
+        self.advance(buffer, more || buffer.last() == Some(&b'\x1b'));
         if self.buffer.as_slice() == b"\x1b" {

+    #[test]
+    fn mouse_report_split_after_its_escape_is_parsed_as_one_event() {
+        let (mut source, mut writer) = source_with_input();
+        writer.write_all(b"\x1b").unwrap();
+        assert_eq!(source.try_read(Some(Duration::ZERO)).unwrap(), None);
+
+        writer.write_all(b"[<65;113;25M").unwrap();
+        assert!(matches!(
+            read_until_event(&mut source),
+            Some(InternalEvent::Event(Event::Mouse(_)))
+        ));
+        assert_eq!(source.try_read(Some(Duration::ZERO)).unwrap(), None);
+    }
+

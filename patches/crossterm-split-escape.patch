+        writer.write_all(b"\x1b").unwrap();
+        assert_eq!(source.try_read(Some(Duration::ZERO)).unwrap(), None);
+
+        assert_eq!(
+            read_until_event(&mut source),
+            Some(InternalEvent::Event(Event::Key(KeyCode::Esc.into())))
+        );
+    }

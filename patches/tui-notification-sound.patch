diff --git a/codex-rs/tui/src/notifications/sound.rs b/codex-rs/tui/src/notifications/sound.rs
new file mode 100644
index 0000000..63392c8
--- /dev/null
+++ b/codex-rs/tui/src/notifications/sound.rs
@@ -0,0 +1,481 @@
+use codex_config::types::TuiNotificationSoundConfig;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::time::Duration;
+use tokio::process::Child;
+use tokio::process::Command;
+use tokio::runtime::Handle;
+use tokio::sync::Semaphore;
+
+const SOUND_COMMAND_TIMEOUT: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct SoundCommand {
+    program: String,
+    args: Vec<String>,
+}
+
+static SOUND_SLOT: OnceLock<Arc<Semaphore>> = OnceLock::new();
+
+pub fn play_notification_sound(config: &TuiNotificationSoundConfig) {
+    let commands = sound_commands(config, |path| Path::new(path).exists());
+    if commands.is_empty() {
+        return;
+    }
+
+    let Ok(handle) = Handle::try_current() else {
+        tracing::debug!("skipping notification sound without a Tokio runtime");
+        return;
+    };
+    let slot = SOUND_SLOT
+        .get_or_init(|| Arc::new(Semaphore::new(1)))
+        .clone();
+    drop(spawn_sound_commands(
+        &handle,
+        commands,
+        slot,
+        SOUND_COMMAND_TIMEOUT,
+    ));
+}
+
+fn spawn_sound_commands(
+    handle: &Handle,
+    commands: Vec<SoundCommand>,
+    slot: Arc<Semaphore>,
+    timeout: Duration,
+) -> Option<tokio::task::JoinHandle<()>> {
+    // Drop overlapping notifications instead of queueing stale sounds.
+    let permit = slot.try_acquire_owned().ok()?;
+    Some(handle.spawn(async move {
+        let _permit = permit;
+        run_sound_commands(commands, timeout).await;
+    }))
+}
+
+async fn run_sound_commands(commands: Vec<SoundCommand>, timeout: Duration) {
+    for command in commands {
+        let mut process = Command::new(command.program);
+        process
+            .args(command.args)
+            .stdin(std::process::Stdio::null())
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .kill_on_drop(true);
+
+        let mut child = match process.spawn() {
+            Ok(child) => child,
+            Err(error) => {
+                tracing::debug!(%error, "failed to spawn notification sound command");
+                continue;
+            }
+        };
+
+        wait_for_sound_command(&mut child, timeout).await;
+        // Preserve the fallback contract: only a spawn failure tries the next command.
+        return;
+    }
+}
+
+async fn wait_for_sound_command(child: &mut Child, timeout: Duration) {
+    match tokio::time::timeout(timeout, child.wait()).await {
+        Ok(Ok(_)) => {}
+        Ok(Err(error)) => {
+            tracing::debug!(%error, "failed to wait for notification sound command");
+            kill_and_reap(child).await;
+        }
+        Err(_) => kill_and_reap(child).await,
+    }
+}
+
+async fn kill_and_reap(child: &mut Child) {
+    if let Err(error) = child.start_kill() {
+        tracing::debug!(%error, "failed to kill notification sound command");
+    }
+    if let Err(error) = child.wait().await {
+        tracing::debug!(%error, "failed to reap notification sound command");
+    }
+}
+
+fn sound_commands(
+    config: &TuiNotificationSoundConfig,
+    path_exists: impl Fn(&str) -> bool,
+) -> Vec<SoundCommand> {
+    if !config.enabled {
+        return Vec::new();
+    }
+
+    if let Some(command) = &config.command {
+        return configured_sound_command(command).into_iter().collect();
+    }
+
+    sound_commands_for_platform(path_exists)
+}
+
+fn configured_sound_command(command: &[String]) -> Option<SoundCommand> {
+    let (program, args) = command.split_first()?;
+    Some(SoundCommand {
+        program: program.clone(),
+        args: args.to_vec(),
+    })
+}
+
+#[cfg(any(target_os = "macos", target_os = "linux"))]
+fn sound_commands_for_platform(path_exists: impl Fn(&str) -> bool) -> Vec<SoundCommand> {
+    let mut commands = Vec::new();
+
+    #[cfg(target_os = "macos")]
+    {
+        const GLASS_SOUND: &str = "/System/Library/Sounds/Glass.aiff";
+
+        if path_exists(GLASS_SOUND) {
+            commands.push(SoundCommand {
+                program: "afplay".to_string(),
+                args: vec![GLASS_SOUND.to_string()],
+            });
+        }
+        commands.push(SoundCommand {
+            program: "osascript".to_string(),
+            args: vec!["-e".to_string(), "beep".to_string()],
+        });
+    }
+
+    #[cfg(target_os = "linux")]
+    {
+        const FREEDESKTOP_SOUND: &str = "/usr/share/sounds/freedesktop/stereo/complete.oga";
+        const ALSA_SOUND: &str = "/usr/share/sounds/alsa/Front_Center.wav";
+
+        commands.push(SoundCommand {
+            program: "canberra-gtk-play".to_string(),
+            args: vec!["-i".to_string(), "bell".to_string()],
+        });
+
+        if path_exists(FREEDESKTOP_SOUND) {
+            commands.push(SoundCommand {
+                program: "paplay".to_string(),
+                args: vec![FREEDESKTOP_SOUND.to_string()],
+            });
+            commands.push(SoundCommand {
+                program: "pw-play".to_string(),
+                args: vec![FREEDESKTOP_SOUND.to_string()],
+            });
+        }
+
+        if path_exists(ALSA_SOUND) {
+            commands.push(SoundCommand {
+                program: "aplay".to_string(),
+                args: vec![ALSA_SOUND.to_string()],
+            });
+        }
+    }
+
+    commands
+}
+
+#[cfg(not(any(target_os = "macos", target_os = "linux")))]
+fn sound_commands_for_platform(_path_exists: impl Fn(&str) -> bool) -> Vec<SoundCommand> {
+    Vec::new()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::SoundCommand;
+    #[cfg(unix)]
+    use super::run_sound_commands;
+    use super::sound_commands;
+    #[cfg(any(target_os = "macos", target_os = "linux"))]
+    use super::sound_commands_for_platform;
+    use codex_config::types::TuiNotificationSoundConfig;
+
+    fn command(program: &str, args: &[&str]) -> SoundCommand {
+        SoundCommand {
+            program: program.to_string(),
+            args: args.iter().map(ToString::to_string).collect(),
+        }
+    }
+

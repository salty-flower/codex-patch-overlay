index 000000000..cec4ee744
--- /dev/null
+++ b/codex-rs/tui/src/notifications/sound.rs
@@ -0,0 +1,197 @@
+use codex_config::types::TuiNotificationSoundConfig;
+use std::path::Path;
+use std::process::Command;
+use std::process::Stdio;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct SoundCommand {
+    program: String,
+    args: Vec<String>,
+}
+
+pub fn play_notification_sound(config: &TuiNotificationSoundConfig) {
+    for command in sound_commands(config, |path| Path::new(path).exists()) {
+        if spawn_sound_command(command) {
+            return;
+        }
+    }
+}
+
+fn spawn_sound_command(command: SoundCommand) -> bool {
+    Command::new(command.program)
+        .args(command.args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .is_ok()
+}
+
+fn sound_commands(
+    config: &TuiNotificationSoundConfig,
+    path_exists: impl Fn(&str) -> bool,
+) -> Vec<SoundCommand> {
+    if !config.enabled {
+        return Vec::new();
+    }
+
+    if let Some(command) = &config.command {
+        return configured_sound_command(command).into_iter().collect();
+    }
+
+    sound_commands_for_platform(path_exists)
+}
+
+fn configured_sound_command(command: &[String]) -> Option<SoundCommand> {
+    let (program, args) = command.split_first()?;
+    Some(SoundCommand {
+        program: program.clone(),
+        args: args.to_vec(),
+    })
+}
+
+fn sound_commands_for_platform(path_exists: impl Fn(&str) -> bool) -> Vec<SoundCommand> {
+    let mut commands = Vec::new();
+
+    #[cfg(target_os = "macos")]
+    {
+        const GLASS_SOUND: &str = "/System/Library/Sounds/Glass.aiff";
+
+        if path_exists(GLASS_SOUND) {
+            commands.push(SoundCommand {
+                program: "afplay".to_string(),
+                args: vec![GLASS_SOUND.to_string()],
+            });
+        }
+        commands.push(SoundCommand {
+            program: "osascript".to_string(),
+            args: vec!["-e".to_string(), "beep".to_string()],
+        });
+    }
+
+    #[cfg(target_os = "linux")]
+    {
+        const FREEDESKTOP_SOUND: &str = "/usr/share/sounds/freedesktop/stereo/complete.oga";
+        const ALSA_SOUND: &str = "/usr/share/sounds/alsa/Front_Center.wav";
+
+        commands.push(SoundCommand {
+            program: "canberra-gtk-play".to_string(),
+            args: vec!["-i".to_string(), "bell".to_string()],
+        });
+
+        if path_exists(FREEDESKTOP_SOUND) {
+            commands.push(SoundCommand {
+                program: "paplay".to_string(),
+                args: vec![FREEDESKTOP_SOUND.to_string()],
+            });
+            commands.push(SoundCommand {
+                program: "pw-play".to_string(),
+                args: vec![FREEDESKTOP_SOUND.to_string()],
+            });
+        }
+
+        if path_exists(ALSA_SOUND) {
+            commands.push(SoundCommand {
+                program: "aplay".to_string(),
+                args: vec![ALSA_SOUND.to_string()],
+            });
+        }
+    }
+
+    commands
+}
+
+#[cfg(test)]
+mod tests {
+    use super::SoundCommand;
+    use super::sound_commands;
+    use super::sound_commands_for_platform;
+    use codex_config::types::TuiNotificationSoundConfig;
+
+    fn command(program: &str, args: &[&str]) -> SoundCommand {
+        SoundCommand {
+            program: program.to_string(),
+            args: args.iter().map(ToString::to_string).collect(),
+        }
+    }
+
+    #[test]
+    fn configured_command_replaces_platform_defaults() {
+        let config = TuiNotificationSoundConfig {
+            enabled: true,
+            command: Some(vec![
+                "afplay".to_string(),
+                "/tmp/codex-done.aiff".to_string(),
+            ]),
+        };
+
+        assert_eq!(
+            sound_commands(&config, |_| true),
+            vec![command("afplay", &["/tmp/codex-done.aiff"])]
+        );
+    }
+
+    #[test]
+    fn disabled_config_has_no_commands() {
+        let config = TuiNotificationSoundConfig {
+            enabled: false,
+            command: None,
+        };
+
+        assert_eq!(sound_commands(&config, |_| true), Vec::new());
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn macos_prefers_system_sound_before_osascript_beep() {
+        assert_eq!(
+            sound_commands_for_platform(|path| path == "/System/Library/Sounds/Glass.aiff"),
+            vec![
+                command("afplay", &["/System/Library/Sounds/Glass.aiff"]),
+                command("osascript", &["-e", "beep"]),
+            ]
+        );
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn macos_falls_back_to_osascript_beep() {
+        assert_eq!(
+            sound_commands_for_platform(|_| false),
+            vec![command("osascript", &["-e", "beep"])]
+        );
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn linux_prefers_canberra_before_file_based_players() {
+        assert_eq!(
+            sound_commands_for_platform(|path| {
+                path == "/usr/share/sounds/freedesktop/stereo/complete.oga"
+            }),
+            vec![
+                command("canberra-gtk-play", &["-i", "bell"]),
+                command(
+                    "paplay",
+                    &["/usr/share/sounds/freedesktop/stereo/complete.oga"]
+                ),
+                command(
+                    "pw-play",
+                    &["/usr/share/sounds/freedesktop/stereo/complete.oga"]
+                ),
+            ]
+        );
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn linux_falls_back_to_alsa_front_center_sound() {
+        assert_eq!(
+            sound_commands_for_platform(|path| path == "/usr/share/sounds/alsa/Front_Center.wav"),
+            vec![
+                command("canberra-gtk-play", &["-i", "bell"]),
+                command("aplay", &["/usr/share/sounds/alsa/Front_Center.wav"]),
+            ]
+        );
+    }
+}

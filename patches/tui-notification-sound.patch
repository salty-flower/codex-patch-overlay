+
+    #[cfg(unix)]
+    fn helper(temp: &tempfile::TempDir) -> std::path::PathBuf {
+        use std::fs;
+        use std::os::unix::fs::PermissionsExt;
+
+        let path = temp.path().join("sound-helper");
+        fs::write(
+            &path,
+            r#"#!/bin/sh
+printf '%s\n' "$$" > "$2.$1.pid"
+printf '%s\n' "$1" >> "$2"
+case "$1" in
+  fail) exit 7 ;;
+  hang) exec sleep 30 ;;
+  argv) printf '%s\n' "$3" "$4" "$5" >> "$2" ;;
+esac
+"#,
+        )
+        .unwrap();
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o755)).unwrap();
+        path
+    }
+
+    /// The helper records its pid next to the log it was given, so the caller
+    /// must name that log rather than assuming a shared one.
+    #[cfg(unix)]
+    fn assert_reaped(log: &std::path::Path, mode: &str) {
+        let pid: libc::pid_t = std::fs::read_to_string(format!("{}.{mode}.pid", log.display()))
+            .unwrap()
+            .trim()
+            .parse()
+            .unwrap();
+        let mut status = 0;
+        assert_eq!(
+            unsafe { libc::waitpid(pid, &mut status, libc::WNOHANG) },
+            -1
+        );
+        assert_eq!(
+            std::io::Error::last_os_error().raw_os_error(),
+            Some(libc::ECHILD)
+        );
+    }
+
+    #[cfg(unix)]
+    async fn wait_for_helper(log: &std::path::Path) {
+        tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            while !log.exists() {
+                tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+            }
+        })
+        .await
+        .expect("sound helper did not start");
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn direct_argv_is_literal_and_spawned_failure_suppresses_fallback() {
+        let temp = tempfile::tempdir().unwrap();
+        let helper = helper(&temp);
+        let log = temp.path().join("log");
+        let config = TuiNotificationSoundConfig {
+            enabled: true,
+            command: Some(vec![
+                helper.to_str().unwrap().to_string(),
+                "argv".to_string(),
+                log.to_str().unwrap().to_string(),
+                "a sound file; with spaces".to_string(),
+                "$(printf expanded) $HOME *".to_string(),
+                String::new(),
+            ]),
+        };
+        run_sound_commands(
+            sound_commands(&config, |_| true),
+            std::time::Duration::from_secs(1),
+        )
+        .await;
+        assert_eq!(
+            std::fs::read_to_string(log).unwrap(),
+            "argv\na sound file; with spaces\n$(printf expanded) $HOME *\n\n"
+        );
+        assert_reaped(&log, "argv");
+
+        let fallback_log = temp.path().join("fallback-log");
+        run_sound_commands(
+            vec![
+                command(
+                    helper.to_str().unwrap(),
+                    &["fail", fallback_log.to_str().unwrap()],
+                ),
+                command(
+                    helper.to_str().unwrap(),
+                    &["argv", fallback_log.to_str().unwrap(), "unexpected"],
+                ),
+            ],
+            std::time::Duration::from_secs(1),
+        )
+        .await;
+        assert_eq!(std::fs::read_to_string(fallback_log).unwrap(), "fail\n");
+        assert_reaped(&fallback_log, "fail");
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn missing_command_uses_fallback() {
+        let temp = tempfile::tempdir().unwrap();
+        let helper = helper(&temp);
+        let log = temp.path().join("log");
+        run_sound_commands(
+            vec![
+                command(temp.path().join("missing").to_str().unwrap(), &[]),
+                command(
+                    helper.to_str().unwrap(),
+                    &["fallback", log.to_str().unwrap()],
+                ),
+            ],
+            std::time::Duration::from_secs(1),
+        )
+        .await;
+
+        assert_eq!(std::fs::read_to_string(log).unwrap(), "fallback\n");
+        assert_reaped(&log, "fallback");
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn hanging_command_is_killed_and_reaped() {
+        let temp = tempfile::tempdir().unwrap();
+        let helper = helper(&temp);
+        let log = temp.path().join("log");
+        tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            run_sound_commands(
+                vec![command(
+                    helper.to_str().unwrap(),
+                    &["hang", log.to_str().unwrap()],
+                )],
+                std::time::Duration::from_millis(250),
+            ),
+        )
+        .await
+        .expect("sound command exceeded its bound");
+
+        assert_eq!(std::fs::read_to_string(log).unwrap(), "hang\n");
+        assert_reaped(&log, "hang");
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn overlap_is_dropped_until_the_first_command_is_reaped() {
+        let temp = tempfile::tempdir().unwrap();
+        let helper = helper(&temp);
+        let log = temp.path().join("log");
+        let slot = std::sync::Arc::new(tokio::sync::Semaphore::new(1));
+        let handle = tokio::runtime::Handle::current();
+        let first = super::spawn_sound_commands(
+            &handle,
+            vec![command(
+                helper.to_str().unwrap(),
+                &["hang", log.to_str().unwrap()],
+            )],
+            slot.clone(),
+            std::time::Duration::from_secs(1),
+        )
+        .unwrap();
+        wait_for_helper(&log).await;
+        assert!(
+            super::spawn_sound_commands(
+                &handle,
+                vec![command(
+                    helper.to_str().unwrap(),
+                    &["overlap", log.to_str().unwrap()]
+                )],
+                slot.clone(),
+                std::time::Duration::from_secs(1),
+            )
+            .is_none()
+        );
+        first.await.unwrap();
+        assert_reaped(&log, "hang");
+
+        let next = super::spawn_sound_commands(
+            &handle,
+            vec![command(
+                helper.to_str().unwrap(),
+                &["next", log.to_str().unwrap()],
+            )],
+            slot,
+            std::time::Duration::from_secs(1),
+        )
+        .expect("reaping must release the sound slot");
+        next.await.unwrap();
+        assert_eq!(std::fs::read_to_string(log).unwrap(), "hang\nnext\n");
+        assert_reaped(&log, "next");
+    }
+

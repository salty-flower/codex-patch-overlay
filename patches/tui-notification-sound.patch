+#[test]
+fn test_tui_notification_sound_command() {
+    let toml = r#"
+            [tui]
+            notification_sound = { command = ["afplay", "/tmp/codex-done.aiff"] }
+        "#;
+    let parsed = toml::from_str::<ConfigToml>(toml)
+        .expect("deserialize configurable notification sound command");
+    let sound = parsed.tui.expect("tui config").notification_settings.sound;
+
+    assert_eq!(sound.enabled, true);
+    assert_eq!(
+        sound.command,
+        Some(vec![
+            "afplay".to_string(),
+            "/tmp/codex-done.aiff".to_string()
+        ])
+    );
+}
+
+#[test]
+fn test_tui_notification_sound_disabled() {
+    let toml = r#"
+            [tui]
+            notification_sound = { enabled = false }
+        "#;
+    let parsed =
+        toml::from_str::<ConfigToml>(toml).expect("deserialize disabled notification sound");
+    let sound = parsed.tui.expect("tui config").notification_settings.sound;
+
+    assert_eq!(sound.enabled, false);
+    assert_eq!(sound.command, None);
+}

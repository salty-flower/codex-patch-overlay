+async fn delete_rollout_file_by_thread_id(
+    codex_home: &std::path::Path,
+    thread_id: ThreadId,
+    state_db: Option<&codex_state::StateRuntime>,
+) -> std::io::Result<bool> {
+    let thread_id_str = thread_id.to_string();
+    let active_path =
+        codex_rollout::find_thread_path_by_id_str(codex_home, &thread_id_str, state_db).await?;
+    let path = match active_path {
+        Some(path) => Some(path),
+        None => {
+            codex_rollout::find_archived_thread_path_by_id_str(codex_home, &thread_id_str, state_db)
+                .await?
+        }
+    };
+
+    let Some(path) = path else {
+        return Ok(false);
+    };
+
+    tokio::fs::remove_file(path.as_path()).await?;
+    Ok(true)
+}

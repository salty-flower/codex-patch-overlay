+    async fn thread_delete_inner(
+        &self,
+        params: ThreadDeleteParams,
+    ) -> Result<ThreadDeleteResponse, JSONRPCErrorError> {
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid session id: {err}")))?;
+
+        // Shut down the thread if it is currently running.
+        self.prepare_thread_for_archive(thread_id).await;
+
+        // Delete from state DB (threads table + associated memories + goals).
+        let mut delete_error = None;
+        let mut deleted_rows = 0;
+        if let Some(state_db) = self.state_db.as_ref() {
+            match state_db.delete_thread(thread_id).await {
+                Ok(rows) => {
+                    deleted_rows = rows;
+                }
+                Err(err) => {
+                    warn!("failed to delete session {thread_id} from state db: {err}");
+                    delete_error = Some(err);
+                }
+            }
+        }
+
+        let rollout_deleted = delete_rollout_file_by_thread_id(
+            self.config.codex_home.as_path(),
+            thread_id,
+            self.state_db.as_deref(),
+        )
+        .await
+        .map_err(|err| {
+            internal_error(format!(
+                "failed to remove rollout file for session {thread_id}: {err}"
+            ))
+        })?;
+
+        if !rollout_deleted && deleted_rows == 0 {
+            if let Some(err) = delete_error {
+                return Err(internal_error(format!(
+                    "failed to delete session {thread_id}: {err}"
+                )));
+            }
+            return Err(invalid_request(format!("session {thread_id} not found")));
+        }
+
+        Ok(ThreadDeleteResponse {})
+    }

+    async fn thread_delete_inner(
+        &self,
+        params: ThreadDeleteParams,
+    ) -> Result<ThreadDeleteResponse, JSONRPCErrorError> {
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid session id: {err}")))?;
+
+        // Look up the rollout path before deleting from state DB.
+        let rollout_path = if let Some(state_db) = self.state_db.as_ref() {
+            state_db
+                .get_thread(thread_id)
+                .await
+                .ok()
+                .flatten()
+                .map(|m| m.rollout_path)
+        } else {
+            None
+        };
+
+        // Shut down the thread if it is currently running.
+        self.prepare_thread_for_archive(thread_id).await;
+
+        // Delete from state DB (threads table + associated memories + goals).
+        if let Some(state_db) = self.state_db.as_ref() {
+            let rows = state_db
+                .delete_thread(thread_id)
+                .await
+                .map_err(|err| internal_error(format!("failed to delete session {thread_id}: {err}")))?;
+            if rows == 0 {
+                return Err(invalid_request(format!("session {thread_id} not found")));
+            }
+        }
+
+        // Remove the on-disk rollout file.
+        if let Some(path) = rollout_path.as_ref() {
+            if let Err(err) = tokio::fs::remove_file(path).await {
+                warn!("failed to remove rollout file {path}: {err}");
+            }
+        }
+
+        Ok(ThreadDeleteResponse {})
+    }

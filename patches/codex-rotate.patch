+/// Publications allowed before an in-gate refresh pauses to let a
+/// self-invalidating publisher settle.
+const PUBLICATIONS_PER_ROUND: usize = 2;
+/// Rounds of publications plus backoff before a refresh reports failure.
+const PUBLICATION_ROUNDS: usize = 3;
+/// Pause between rounds. Bounded, so a wedged publisher cannot hold the gate.
+pub(super) const PUBLICATION_BACKOFF: Duration = Duration::from_millis(/*millis*/ 50);
+
+/// How the next in-gate publication attempt should proceed.
+pub(super) enum PublicationClaim {
+    /// Publish now.
+    Claimed,
+    /// Nothing is pending; the refresh is already up to date.
+    Idle,
+    /// This round is spent while work is still pending; pause and start a
+    /// fresh round.
+    Pause,
+    /// Every round is spent and work is still pending.
+    Exhausted,
+}

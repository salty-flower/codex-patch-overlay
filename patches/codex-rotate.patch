+use super::*;
+use codex_config::Sourced;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn personal_step_revalidates_current_workspace_and_login_requirements() {
+    let (_, turn) = super::super::tests::make_session_and_context().await;
+    let mut config = (*turn.config).clone();
+    let auth =
+        CodexAuth::from_external_chatgpt_tokens("header.e30.synthetic", "account-b", Some("pro"))
+            .expect("personal test auth");
+    assert!(validate_personal_step(&config, &auth).is_ok());
+    config.forced_chatgpt_workspace_id = Some(vec!["account-a".into()]);
+    assert!(validate_personal_step(&config, &auth).is_err());
+    config.forced_chatgpt_workspace_id = Some(vec!["account-b".into()]);
+    assert!(validate_personal_step(&config, &auth).is_ok());
+    config.forced_login_method = Some(ForcedLoginMethod::Api);
+    assert!(validate_personal_step(&config, &auth).is_err());
+}
+
+#[test]
+fn requirement_only_and_composite_cloud_bundles_fail_closed() {
+    let mut requirements = ConfigRequirements::default();
+    assert_eq!(has_cloud_requirements(&requirements), false);
+    requirements.allowed_login_methods = Some(Sourced::new(
+        vec![ForcedLoginMethod::Chatgpt],
+        RequirementSource::Composite {
+            sources: vec![
+                RequirementSource::Unknown,
+                RequirementSource::EnterpriseManaged {
+                    id: "policy".into(),
+                    name: "managed workspace".into(),
+                },
+            ],
+        },
+    ));
+    assert_eq!(has_cloud_requirements(&requirements), true);
+}

+    let mut other_epoch = snapshot("account-a", 3);
+    other_epoch["selection_epoch"] = json!(8);
+    authority.auth.lock().unwrap().insert(
+        "account-a".into(),
+        CodexAuth::from_rotate_snapshot(serde_json::from_value(other_epoch).unwrap(), None)

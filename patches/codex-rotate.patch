 /// Restores a claimed refresh when its task is cancelled before publication.
 pub(super) struct McpRefreshInvalidationGuard<'a> {
     pub(super) refresh: &'a McpRefresh,
@@ -54,3 +124,65 @@ impl Drop for McpRefreshInvalidationGuard<'_> {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn self_invalidating_refresh_yields_gate_without_losing_dirty_state() {
+        let refresh = McpRefresh::new();
+        let gate = refresh.acquire().await.unwrap();
+        let mut budget = 2;
+        for _ in 0..2 {
+            refresh.invalidate();
+            assert_eq!(refresh.claim_with_budget(&mut budget), Ok(true));
+        }
+        refresh.invalidate();
+        assert_eq!(refresh.claim_with_budget(&mut budget), Err(()));
+        assert!(refresh.is_pending());
+        drop(gate);
+        let _next_gate = refresh.acquire().await.unwrap();
+        let mut next_budget = 2;
+        assert_eq!(refresh.claim_with_budget(&mut next_budget), Ok(true));
+        assert_eq!(refresh.claim_with_budget(&mut next_budget), Ok(false));
+    }
+
+    #[test]
+    fn a_spent_round_pauses_then_a_fresh_round_claims_again() {
+        let refresh = McpRefresh::new();
+        let mut rounds = PublicationRounds::new();
+        for _ in 0..PUBLICATIONS_PER_ROUND {
+            refresh.invalidate();
+            assert!(matches!(rounds.claim(&refresh), PublicationClaim::Claimed));
+        }
+        refresh.invalidate();
+        assert!(matches!(rounds.claim(&refresh), PublicationClaim::Pause));
+        assert!(refresh.is_pending());
+        // The pause is what makes the next publication possible at all.
+        assert!(matches!(rounds.claim(&refresh), PublicationClaim::Claimed));
+        assert!(!refresh.is_pending());
+        assert!(matches!(rounds.claim(&refresh), PublicationClaim::Idle));
+    }
+
+    #[test]
+    fn exhausted_rounds_stop_retrying_with_work_still_pending() {
+        let refresh = McpRefresh::new();
+        let mut rounds = PublicationRounds::new();
+        let mut pauses = 0;
+        loop {
+            refresh.invalidate();
+            match rounds.claim(&refresh) {
+                PublicationClaim::Claimed => continue,
+                PublicationClaim::Pause => {
+                    pauses += 1;
+                    assert!(pauses < PUBLICATION_ROUNDS);
+                }
+                PublicationClaim::Exhausted => break,
+                PublicationClaim::Idle => panic!("pending work must never report idle"),
+            }
+        }
+        assert_eq!(pauses, PUBLICATION_ROUNDS - 1);
+        assert!(refresh.is_pending());
+    }
+}

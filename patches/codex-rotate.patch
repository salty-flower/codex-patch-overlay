+
+async fn assert_account_with_workspace(
+    app: &mut TestAppServer,
+    account: Account,
+    workspace_chatgpt_account_id: Option<&str>,
+) -> Result<()> {
+    let request = app
+        .send_get_account_request(GetAccountParams {
+            refresh_token: false,
+        })
+        .await?;
+    let response: GetAccountResponse = timeout(READ_TIMEOUT, app.read_response(request)).await??;
+    assert_eq!(
+        matches!(&account, Account::Chatgpt { .. }),
+        workspace_chatgpt_account_id.is_some()
+    );
+    assert_eq!(
+        response,
+        GetAccountResponse {
+            workspace_routing: workspace_chatgpt_account_id.map(|chatgpt_account_id| {
+                codex_app_server_protocol::WorkspaceRouting {
+                    chatgpt_account_id: chatgpt_account_id.to_string(),
+                    backend_origin: "https://chatgpt.com".to_string(),
+                    account_routing_override:
+                        codex_app_server_protocol::AccountRoutingOverride::NoConstraint,
+                }
+            }),
+            account: Some(account),
+            requires_openai_auth: true

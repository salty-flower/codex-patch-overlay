+//! Offline request-boundary regression using the real helper and plugin paths.
+
+use anyhow::Result;
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use codex_config::McpServerTransportConfig;
+use codex_core::TurnInputRequest;

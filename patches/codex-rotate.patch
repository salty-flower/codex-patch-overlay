+    /// Resolves a first-party request from one immutable credential snapshot.
+    /// Non-rotation providers retain their existing customized auth and routing.
+    fn rotate_request_setup<'a>(
+        &'a self,
+        model: Option<&'a str>,
+        pinned: Option<&'a CodexAuth>,
+        scope: ProviderAuthScope,
+    ) -> ModelProviderFuture<
+        'a,
+        codex_protocol::error::Result<Option<(CodexAuth, Provider, ResolvedProviderAuth)>>,
+    > {
+        Box::pin(async move {
+            if !provider_uses_first_party_auth_path(self.info()) {
+                return Ok(None);
+            }
+            let Some(manager) = self.auth_manager() else {
+                return Ok(None);
+            };
+            if !manager.has_rotate_helper() {
+                return Ok(None);
+            }
+            let auth = manager
+                .auth_for_request(model, pinned)
+                .await?
+                .ok_or_else(|| {
+                    CodexErr::InvalidRequest("Codex Rotate is signed out".to_string())
+                })?;
+            let mut provider = self.info().to_api_provider(Some(auth.auth_mode()))?;
+            enforce_managed_residency(&mut provider);
+            let resolved =
+                resolve_provider_auth_for_scope(Some(manager), Some(&auth), self.info(), scope)
+                    .await?;
+            Ok(Some((auth, provider, resolved)))
+        })
+    }

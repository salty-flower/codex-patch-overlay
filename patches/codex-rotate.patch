+fn save_api_key(codex_home: &Path) -> Result<()> {
+    login_with_api_key(
+        codex_home,
+        "sk-synthetic",
+        AuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::default(),
+    )?;
+    Ok(())
+}
+
+async fn start_app(
+    codex_home: &Path,
+    server: &MockServer,
+    with_auto_env: bool,
+) -> Result<TestAppServer> {
+    mount_workspace_routing(server).await;
+    mount_models_catalog(server).await?;
+    mount_empty_plugin_catalog(server).await;
+    let issuer = server.uri();
+    let revoke_endpoint = format!("{issuer}/oauth/revoke");
+    let builder = TestAppServer::builder().with_codex_home(codex_home);
+    let builder = if with_auto_env {
+        builder
+    } else {
+        builder.without_auto_env()
+    };
+    builder
+        .with_env_overrides(&[
+            ("OPENAI_API_KEY", None),
+            ("CODEX_APP_SERVER_LOGIN_ISSUER", Some(issuer.as_str())),
+            (
+                "CODEX_REVOKE_TOKEN_URL_OVERRIDE",
+                Some(revoke_endpoint.as_str()),
+            ),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await
+}

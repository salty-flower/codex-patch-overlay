+#[tokio::test]
+async fn reload_of_a_rotated_rotate_snapshot_publishes_an_auth_change() {
+    let dir = tempfile::tempdir().unwrap();
+    let mut rotated = snapshot("account-a", 2);
+    rotated["access_token"] = json!("rotated-access");
+    let manager = super::super::manager::AuthManager::from_auth_for_testing(auth("account-a", 1));
+    manager
+        .set_external_auth(Arc::new(helper_then(
+            &dir,
+            json!({"version": 1, "ok": true, "snapshot": snapshot("account-a", 1)}),
+            json!({"version": 1, "ok": true, "snapshot": rotated}),
+        )))
+        .await
+        .unwrap();
+    let mut changes = manager.auth_change_receiver();
+    changes.borrow_and_update();
+    // The helper now answers with the rotated snapshot: a real account
+    // rotation, not a repeated fetch of the same one.
+    manager.reload().await;
+    assert!(
+        changes.has_changed().unwrap(),
+        "a rotated credential must publish so websocket, MCP and otel consumers rebuild"
+    );
+}

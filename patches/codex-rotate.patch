index 0000000000..65d16fcbdb
--- /dev/null
+++ b/codex-rs/core/tests/suite/rotate_plugin_install.rs
@@ -0,0 +1,194 @@
+//! Exercise account changes across real spawned tool dispatch and install approval.
+
+use anyhow::Result;
+use codex_features::Feature;
+use codex_login::CodexAuth;
+use codex_protocol::approvals::ElicitationAction;
+use codex_protocol::models::PermissionProfile;
+use core_test_support::apps_test_server::AppsTestServer;
+use core_test_support::responses;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use wiremock::Mock;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+use super::request_plugin_install::configure_apps_without_search_tool;
+use super::request_plugin_install::resolve_install_elicitation;
+use super::request_plugin_install::start_install_turn;
+use super::rotate_step::helper_for_profiles;
+use super::rotate_step::select_account;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn rotate_plugin_install_retains_owner_through_dispatch_and_approval() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let tools_available = Arc::new(AtomicBool::new(false));
+    let apps =
+        AppsTestServer::mount_with_tools_available_when(&server, Arc::clone(&tools_available))
+            .await?;
+    let fixture = tempfile::tempdir()?;
+    let selection = fixture.path().join("selected.json");
+    for (account, epoch) in [("account-a", 1), ("account-b", 2), ("account-c", 3)] {
+        select_account(
+            &fixture.path().join(format!("{account}.json")),
+            account,
+            epoch,
+        )?;
+    }
+    select_account(&selection, "account-a", 1)?;
+    Mock::given(method("GET"))
+        .and(path("/ps/plugins/suggested/codex"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "enabled": true,
+            "plugins": [{"id": "plugin_calendar", "name": "calendar", "display_name": "Calendar"}]
+        })))
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path("/ps/plugins/plugin_calendar"))
+        .respond_with(move |request: &wiremock::Request| {
+            // A's recommendation is deliberately unavailable to other accounts.
+            // This catches a handler that reacquires global B after dispatch.
+            let status = if request
+                .headers
+                .get("chatgpt-account-id")
+                .and_then(|value| value.to_str().ok())
+                == Some("account-a")
+            {
+                "ENABLED"
+            } else {
+                "DISABLED_BY_ADMIN"
+            };
+            ResponseTemplate::new(200).set_body_json(json!({
+                "id": "plugin_calendar", "name": "calendar", "scope": "GLOBAL", "status": status,
+                "installation_policy": "AVAILABLE", "authentication_policy": "ON_USE",
+                "release": {"display_name": "Calendar", "description": "Manage calendar events.",
+                    "app_ids": ["calendar"], "interface": {}}
+            }))
+        })
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path("/ps/plugins/installed"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "plugins": [], "pagination": {"next_page_token": null}
+        })))
+        .mount(&server)
+        .await;
+    let during_response = selection.clone();
+    let initial_request =
+        responses::mount_sse_once_match(
+            &server,
+            move |_: &wiremock::Request| {
+                // Credentials for A have already been sent; the tool is not dispatched yet.
+                select_account(&during_response, "account-b", 2).expect("select B");
+                true
+            },
+            responses::sse(vec![
+            responses::ev_response_created("response-a"),
+            responses::ev_function_call("install-calendar", "request_plugin_install", &json!({
+                "plugin_id": "calendar@openai-curated-remote", "suggest_reason": "Use Calendar"
+            }).to_string()),
+            responses::ev_completed("response-a"),
+        ]),
+        )
+        .await;
+    let mut builder = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_config(move |config| {
+            configure_apps_without_search_tool(config, &apps.chatgpt_base_url);
+            config
+                .permissions
+                .set_permission_profile(PermissionProfile::Disabled)
+                .expect("allow test tool execution");
+            config
+                .features
+                .disable(Feature::UseAgentIdentity)
+                .expect("fixture owns only Responses and plugin endpoints");
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    let manager = test.thread_manager.auth_manager();
+    manager
+        .set_external_auth(helper_for_profiles(fixture.path())?)
+        .await?;
+    let elicitation = start_install_turn(&test, "use Calendar").await?;
+    assert_eq!(
+        initial_request
+            .single_request()
+            .header("chatgpt-account-id"),
+        Some("account-a".into())
+    );
+
+    // Change selection again while approval is pending, publishing C as another
+    // consumer would. Completion must still query A; the next model step may use C.
+    select_account(&selection, "account-c", 3)?;
+    manager
+        .auth_for_request(/*model*/ None, /*pinned*/ None)
+        .await?;
+    let before_completion = server
+        .received_requests()
+        .await
+        .expect("recorded requests")
+        .len();
+    tools_available.store(true, Ordering::SeqCst);
+    let next_request =
+        responses::mount_sse_once(&server, responses::sse_completed("response-c")).await;
+    resolve_install_elicitation(&test, elicitation, ElicitationAction::Accept).await?;
+
+    let next = next_request.single_request();
+    let output: Value = serde_json::from_str(
+        &next
+            .function_call_output_text("install-calendar")
+            .expect("installation tool result"),
+    )?;
+    assert_eq!(
+        output,
+        json!({
+            "completed": true, "user_confirmed": true, "tool_type": "plugin", "action_type": "install",
+            "tool_id": "calendar@openai-curated-remote", "tool_name": "Calendar", "suggest_reason": "Use Calendar"
+        })
+    );
+    assert_eq!(next.header("chatgpt-account-id"), Some("account-c".into()));
+    let requests = server.received_requests().await.expect("recorded requests");
+    let completion_accounts = requests
+        .iter()
+        .skip(before_completion)
+        .filter(|request| request.url.path() == "/ps/plugins/installed")
+        .map(|request| {
+            request
+                .headers
+                .get("chatgpt-account-id")
+                .and_then(|value| value.to_str().ok())
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        completion_accounts.first().copied(),
+        Some(Some("account-a"))
+    );
+    assert!(
+        requests.iter().skip(before_completion).any(|request| {
+            request.url.path() == "/api/codex/ps/mcp"
+                && serde_json::from_slice::<Value>(&request.body)
+                    .ok()
+                    .is_some_and(|body| body["method"] == "tools/list")
+        }),
+        "installation must exercise the hard MCP refresh path"
+    );
+    assert_eq!(
+        manager
+            .auth_cached()
+            .expect("shared selection")
+            .get_account_id(),
+        Some("account-c".into())
+    );
+    Ok(())
+}

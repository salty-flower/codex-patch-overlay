+/// Returns `first` on its first RPC and `second` on every later one. A single
+/// static response cannot exercise "the account rotates" -- the helper's own
+/// snapshot cache would recognize the second identical fetch as unchanged.
+#[cfg(unix)]
+fn helper_then(dir: &tempfile::TempDir, first: Value, second: Value) -> RotateHelper {
+    let flag = dir.path().join("called-once").display().to_string();
+    let first = serde_json::to_string(&first)
+        .unwrap()
+        .replace('\'', "'\\''");
+    let second = serde_json::to_string(&second)
+        .unwrap()
+        .replace('\'', "'\\''");
+    RotateHelper::new(vec![
+        "/bin/sh".into(),
+        "-c".into(),
+        format!(
+            "IFS= read -r request; if [ -e '{flag}' ]; then printf '%s' '{second}'; else touch '{flag}'; printf '%s' '{first}'; fi"
+        ),
+    ])
+    .unwrap()
+}

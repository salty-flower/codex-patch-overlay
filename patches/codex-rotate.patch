+//! UI notification only: request admission happens synchronously in core.
+//!
+//! A background observer must never update global cloud policy or initiate an
+//! asynchronous account transition after B's first model request has begun.
+
+use super::*;
+
+pub(super) struct RotationObserver(tokio::task::JoinHandle<()>);
+
+impl Drop for RotationObserver {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+pub(super) fn observe(
+    auth_manager: Arc<AuthManager>,
+    outgoing: Arc<OutgoingMessageSender>,
+) -> Arc<RotationObserver> {
+    let mut changes = auth_manager.auth_change_state_receiver();
+    let mut owner_generation = changes.borrow().owner_generation;
+    Arc::new(RotationObserver(tokio::spawn(async move {
+        while changes.changed().await.is_ok() {
+            let generation = changes.borrow_and_update().owner_generation;
+            if generation == owner_generation {
+                continue;
+            }
+            owner_generation = generation;
+            // Explicit API-key/logout RPCs own their notifications. In
+            // particular, clearing the helper precedes the API-key reload.
+            if !auth_manager.has_rotate_helper() {
+                continue;
+            }
+            let auth = auth_manager.auth_cached();
+            outgoing
+                .send_server_notification(ServerNotification::AccountUpdated(
+                    AccountUpdatedNotification {
+                        auth_mode: auth
+                            .as_ref()
+                            .map(CodexAuth::api_auth_mode)
+                            .map(auth_mode_to_api),
+                        plan_type: auth.as_ref().and_then(CodexAuth::account_plan_type),
+                    },
+                ))
+                .await;
+        }
+    })))
+}

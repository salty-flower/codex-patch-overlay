+#[cfg(unix)]
+#[tokio::test]
+async fn configured_helper_logout_pauses_before_deleting_explicit_api_credentials() {
+    use codex_config::types::AuthCredentialsStoreMode;
+    for available in [false, true] {
+        let home = tempfile::tempdir().unwrap();
+        crate::login_with_api_key(
+            home.path(),
+            "synthetic-api-key",
+            AuthCredentialsStoreMode::File,
+            crate::AuthKeyringBackendKind::default(),
+        )
+        .unwrap();
+        let path = home.path().join("auth.json");
+        let before = std::fs::read(&path).unwrap();
+        let manager = super::super::manager::AuthManager::from_auth_for_testing_with_home(
+            CodexAuth::from_api_key("synthetic-api-key"),
+            home.path().to_path_buf(),
+        );
+        let response = if available {
+            json!({"version":1,"ok":true})
+        } else {
+            json!({"version":1,"ok":false,"error":{"code":"busy"}})
+        };
+        let result = manager
+            .logout_with_rotate_helper(helper(response).argv)
+            .await;
+        if available {
+            assert!(result.unwrap());
+            assert!(!path.exists());
+            assert!(manager.auth_cached().is_none());
+        } else {
+            assert!(result.is_err());
+            assert_eq!(std::fs::read(&path).unwrap(), before);
+            assert!(manager.auth_cached().unwrap().is_api_key_auth());
+        }
+    }
+}

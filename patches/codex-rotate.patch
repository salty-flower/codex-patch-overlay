+#[tokio::test]
+async fn api_key_login_replaces_active_rotate_authority_before_success_notification() -> Result<()>
+{
+    let codex_home = TempDir::new()?;
+    let server = MockServer::start().await;
+    write_config(codex_home.path(), &server.uri(), snapshot_response()?).await?;
+    let mut app = start_app(codex_home.path(), &server, false).await?;
+    assert_initial_rotate_account(&mut app).await?;
+    let request = app
+        .send_login_account_api_key_request("sk-replacement")
+        .await?;
+    let response: LoginAccountResponse =
+        timeout(READ_TIMEOUT, app.read_response(request)).await??;
+    assert_eq!(response, LoginAccountResponse::ApiKey {});
+    assert_updated(&mut app, AuthMode::ApiKey, /*plan_type*/ None).await?;
+    assert_account(&mut app, Account::ApiKey {}).await?;
+    Ok(())
+}
+
+#[derive(Clone, Copy)]
+enum BedrockCredentials {
+    ApiKey,
+    AccessKeys,
+}
+
+#[test_case(BedrockCredentials::ApiKey; "api_key")]
+#[test_case(BedrockCredentials::AccessKeys; "access_keys")]
+#[tokio::test]
+async fn bedrock_login_replaces_active_rotate_authority_before_success_notification(
+    credentials: BedrockCredentials,
+) -> Result<()> {
+    let codex_home = TempDir::new()?;
+    let server = MockServer::start().await;
+    write_config(codex_home.path(), &server.uri(), snapshot_response()?).await?;
+    let mut app = start_app(codex_home.path(), &server, false).await?;
+    assert_initial_rotate_account(&mut app).await?;
+
+    // These public account RPCs exercise credential selection without contacting AWS.
+    let (request, expected_auth_mode) = match credentials {
+        BedrockCredentials::ApiKey => (
+            app.send_login_account_amazon_bedrock_request("synthetic-bedrock-api-key", "us-west-2")
+                .await?,
+            AuthMode::BedrockApiKey,
+        ),
+        BedrockCredentials::AccessKeys => (
+            app.send_login_account_request(json!({
+                "type": "amazonBedrockAccessKeys",
+                "accessKeyId": "synthetic-access-key-id",
+                "secretAccessKey": "synthetic-secret-access-key",
+                "sessionToken": "synthetic-session-token",
+                "region": "us-west-2",
+            }))
+            .await?,
+            AuthMode::BedrockAccessKeys,
+        ),
+    };
+    let response: LoginAccountResponse =
+        timeout(READ_TIMEOUT, app.read_response(request)).await??;
+    assert_eq!(response, LoginAccountResponse::AmazonBedrock {});
+    assert_updated(&mut app, expected_auth_mode, /*plan_type*/ None).await?;
+
+    let audit_path = codex_home.path().join("helper-audit.txt");
+    let audit_after_login = std::fs::read_to_string(&audit_path)?;
+    for refresh_token in [false, true] {
+        let request = app
+            .send_get_account_request(GetAccountParams { refresh_token })
+            .await?;
+        let response: GetAccountResponse =
+            timeout(READ_TIMEOUT, app.read_response(request)).await??;
+        assert_eq!(
+            response,
+            GetAccountResponse {
+                workspace_routing: None,
+                account: Some(Account::AmazonBedrock {
+                    uses_codex_managed_credentials: true,
+                }),
+                requires_openai_auth: false,
+            }
+        );
+    }
+    assert_eq!(
+        std::fs::read_to_string(&audit_path)?,
+        audit_after_login,
+        "account reads and refreshes must no longer acquire Rotate credentials"
+    );
+    Ok(())
+}
+
+#[derive(Clone, Copy)]
+enum Activation {
+    Success,
+    Failure,
+}
+
+#[test_case(Activation::Success; "success")]
+#[test_case(Activation::Failure; "failure")]
+#[tokio::test]
+async fn api_logout_pauses_configured_rotate_before_deleting_credentials(
+    activation: Activation,
+) -> Result<()> {
+    let codex_home = TempDir::new()?;
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/oauth/revoke"))
+        .respond_with(ResponseTemplate::new(200))
+        .expect(0)
+        .mount(&server)
+        .await;
+    let reply = match activation {
+        Activation::Success => json!({"version": 1, "ok": true}),
+        Activation::Failure => json!({"version": 1, "ok": false,
+            "error": {"code": "io_error", "message": "synthetic-secret-must-not-leak"}}),
+    };
+    write_config(codex_home.path(), &server.uri(), reply).await?;
+    save_api_key(codex_home.path())?;
+    let auth_path = codex_home.path().join("auth.json");
+    let original_auth = std::fs::read(&auth_path)?;
+    let audit_path = codex_home.path().join("helper-audit.txt");
+    let mut app = start_app(codex_home.path(), &server, false).await?;
+    assert!(
+        !audit_path.exists(),
+        "API startup must not acquire Rotate credentials"
+    );
+    let request = app.send_logout_account_request().await?;
+    match activation {
+        Activation::Success => {
+            let response: LogoutAccountResponse =
+                timeout(READ_TIMEOUT, app.read_response(request)).await??;
+            assert_eq!(response, LogoutAccountResponse {});
+            let updated: AccountUpdatedNotification =
+                timeout(READ_TIMEOUT, app.read_notification("account/updated")).await??;
+            assert_eq!(
+                updated,
+                AccountUpdatedNotification {
+                    auth_mode: None,
+                    plan_type: None
+                }
+            );
+            assert!(!auth_path.exists());
+        }
+        Activation::Failure => {
+            let error = timeout(
+                READ_TIMEOUT,
+                app.read_stream_until_error_message(RequestId::Integer(request)),
+            )
+            .await??;
+            assert_eq!(
+                error.error,
+                JSONRPCErrorError {
+                    code: -32603,
+                    message: "logout failed: Codex Rotate unavailable; run codex-rotate doctor"
+                        .into(),
+                    data: None,
+                }
+            );
+            assert_eq!(std::fs::read(&auth_path)?, original_auth);
+            assert_account(&mut app, Account::ApiKey {}).await?;
+        }
+    }
+    assert_eq!(
+        std::fs::read_to_string(&audit_path)?,
+        "logout-before-delete\n"
+    );
+    Ok(())
+}

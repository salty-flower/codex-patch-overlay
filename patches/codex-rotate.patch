+#[tokio::test]
+async fn configured_inactive_helper_rejects_external_tokens_without_replacing_api_key() -> Result<()>
+{
+    let codex_home = TempDir::new()?;
+    let server = MockServer::start().await;
+    write_config(
+        codex_home.path(),
+        &server.uri(),
+        json!({
+            "version": 1, "ok": false, "error": {"code": "must_not_be_called"}
+        }),
+    )
+    .await?;
+    save_api_key(codex_home.path())?;
+    let original_auth = std::fs::read(codex_home.path().join("auth.json"))?;
+    let mut app = start_app(codex_home.path(), &server, false).await?;
+    let request = app
+        .send_chatgpt_auth_tokens_login_request(
+            "synthetic-external-token".into(),
+            "external-account".into(),
+            Some("pro".into()),
+        )
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert_eq!(error.error, JSONRPCErrorError {
+        code: -32600,
+        message: "Codex Rotate owns ChatGPT authentication; use browser or device-code login to enroll a personal account".into(),
+        data: None,
+    });
+    assert_account(&mut app, Account::ApiKey {}).await?;
+    assert_eq!(
+        std::fs::read(codex_home.path().join("auth.json"))?,
+        original_auth
+    );
+    Ok(())
+}

+#[cfg(unix)]
+#[tokio::test]
+async fn idle_auth_reads_use_the_published_rotate_snapshot_without_respawning_the_helper() {
+    let dir = tempfile::tempdir().unwrap();
+    let counter = dir.path().join("calls");
+    let manager = super::super::manager::AuthManager::from_auth_for_testing(auth("account-a", 1));
+    manager
+        .set_external_auth(Arc::new(counting_helper(
+            json!({"version": 1, "ok": true, "snapshot": snapshot("account-a", 1)}),
+            &counter,
+        )))
+        .await
+        .unwrap();
+    let mut changes = manager.auth_change_receiver();
+    changes.borrow_and_update();
+    assert!(manager.auth().await.is_some());
+    assert!(manager.auth().await.is_some());
+    assert_eq!(
+        std::fs::read(&counter).unwrap_or_default().len(),
+        1,
+        "passive auth() reads must not respawn the rotate helper"
+    );
+    assert!(
+        !changes.has_changed().unwrap(),
+        "passive auth() reads must not publish an auth change"
+    );
+}

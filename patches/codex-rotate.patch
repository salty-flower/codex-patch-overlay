diff --git a/codex-rs/core/src/session/rotate_step.rs b/codex-rs/core/src/session/rotate_step.rs
new file mode 100644
index 0000000000..bea4f12df2
--- /dev/null
+++ b/codex-rs/core/src/session/rotate_step.rs
@@ -0,0 +1,291 @@
+//! Personal account admission before any account-dependent step preparation.
+//!
+//! Managed cloud configuration is deliberately outside this personal adapter.
+//! Never replace process-global cloud state asynchronously after starting a request.
+
+use super::*;
+use codex_config::ConfigLayerSource;
+use codex_config::ConfigRequirements;
+use codex_config::RequirementSource;
+use codex_protocol::account::PlanType;
+use codex_protocol::config_types::ForcedLoginMethod;
+
+fn validate_personal_step(config: &Config, auth: &CodexAuth) -> CodexResult<()> {
+    if !matches!(
+        auth.account_plan_type(),
+        Some(PlanType::Free | PlanType::Go | PlanType::Plus | PlanType::Pro | PlanType::ProLite)
+    ) || config
+        .config_layer_stack
+        .layers_low_to_high()
+        .any(|layer| matches!(layer.name, ConfigLayerSource::EnterpriseManaged { .. }))
+        || has_cloud_requirements(config.config_layer_stack.requirements())
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Codex Rotate supports personal accounts only; managed or unknown account contexts require rotation to be disabled".to_string(),
+        ));
+    }
+    let requirements = config.config_layer_stack.requirements();
+    if config
+        .forced_login_method
+        .is_some_and(|method| method != ForcedLoginMethod::Chatgpt)
+        || config
+            .forced_chatgpt_workspace_id
+            .as_ref()
+            .is_some_and(|allowed| {
+                !auth
+                    .get_account_id()
+                    .is_some_and(|account| allowed.contains(&account))
+            })
+        || requirements
+            .allowed_login_methods
+            .as_ref()
+            .is_some_and(|allowed| !allowed.value.contains(&ForcedLoginMethod::Chatgpt))
+        || requirements
+            .allowed_chatgpt_workspaces
+            .as_ref()
+            .is_some_and(|allowed| {
+                !auth
+                    .get_account_id()
+                    .is_some_and(|account| allowed.value.contains(&account))
+            })
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Codex Rotate account is not permitted by the current session requirements".to_string(),
+        ));
+    }
+    Ok(())
+}
+
+fn is_cloud_source(source: &RequirementSource) -> bool {
+    match source {
+        RequirementSource::EnterpriseManaged { .. } => true,
+        RequirementSource::Composite { sources } => sources.iter().any(is_cloud_source),
+        RequirementSource::Unknown
+        | RequirementSource::MdmManagedPreferences { .. }
+        | RequirementSource::SystemRequirementsToml { .. }
+        | RequirementSource::LegacyManagedConfigTomlFromFile { .. }
+        | RequirementSource::LegacyManagedConfigTomlFromMdm => false,
+    }
+}
+
+fn has_cloud_requirements(requirements: &ConfigRequirements) -> bool {
+    // Exhaustive destructuring keeps newly introduced managed authority visible
+    // at this fail-closed boundary, including requirement-only cloud bundles.
+    let ConfigRequirements {
+        allowed_login_methods,
+        allowed_chatgpt_workspaces,
+        cli_auth_credentials_store,
+        chatgpt_base_url,
+        sqlite_home,
+        log_dir,
+        model_catalog_json,
+        model_provider,
+        model_providers,
+        check_for_update_on_startup,
+        allow_login_shell,
+        feedback,
+        approval_policy,
+        approvals_reviewer,
+        auto_review_required_models,
+        permission_profile,
+        windows_sandbox_mode,
+        web_search_mode,
+        allow_managed_hooks_only,
+        allow_appshots,
+        allow_remote_control,
+        computer_use,
+        feature_requirements,
+        managed_hooks,
+        mcp_servers,
+        plugins,
+        marketplaces,
+        exec_policy,
+        enforce_residency,
+        network,
+        application,
+        filesystem,
+        additional_developer_instructions,
+        guardian_policy_config_source,
+        guardian_extra_policy_source,
+    } = requirements;
+    [
+        allowed_login_methods.as_ref().map(|value| &value.source),
+        allowed_chatgpt_workspaces
+            .as_ref()
+            .map(|value| &value.source),
+        cli_auth_credentials_store
+            .as_ref()
+            .map(|value| &value.source),
+        chatgpt_base_url.as_ref().map(|value| &value.source),
+        sqlite_home.as_ref().map(|value| &value.source),
+        log_dir.as_ref().map(|value| &value.source),
+        model_catalog_json.as_ref().map(|value| &value.source),
+        model_provider.as_ref().map(|value| &value.source),
+        model_providers.as_ref().map(|value| &value.source),
+        check_for_update_on_startup
+            .as_ref()
+            .map(|value| &value.source),
+        allow_login_shell.as_ref().map(|value| &value.source),
+        feedback.as_ref().map(|value| &value.source),
+        approval_policy.source.as_ref(),
+        approvals_reviewer.source.as_ref(),
+        auto_review_required_models
+            .as_ref()
+            .map(|value| &value.source),
+        permission_profile.source.as_ref(),
+        windows_sandbox_mode.source.as_ref(),
+        web_search_mode.source.as_ref(),
+        allow_managed_hooks_only.as_ref().map(|value| &value.source),
+        allow_appshots.as_ref().map(|value| &value.source),
+        allow_remote_control.as_ref().map(|value| &value.source),
+        computer_use.as_ref().map(|value| &value.source),
+        feature_requirements.as_ref().map(|value| &value.source),
+        managed_hooks
+            .as_ref()
+            .and_then(|value| value.source.as_ref()),
+        mcp_servers.as_ref().map(|value| &value.source),
+        plugins.as_ref().map(|value| &value.source),
+        marketplaces.as_ref().map(|value| &value.source),
+        exec_policy.as_ref().map(|value| &value.source),
+        enforce_residency.source.as_ref(),
+        network.as_ref().map(|value| &value.source),
+        application.as_ref().map(|value| &value.source),
+        filesystem.as_ref().map(|value| &value.source),
+        additional_developer_instructions
+            .as_ref()
+            .map(|value| &value.source),
+        guardian_policy_config_source.as_ref(),
+        guardian_extra_policy_source.as_ref(),
+    ]
+    .into_iter()
+    .flatten()
+    .any(is_cloud_source)
+}
+
+impl Session {
+    pub(super) async fn capture_step_context_inner(
+        self: &Arc<Self>,
+        turn_context: Arc<TurnContext>,
+        cancellation_token: &CancellationToken,
+        required_servers: &[String],
+        required_plugins: &HashSet<String>,
+    ) -> CodexResult<Arc<StepContext>> {
+        // Capture settings and environment selection at the same publication boundary
+        // before account admission can await.
+        let (settings, environments) = {
+            let _active = self
+                .active_turn
+                .lock()
+                .or_cancel(cancellation_token)
+                .await?;
+            (
+                turn_context.next_step_settings.load_full(),
+                self.services.turn_environments.snapshot(),
+            )
+        };
+        let manager = Arc::clone(&self.services.auth_manager);
+        let rotate_auth =
+            if manager.has_rotate_helper() && turn_context.provider.info().requires_openai_auth {
+                Some(
+                    manager
+                        .auth_for_request(Some(&settings.model_info.slug), /*pinned*/ None)
+                        .or_cancel(cancellation_token)
+                        .await??
+                        .ok_or_else(|| {
+                            CodexErr::InvalidRequest("Codex Rotate is signed out".to_string())
+                        })?,
+                )
+            } else {
+                None
+            };
+        let prepare = async {
+            if let Some(auth) = &rotate_auth {
+                validate_personal_step(&turn_context.config, auth)?;
+                {
+                    let state = self.state.lock().await;
+                    let current = &state.session_configuration.original_config_do_not_use;
+                    validate_personal_step(current, auth)?;
+                    if current.enforce_residency.value()
+                        != turn_context.config.enforce_residency.value()
+                    {
+                        return Err(CodexErr::InvalidRequest(
+                            "Codex Rotate cannot change the admitted turn's residency requirements"
+                                .to_string(),
+                        ));
+                    }
+                }
+                let plugins = &self.services.plugins_manager;
+                let plugins_config = turn_context.config.plugins_config_input();
+                if plugins_config.plugins_enabled
+                    && plugins_config.remote_plugin_enabled
+                    && plugins
+                        .build_remote_installed_plugin_marketplaces_from_cache(&[])
+                        .is_none()
+                {
+                    plugins
+                        .build_and_cache_remote_installed_plugin_marketplaces(
+                            &plugins_config,
+                            Some(auth),
+                            &[],
+                            /*on_effective_plugins_changed*/ None,
+                        )
+                        .or_cancel(cancellation_token)
+                        .await?
+                        .map_err(|_| CodexErr::InvalidRequest(
+                            "Codex Rotate could not prepare the selected account's plugin inventory; no model request was sent".to_string(),
+                        ))?;
+                    // The awaited metadata refresh does not run background bundle
+                    // reconciliation or delete files retained by another account's turn.
+                    plugins.clear_cache();
+                    self.services.skills_service.clear_cache();
+                    self.mark_mcp_runtime_dirty();
+                }
+            }
+            let step = self
+                .capture_prepared_step_context(
+                    turn_context,
+                    cancellation_token,
+                    required_servers,
+                    required_plugins,
+                    rotate_auth.clone(),
+                    settings,
+                    environments,
+                )
+                .await?;
+            if let Some(auth) = &rotate_auth {
+                let state = self.state.lock().await;
+                let current = &state.session_configuration.original_config_do_not_use;
+                validate_personal_step(current, auth)?;
+                if current.enforce_residency.value() != step.turn.config.enforce_residency.value() {
+                    return Err(CodexErr::InvalidRequest(
+                        "Codex Rotate residency requirements changed during request preparation"
+                            .to_string(),
+                    ));
+                }
+                let plugins = step.turn.config.plugins_config_input();
+                if plugins.plugins_enabled
+                    && plugins.remote_plugin_enabled
+                    && self
+                        .services
+                        .plugins_manager
+                        .build_remote_installed_plugin_marketplaces_from_cache(&[])
+                        .is_none()
+                {
+                    return Err(CodexErr::InvalidRequest(
+                        "Codex Rotate plugin inventory changed during request preparation; retry this turn".to_string(),
+                    ));
+                }
+            }
+            Ok(step)
+        };
+        if let Some(auth) = rotate_auth.clone() {
+            manager.scope_request_auth(auth, prepare).await
+        } else {
+            prepare.await
+        }
+    }
+}
+

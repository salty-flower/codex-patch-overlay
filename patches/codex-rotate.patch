+    let home = tempdir().unwrap();
+    let claims = json!({"https://api.openai.com/auth": {
+        "chatgpt_account_id":"personal-account", "chatgpt_user_id":"personal-user", "chatgpt_plan_type":"pro"
+    }});
+    let id_token = format!(
+        "e30.{}.signature",
+        base64::engine::general_purpose::URL_SAFE_NO_PAD
+            .encode(serde_json::to_vec(&claims).unwrap())
+    );
+    let auth = CodexAuth::from_rotate_snapshot(
+        serde_json::from_value(json!({
+            "account_key":"personal-account", "account_id":"personal-account", "selection_epoch":1,
+            "credential_revision":1, "id_token":id_token, "access_token":"synthetic-access",
+            "expires_at":Utc::now().timestamp()+3600
+        }))
+        .unwrap(),
+        None,
+    )
+    .unwrap();
+    let CodexAuth::Chatgpt(chatgpt) = &auth else {
+        panic!("expected native ChatGPT identity")
+    };
+    chatgpt
+        .state
+        .auth_dot_json
+        .lock()
+        .unwrap()
+        .as_mut()
+        .unwrap()
+        .last_refresh = Some(Utc::now() - chrono::Duration::days(30));
+    assert!(!AuthManager::should_refresh_proactively(&auth));
+    let manager =
+        AuthManager::from_auth_for_testing_with_home(auth.clone(), home.path().to_path_buf());
+    let error = manager
+        .refresh_and_persist_chatgpt_token(chatgpt, String::new())
+        .await
+        .unwrap_err();
+    assert_eq!(
+        error.to_string(),
+        "Codex Rotate refresh requires a request snapshot"
+    );
+    let mut document = chatgpt.current_auth_json().unwrap();
+    document.tokens.as_mut().unwrap().refresh_token = "must-not-persist".into();
+    assert!(chatgpt.storage().save(&document).is_err());
+    assert!(!home.path().join("auth.json").exists());
+}

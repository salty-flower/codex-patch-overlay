+async fn assert_initial_rotate_account(app: &mut TestAppServer) -> Result<()> {
+    assert_account(app, chatgpt_account()).await?;
+    assert_updated(app, AuthMode::Chatgpt, Some(PlanType::Pro)).await
+}

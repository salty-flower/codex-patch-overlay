+use tokio::io::AsyncWriteExt;
+use tokio::process::Command;
+
+const MAX_MESSAGE_BYTES: u64 = 128 * 1024;
+const HELPER_TIMEOUT: Duration = Duration::from_secs(50);
+const OBSERVATION_TIMEOUT: Duration = Duration::from_secs(1);
+
+#[cfg(unix)]
+mod unix_process {
+    const SIGKILL: i32 = 9;
+
+    unsafe extern "C" {
+        fn kill(pid: i32, signal: i32) -> i32;
+    }
+
+    pub(super) fn kill_group(pid: i32) {
+        // SAFETY: the caller created a process group whose positive PGID is
+        // `pid`; negating it targets that group and can never target ours.
+        let _ = unsafe { kill(-pid, SIGKILL) };
+    }
+
+    #[cfg(test)]
+    pub(super) fn process_exists(pid: i32) -> bool {
+        // SAFETY: signal zero checks existence/permission without sending a signal.
+        unsafe {
+            kill(pid, /*signal*/ 0) == 0
+        }
+    }
+}
+
+// Keep this guard alive until after wait(), including when the RPC future is
+// cancelled by either timeout. kill_on_drop alone only kills the direct child.
+#[cfg(unix)]
+struct HelperProcessGroup {
+    pid: u32,
+    // A helper that answered and exited is finished work, not abandoned work.
+    // Only an abandoned RPC may signal the group, so a completed call can never
+    // SIGKILL a recycled process group.
+    armed: bool,
+}
+
+#[cfg(unix)]
+impl HelperProcessGroup {
+    fn new(pid: u32) -> Self {
+        Self { pid, armed: true }
+    }
+
+    fn disarm(&mut self) {
+        self.armed = false;
+    }
+}
+
+#[cfg(unix)]
+impl Drop for HelperProcessGroup {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+        if let Ok(pid) = i32::try_from(self.pid) {
+            // The guard is armed only while `process_group(0)` makes this
+            // helper's PID its own PGID, and `kill_group` negates it.
+            unix_process::kill_group(pid);
+        }
+    }
+}

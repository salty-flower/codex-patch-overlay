+
+const READ_TIMEOUT: Duration = Duration::from_secs(60);
+
+fn snapshot_response() -> Result<Value> {
+    let id_token = encode_id_token(
+        &ChatGptIdTokenClaims::new()
+            .email("rotate@example.com")
+            .plan_type("pro")
+            .chatgpt_user_id("rotate-user")
+            .chatgpt_account_id("rotate-account"),
+    )?;
+    Ok(json!({"version": 1, "ok": true, "snapshot": {
+        "account_key": "personal-profile", "account_id": "rotate-account",
+        "selection_epoch": 1, "credential_revision": 1,
+        "access_token": "synthetic-access", "id_token": id_token,
+        "expires_at": chrono::Utc::now().timestamp() + 3600
+    }}))
+}
+
+fn write_config(codex_home: &Path, base_url: &str, response: Value) -> Result<()> {
+    let response_path = codex_home.join("helper-response.json");
+    std::fs::write(&response_path, serde_json::to_vec(&response)?)?;
+    // This synthetic helper deliberately keeps token fixtures out of argv.
+    let helper = json!([
+        "/bin/sh",
+        "-c",
+        r#"IFS= read -r request; case "$request" in
+        *'"op":"register"'*) printf '%s' '{"version":1,"ok":true,"account_key":"personal-profile"}' ;;
+        *'"op":"logout"'*)
+            if test -f "$2"; then printf 'logout-before-delete\n' >> "$3";
+            else printf 'logout-after-delete\n' >> "$3"; fi; cat "$1" ;;
+        *) printf 'acquire\n' >> "$3"; cat "$1" ;; esac"#,
+        "rotate-test-helper",
+        response_path,
+        codex_home.join("auth.json"),
+        codex_home.join("helper-audit.txt")
+    ]);
+    std::fs::write(
+        codex_home.join("config.toml"),
+        format!(
+            "model = \"mock-model\"\nmodel_provider = \"mock\"\n\
+         cli_auth_credentials_store = \"file\"\ncodex_rotate_helper = {helper}\n\
+         chatgpt_base_url = \"{base_url}/backend-api\"\n\
+         [features]\nshell_snapshot = false\n\
+         [model_providers.mock]\nname = \"Mock\"\nbase_url = \"{base_url}/v1\"\n\
+         requires_openai_auth = true\nwire_api = \"responses\"\n\
+         request_max_retries = 0\nstream_max_retries = 0\n"
+        ),
+    )?;
+    write_models_cache(codex_home)?;
+    Ok(())
+}
+
+fn save_api_key(codex_home: &Path) -> Result<()> {
+    login_with_api_key(
+        codex_home,
+        "sk-synthetic",
+        AuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::default(),
+    )?;
+    Ok(())
+}
+
+async fn start_app(codex_home: &Path, issuer: &str) -> Result<TestAppServer> {
+    let revoke_endpoint = format!("{issuer}/oauth/revoke");
+    TestAppServer::builder()
+        .with_codex_home(codex_home)
+        .without_auto_env()
+        .with_env_overrides(&[
+            ("OPENAI_API_KEY", None),
+            ("CODEX_APP_SERVER_LOGIN_ISSUER", Some(issuer)),
+            (
+                "CODEX_REVOKE_TOKEN_URL_OVERRIDE",
+                Some(revoke_endpoint.as_str()),
+            ),
+        ])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await
+}
+
+fn chatgpt_account() -> Account {
+    Account::Chatgpt {
+        email: Some("rotate@example.com".into()),
+        plan_type: PlanType::Pro,
+    }
+}
+
+async fn assert_account(app: &mut TestAppServer, account: Account) -> Result<()> {
+    let request = app
+        .send_get_account_request(GetAccountParams {
+            refresh_token: false,
+        })
+        .await?;
+    let response: GetAccountResponse = timeout(READ_TIMEOUT, app.read_response(request)).await??;
+    assert_eq!(
+        response,
+        GetAccountResponse {
+            account: Some(account),
+            requires_openai_auth: true
+        }
+    );
+    Ok(())
+}
+
+async fn assert_updated(
+    app: &mut TestAppServer,
+    auth_mode: AuthMode,
+    plan_type: Option<PlanType>,
+) -> Result<()> {
+    let updated: AccountUpdatedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("account/updated")).await??;
+    assert_eq!(
+        updated,
+        AccountUpdatedNotification {
+            auth_mode: Some(auth_mode),
+            plan_type
+        }
+    );
+    Ok(())
+}

+#[test]
+fn rotation_rejects_managed_and_unknown_plans() {
+    for plan in ["business", "enterprise", "edu", "future-plan"] {
+        let claims = json!({"https://api.openai.com/auth": {
+            "chatgpt_account_id":"account-a", "chatgpt_user_id":"user-a", "chatgpt_plan_type":plan
+        }});
+        let mut value = snapshot("account-a", 1);
+        value["id_token"] = json!(format!(
+            "e30.{}.signature",
+            URL_SAFE_NO_PAD.encode(serde_json::to_vec(&claims).unwrap())
+        ));
+        assert!(
+            CodexAuth::from_rotate_snapshot(serde_json::from_value(value).unwrap(), None).is_err()
+        );
+    }
+}

+fn snapshot_response() -> Result<Value> {
+    let id_token = encode_id_token(
+        &ChatGptIdTokenClaims::new()
+            .email("rotate@example.com")
+            .plan_type("pro")
+            .chatgpt_user_id("rotate-user")
+            .chatgpt_account_id("rotate-account"),
+    )?;
+    Ok(json!({"version": 1, "ok": true, "snapshot": {
+        "account_key": "personal-profile", "account_id": "rotate-account",
+        "selection_epoch": 1, "credential_revision": 1,
+        "access_token": "synthetic-access", "id_token": id_token,
+        "expires_at": chrono::Utc::now().timestamp() + 3600
+    }}))
+}
+
+async fn write_config(codex_home: &Path, base_url: &str, response: Value) -> Result<()> {
+    let response_path = codex_home.join("helper-response.json");
+    std::fs::write(&response_path, serde_json::to_vec(&response)?)?;
+    // This synthetic helper deliberately keeps token fixtures out of argv.
+    let helper = json!([
+        "/bin/sh",
+        "-c",
+        r#"IFS= read -r request; case "$request" in
+        *'"op":"register"'*) printf '%s' '{"version":1,"ok":true,"account_key":"personal-profile"}' ;;
+        *'"op":"logout"'*)
+            if test -f "$2"; then printf 'logout-before-delete\n' >> "$3";
+            else printf 'logout-after-delete\n' >> "$3"; fi; cat "$1" ;;
+        *) printf 'acquire\n' >> "$3"; cat "$1" ;; esac"#,
+        "rotate-test-helper",
+        response_path,
+        codex_home.join("auth.json"),
+        codex_home.join("helper-audit.txt")
+    ]);
+    std::fs::write(
+        codex_home.join("config.toml"),
+        format!(
+            "model = \"mock-model\"\nmodel_provider = \"mock\"\n\
+         cli_auth_credentials_store = \"file\"\ncodex_rotate_helper = {helper}\n\
+         chatgpt_base_url = \"{base_url}/backend-api\"\n\
+         [features]\nshell_snapshot = false\n\
+         [model_providers.mock]\nname = \"Mock\"\nbase_url = \"{base_url}/v1\"\n\
+         requires_openai_auth = true\nwire_api = \"responses\"\n\
+         request_max_retries = 0\nstream_max_retries = 0\n"
+        ),
+    )?;
+    write_models_cache(codex_home).await?;
+    Ok(())
+}
+
+async fn mount_models_catalog(server: &MockServer) -> Result<()> {
+    let mut mock_model = codex_models_manager::bundled_models_response()?
+        .models
+        .remove(0);
+    mock_model.slug = "mock-model".to_string();
+    mock_model.display_name = "Mock Model".to_string();
+    mock_model.visibility = ModelVisibility::List;
+    mock_model.supported_in_api = true;
+    Mock::given(method("GET"))
+        .and(path("/v1/models"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(ModelsResponse {
+            models: vec![mock_model],
+        }))
+        .mount(server)
+        .await;
+    Ok(())
+}
+
+async fn mount_empty_plugin_catalog(server: &MockServer) {
+    Mock::given(method("GET"))
+        .and(path("/backend-api/ps/plugins/suggested/codex"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "enabled": true,
+            "plugins": [],
+        })))
+        .mount(server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path("/backend-api/ps/plugins/installed"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "plugins": [],
+            "pagination": {"next_page_token": null},
+        })))
+        .mount(server)
+        .await;
+}
+
+async fn mount_model_response(server: &MockServer) -> Result<()> {
+    let body = create_final_assistant_message_sse_response("Done")?;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(body),
+        )
+        .mount(server)
+        .await;
+    Ok(())
+}

+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashMap;
+use std::io::Write;
+use std::path::Path;
+use std::sync::Arc;
+use tokio_util::sync::CancellationToken;
+use wiremock::Mock;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+pub(super) fn select_account(file: &Path, account: &str, epoch: u64) -> Result<()> {
+    let claims = json!({ "https://api.openai.com/auth": {
+        "chatgpt_account_id": account, "chatgpt_user_id": account, "chatgpt_plan_type": "pro"
+    }});
+    let id_token = format!(
+        "e30.{}.signature",
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(&claims)?)
+    );
+    let snapshot = json!({ "version": 1, "ok": true, "snapshot": {
+        "account_key": account, "account_id": account, "selection_epoch": epoch,
+        "credential_revision": 1, "id_token": id_token, "access_token": format!("synthetic-{account}"),
+        "expires_at": chrono::Utc::now().timestamp() + 3600,
+    }});
+    let mut pending = tempfile::NamedTempFile::new_in(file.parent().expect("fixture directory"))?;
+    writeln!(pending, "{snapshot}")?;
+    pending.persist(file)?;
+    Ok(())
+}
+
+pub(super) fn helper_for_profiles(directory: &Path) -> Result<Arc<RotateHelper>> {
+    Ok(Arc::new(RotateHelper::new(vec![
+        "/bin/sh".into(), "-c".into(),
+        "IFS= read -r request; case \"$request\" in *'\"account_key\":\"account-a\"'*) profile=account-a;; *'\"account_key\":\"account-b\"'*) profile=account-b;; *'\"account_key\":\"account-c\"'*) profile=account-c;; *) profile=selected;; esac; IFS= read -r response < \"$1/$profile.json\"; printf '%s\\n' \"$response\"".into(),
+        "rotate-fixture".into(), directory.to_string_lossy().into_owned(),
+    ])?))
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn rotate_step_prepares_selected_plugins_before_first_request_and_pins_late_selection()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let responses = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse_completed("response-a"),
+            responses::sse_completed("response-b"),
+        ],
+    )
+    .await;
+    let fixture = tempfile::tempdir()?;
+    let selection = fixture.path().join("selected.json");
+    select_account(&fixture.path().join("account-a.json"), "account-a", 1)?;
+    select_account(&fixture.path().join("account-b.json"), "account-b", 2)?;
+    select_account(&fixture.path().join("account-c.json"), "account-c", 3)?;
+    select_account(&selection, "account-a", 1)?;
+    let late_selection = selection.clone();
+    Mock::given(method("GET"))
+        .and(path("/ps/plugins/installed"))
+        .respond_with(move |request: &wiremock::Request| {
+            if request
+                .headers
+                .get("chatgpt-account-id")
+                .and_then(|value| value.to_str().ok())
+                == Some("account-b")
+            {
+                // A different consumer selects C while B's account-dependent
+                // preparation is in progress. B must still be the request owner.
+                select_account(&late_selection, "account-c", 3).expect("change synthetic account");
+            }
+            ResponseTemplate::new(200).set_body_json(json!({
+                "plugins": [], "pagination": {"next_page_token": null},
+            }))
+        })
+        .mount(&server)
+        .await;
+    let plugin_base = server.uri();
+    let mut builder = test_codex()
+        .with_auth(CodexAuth::from_api_key("seed"))
+        .with_config(move |config| {
+            config.chatgpt_base_url = plugin_base;
+            config
+                .features
+                .enable(Feature::Plugins)
+                .expect("enable plugins");
+            config
+                .features
+                .enable(Feature::RemotePlugin)
+                .expect("enable remote plugins");
+            // This fixture owns only Responses and plugin metadata endpoints;
+            // agent identity bootstrap has separate auth-layer coverage.
+            config
+                .features
+                .disable(Feature::UseAgentIdentity)
+                .expect("disable external bootstrap");
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.thread_manager
+        .auth_manager()
+        .set_external_auth(helper_for_profiles(fixture.path())?)
+        .await?;
+    test.submit_turn("retain the first account's conversation context")
+        .await?;
+    select_account(&selection, "account-b", 2)?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "continue the same conversation".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        if let EventMsg::Error(error) = event {
+            panic!("rotation preparation failed: {}", error.message);
+        }
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let requests = responses.requests();
+    assert_eq!(
+        requests
+            .iter()
+            .map(|request| request.header("chatgpt-account-id"))
+            .collect::<Vec<_>>(),
+        vec![Some("account-a".into()), Some("account-b".into())]
+    );
+    assert!(
+        requests[1]
+            .message_input_texts("user")
+            .iter()
+            .any(|text| text.contains("retain the first account"))
+    );
+    let ordered = server
+        .received_requests()
+        .await
+        .expect("recorded requests")
+        .into_iter()
+        .filter(|request| {
+            matches!(
+                request.url.path(),
+                "/ps/plugins/installed" | "/v1/responses"
+            )
+        })
+        .map(|request| {
+            (
+                request.url.path().to_string(),
+                request
+                    .headers
+                    .get("chatgpt-account-id")
+                    .and_then(|value| value.to_str().ok())
+                    .map(str::to_owned),
+            )
+        })
+        .collect::<Vec<_>>();
+    let b_prepared = ordered
+        .iter()
+        .position(|(path, account)| {
+            path == "/ps/plugins/installed" && account.as_deref() == Some("account-b")
+        })
+        .expect("B plugins prepared");
+    let b_sent = ordered
+        .iter()
+        .position(|(path, account)| {
+            path == "/v1/responses" && account.as_deref() == Some("account-b")
+        })
+        .expect("B inference sent");
+    assert!(b_prepared < b_sent);
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn rotate_spawned_mcp_requests_retain_the_original_owner_after_selection_changes()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;

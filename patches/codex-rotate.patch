+async fn assert_account(app: &mut TestAppServer, account: Account) -> Result<()> {
+    let workspace_chatgpt_account_id =
+        matches!(&account, Account::Chatgpt { .. }).then_some("rotate-account");
+    assert_account_with_workspace(app, account, workspace_chatgpt_account_id).await

+impl RotateHelper {
+    pub fn new(argv: Vec<String>) -> io::Result<Self> {
+        if !argv
+            .first()
+            .is_some_and(|program| Path::new(program).is_absolute())
+        {
+            return Err(io::Error::other(
+                "codex_rotate_helper requires an absolute executable",
+            ));
+        }
+        Ok(Self {
+            argv,
+            auth: Mutex::new(HashMap::new()),
+        })
+    }
+
+    pub async fn rpc(&self, mut request: Value) -> io::Result<Value> {
+        request["version"] = json!(1);
+        let input = serde_json::to_vec(&request)
+            .map_err(|_| io::Error::other("invalid Codex Rotate request"))?;
+        if input.len() as u64 > MAX_MESSAGE_BYTES {
+            return Err(io::Error::other("Codex Rotate request exceeds size limit"));
+        }
+        tokio::time::timeout(HELPER_TIMEOUT, async {
+            let mut command = Command::new(&self.argv[0]);
+            command
+                .args(&self.argv[1..])
+                .stdin(Stdio::piped())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null())
+                .kill_on_drop(true);
+            #[cfg(unix)]
+            command.process_group(0);
+            let mut child = command
+                .spawn()
+                .map_err(|_| io::Error::other("Codex Rotate helper could not start"))?;
+            #[cfg(unix)]
+            let mut process_group = child.id().map(HelperProcessGroup::new);
+            let mut stdin = child
+                .stdin
+                .take()
+                .ok_or_else(|| io::Error::other("Codex Rotate helper stdin unavailable"))?;
+            let stdout = child
+                .stdout
+                .take()
+                .ok_or_else(|| io::Error::other("Codex Rotate helper stdout unavailable"))?;
+            let write = async move {
+                stdin.write_all(&input).await?;
+                drop(stdin);
+                Ok::<_, io::Error>(())
+            };
+            let read = async {
+                let mut bytes = Vec::new();
+                stdout
+                    .take(MAX_MESSAGE_BYTES + 1)
+                    .read_to_end(&mut bytes)
+                    .await?;
+                if bytes.len() as u64 > MAX_MESSAGE_BYTES {
+                    return Err(io::Error::other("Codex Rotate response exceeds size limit"));
+                }
+                Ok::<_, io::Error>(bytes)
+            };
+            let (_, bytes) = tokio::try_join!(write, read)
+                .map_err(|_| io::Error::other("Codex Rotate helper I/O failed"))?;
+            let status = child
+                .wait()
+                .await
+                .map_err(|_| io::Error::other("Codex Rotate helper failed"))?;
+            #[cfg(unix)]
+            if let Some(group) = process_group.as_mut() {
+                group.disarm();
+            }
+            let response: Value = serde_json::from_slice(&bytes)
+                .map_err(|_| io::Error::other("invalid Codex Rotate response"))?;
+            if response.get("version") != Some(&json!(1))
+                || response.get("ok") != Some(&json!(true))
+                || !status.success()
+            {
+                if response.get("version") == Some(&json!(1))
+                    && matches!(
+                        response["error"]["code"].as_str(),
+                        Some("signed_out" | "no_accounts")
+                    )
+                {
+                    return Err(io::Error::new(
+                        io::ErrorKind::NotFound,
+                        "Codex Rotate is signed out; run codex login",
+                    ));
+                }
+                // Never echo a helper-controlled message, code, stdout or stderr.
+                return Err(io::Error::other(
+                    "Codex Rotate unavailable; run codex-rotate doctor",
+                ));
+            }
+            Ok(response)
+        })
+        .await
+        .map_err(|_| io::Error::other("Codex Rotate helper timed out"))?
+    }
+
+    pub(super) async fn report(&self, request: Value) {
+        // Advisory reports never refresh credentials. Dropping a slow helper is
+        // safe and the next preflight can fetch an authoritative usage snapshot.
+        if !matches!(
+            tokio::time::timeout(OBSERVATION_TIMEOUT, self.rpc(request)).await,
+            Ok(Ok(_))
+        ) {
+            tracing::warn!("Codex Rotate usage observation unavailable");
+        }
+    }
+
+    async fn request_auth(&self, request: Value) -> io::Result<CodexAuth> {
+        let response = self.rpc(request).await?;
+        let snapshot: RotateSnapshot = serde_json::from_value(response["snapshot"].clone())
+            .map_err(|_| io::Error::other("invalid Codex Rotate credential snapshot"))?;
+        if snapshot.identity.account_key.is_empty()
+            || snapshot.account_id.is_empty()
+            || snapshot.access_token.is_empty()
+            || snapshot.expires_at <= chrono::Utc::now().timestamp()
+        {
+            return Err(io::Error::other(
+                "Codex Rotate returned unusable credentials",
+            ));
+        }
+        let mut cache = self
+            .auth
+            .lock()
+            .map_err(|_| io::Error::other("Codex Rotate cache unavailable"))?;
+        let key = snapshot.identity.account_key.clone();
+        let auth = CodexAuth::from_rotate_snapshot(snapshot, cache.get(&key))?;
+        if cache.len() >= 32
+            && !cache.contains_key(&key)
+            && let Some(oldest) = cache.keys().next().cloned()
+        {
+            cache.remove(&oldest);
+        }
+        cache.insert(key, auth.clone());
+        Ok(auth)
+    }
+
+    /// Reuse a refresh already completed by this authority without doing I/O or
+    /// consulting its global selection. Old steps must never adopt a new epoch.
+    pub(super) fn latest_request_auth(&self, pinned: &CodexAuth) -> CodexAuth {
+        let Some(expected) = pinned.rotate_identity() else {
+            return pinned.clone();
+        };
+        self.auth
+            .lock()
+            .ok()
+            .and_then(|cache| cache.get(&expected.account_key).cloned())
+            .filter(|auth| {
+                auth.rotate_identity().is_some_and(|actual| {
+                    actual.account_key == expected.account_key
+                        && actual.selection_epoch == expected.selection_epoch
+                        && actual.credential_revision >= expected.credential_revision
+                }) && auth.get_account_id() == pinned.get_account_id()
+            })
+            .unwrap_or_else(|| pinned.clone())
+    }
+
+    pub async fn acquire(
+        &self,
+        model: Option<&str>,
+        pinned: Option<&CodexAuth>,
+    ) -> io::Result<CodexAuth> {
+        let mut request = json!({"op": "acquire", "model": model});
+        if let Some(identity) = pinned.and_then(CodexAuth::rotate_identity) {
+            request["account_key"] = json!(identity.account_key);
+            request["selection_epoch"] = json!(identity.selection_epoch);
+        }
+        let auth = self.request_auth(request).await?;
+        if let Some(expected) = pinned.and_then(CodexAuth::rotate_identity)
+            && !auth.rotate_identity().is_some_and(|actual| {
+                actual.account_key == expected.account_key
+                    && actual.selection_epoch == expected.selection_epoch
+            })
+        {
+            return Err(io::Error::other(
+                "Codex Rotate changed a pinned request owner",
+            ));
+        }
+        Ok(auth)
+    }
+
+    pub async fn refresh_snapshot(&self, rejected: &CodexAuth) -> io::Result<CodexAuth> {
+        let identity = rejected
+            .rotate_identity()
+            .ok_or_else(|| io::Error::other("Codex Rotate rejected snapshot missing"))?;
+        let auth = self
+            .request_auth(json!({
+                "op": "refresh", "account_key": identity.account_key,
+                "selection_epoch": identity.selection_epoch,
+                "rejected_revision": identity.credential_revision,
+            }))
+            .await?;
+        if !auth.rotate_identity().is_some_and(|actual| {
+            actual.account_key == identity.account_key
+                && actual.selection_epoch == identity.selection_epoch
+                && actual.credential_revision > identity.credential_revision
+        }) || auth.get_account_id() != rejected.get_account_id()
+        {
+            return Err(io::Error::other(
+                "Codex Rotate returned an invalid refresh owner or revision",
+            ));
+        }
+        Ok(auth)
+    }
+}
+
+/// Partial response buckets cannot establish model headroom or a full reset
+/// bound. They can only confirm exhaustion for ordinary or exact-model quota.
+pub(super) fn confirms_exhaustion(limits: &RateLimitSnapshot, model: Option<&str>) -> bool {
+    let ordinary = limits.normal_model_slug.is_none()
+        && limits.limit_id.as_deref().is_none_or(|id| id == "codex");
+    let exact_model = model.is_some_and(|model| {
+        limits.normal_model_slug.as_deref() == Some(model)
+            || limits.limit_id.as_deref() == Some(model)
+            || limits.limit_name.as_deref() == Some(model)
+    });
+    if !ordinary && !exact_model {
+        return false;
+    }
+    limits.spend_control_reached == Some(true)
+        || [&limits.primary, &limits.secondary]
+            .into_iter()
+            .flatten()
+            .any(|window| {
+                window.used_percent.is_finite()
+                    && window.used_percent >= 100.0
+                    && window
+                        .resets_at
+                        .is_none_or(|reset| reset > chrono::Utc::now().timestamp())
+            })
+}
+
+impl ExternalAuth for RotateHelper {
+    fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(self.acquire(/*model*/ None, /*pinned*/ None))
+    }
+
+    fn refresh(&self, _context: ExternalAuthRefreshContext) -> ExternalAuthFuture<'_, CodexAuth> {
+        // Shared-cache 401 recovery cannot safely identify the rejected request.
+        Box::pin(async {
+            Err(io::Error::other(
+                "Codex Rotate refresh requires a request snapshot",
+            ))
+        })
+    }
+
+    fn rotate_helper(&self) -> Option<&RotateHelper> {
+        Some(self)
+    }
+}

+#[cfg(unix)]
+#[tokio::test]
+async fn tools_reuse_refreshed_owner_without_acquire_or_global_selection_change() {
+    let dir = tempfile::tempdir().unwrap();
+    let counter = dir.path().join("calls");
+    let authority = Arc::new(counting_helper(
+        json!({"version": 1, "ok": true, "snapshot": snapshot("account-b", 1)}),
+        &counter,
+    ));
+    let manager = super::super::manager::AuthManager::from_auth_for_testing(auth("account-b", 1));
+    manager.set_external_auth(authority.clone()).await.unwrap();
+    authority
+        .auth
+        .lock()
+        .unwrap()
+        .insert("account-a".into(), auth("account-a", 2));
+    manager
+        .scope_request_auth(auth("account-a", 1), async {
+            assert_eq!(
+                manager.auth().await.unwrap().rotate_identity(),
+                auth("account-a", 2).rotate_identity()
+            );
+        })

+#[test_case(Activation::Success; "success")]
+#[test_case(Activation::Failure; "failure")]
+#[tokio::test]
+async fn device_login_reports_rotate_activation_result(activation: Activation) -> Result<()> {
+    let codex_home = TempDir::new()?;
+    let server = MockServer::start().await;
+    let snapshot = snapshot_response()?;
+    let reply = match activation {
+        Activation::Success => snapshot.clone(),
+        Activation::Failure => json!({"version": 1, "ok": false,
+            "error": {"code": "io_error", "message": "synthetic-secret-must-not-leak"}}),
+    };
+    write_config(codex_home.path(), &server.uri(), reply).await?;
+    save_api_key(codex_home.path())?;
+    for (endpoint, body) in [
+        (
+            "/api/accounts/deviceauth/usercode",
+            json!({
+                "device_auth_id": "synthetic-device", "user_code": "CODE-12345", "interval": "0"
+            }),
+        ),
+        (
+            "/api/accounts/deviceauth/token",
+            json!({
+                "authorization_code": "synthetic-code", "code_challenge": "challenge", "code_verifier": "verifier"
+            }),
+        ),
+        (
+            "/oauth/token",
+            json!({
+                "id_token": snapshot["snapshot"]["id_token"],
+                "access_token": "synthetic-access", "refresh_token": "synthetic-refresh"
+            }),
+        ),
+    ] {
+        Mock::given(method("POST"))
+            .and(path(endpoint))
+            .respond_with(ResponseTemplate::new(200).set_body_json(body))
+            .expect(1)
+            .mount(&server)
+            .await;
+    }
+    let mut app = start_app(
+        codex_home.path(),
+        &server,
+        matches!(activation, Activation::Success),
+    )
+    .await?;
+    let request = app.send_login_account_chatgpt_device_code_request().await?;
+    let login: LoginAccountResponse = timeout(READ_TIMEOUT, app.read_response(request)).await??;
+    let LoginAccountResponse::ChatgptDeviceCode { login_id, .. } = login else {
+        anyhow::bail!("unexpected login response: {login:?}");
+    };
+    let completed: AccountLoginCompletedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("account/login/completed"),
+    )
+    .await??;
+    let expected = match activation {
+        Activation::Success => (true, None),
+        Activation::Failure => (false, Some(
+            "The account was enrolled but Codex Rotate activation failed; run codex-rotate doctor before retrying".into()
+        )),
+    };
+    assert_eq!(
+        completed,
+        AccountLoginCompletedNotification {
+            login_id: Some(login_id),
+            success: expected.0,
+            error: expected.1,
+            onboarding_entrypoint: None,
+        }
+    );
+    assert!(
+        !codex_home.path().join("auth.json").exists(),
+        "refresh tokens must remain helper-owned"
+    );
+    match activation {
+        Activation::Success => {
+            assert_updated(&mut app, AuthMode::Chatgpt, Some(PlanType::Pro)).await?;
+            assert_account(&mut app, chatgpt_account()).await?;
+            assert_updated(&mut app, AuthMode::Chatgpt, Some(PlanType::Pro)).await?;
+            let mut second = snapshot;
+            second["snapshot"]["account_key"] = json!("second-profile");
+            second["snapshot"]["account_id"] = json!("second-account");
+            second["snapshot"]["selection_epoch"] = json!(2);
+            second["snapshot"]["id_token"] = json!(encode_id_token(
+                &ChatGptIdTokenClaims::new()
+                    .email("second@example.com")
+                    .plan_type("plus")
+                    .chatgpt_user_id("second-user")
+                    .chatgpt_account_id("second-account"),
+            )?);
+            std::fs::write(
+                codex_home.path().join("helper-response.json"),
+                serde_json::to_vec(&second)?,
+            )?;
+            // Passive auth-status reads use the published Rotate snapshot. A
+            // model turn is the request-admission boundary that acquires the
+            // newly selected profile and publishes its account update.
+            mount_model_response(&server).await?;
+            let started =
+                timeout(READ_TIMEOUT, app.start_thread(ThreadStartParams::default())).await??;
+            let request = app
+                .send_turn_start_request(TurnStartParams {
+                    thread_id: started.thread.id.clone(),
+                    input: vec![UserInput::Text {
+                        text: "Check the selected personal profile.".to_string(),
+                        text_elements: Vec::new(),
+                    }],
+                    ..Default::default()
+                })
+                .await?;
+            let _: TurnStartResponse = timeout(READ_TIMEOUT, app.read_response(request)).await??;
+            assert_updated(&mut app, AuthMode::Chatgpt, Some(PlanType::Plus)).await?;
+            let completed: TurnCompletedNotification =
+                timeout(READ_TIMEOUT, app.read_notification("turn/completed")).await??;
+            assert_eq!(completed.turn.status, TurnStatus::Completed);
+            assert_account_with_workspace(
+                &mut app,
+                Account::Chatgpt {
+                    email: Some("second@example.com".into()),
+                    plan_type: PlanType::Plus,
+                },
+                Some("second-account"),
+            )
+            .await?;
+        }
+        Activation::Failure => {
+            assert!(
+                timeout(
+                    Duration::from_millis(250),
+                    app.read_stream_until_notification_message("account/updated")
+                )
+                .await
+                .is_err()
+            );
+        }
+    }
+    Ok(())
+}

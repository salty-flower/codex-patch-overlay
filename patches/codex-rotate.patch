+use super::*;
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use codex_protocol::auth::AuthMode;
+use pretty_assertions::assert_eq;
+
+fn snapshot(account: &str, revision: u64) -> Value {
+    let claims = json!({ "https://api.openai.com/auth": {
+        "chatgpt_account_id": account, "chatgpt_user_id": "user-a", "chatgpt_plan_type": "pro"
+    }});
+    let jwt = format!(
+        "e30.{}.signature",
+        URL_SAFE_NO_PAD.encode(serde_json::to_vec(&claims).unwrap())
+    );
+    json!({ "account_key": account, "account_id": account, "selection_epoch": 7,
+        "credential_revision": revision, "id_token": jwt, "access_token": "synthetic-access",
+        "expires_at": chrono::Utc::now().timestamp() + 3600 })
+}
+
+fn auth(account: &str, revision: u64) -> CodexAuth {
+    CodexAuth::from_rotate_snapshot(
+        serde_json::from_value(snapshot(account, revision)).unwrap(),
+        None,
+    )
+    .unwrap()
+}
+
+#[test]
+fn native_identity_preserved_without_a_refresh_credential() {
+    let auth = auth("account-a", 1);
+    let token = auth.get_token_data().unwrap();
+    assert_eq!(
+        (
+            auth.auth_mode(),
+            auth.get_account_id(),
+            auth.get_chatgpt_user_id(),
+            token.refresh_token
+        ),
+        (
+            AuthMode::Chatgpt,
+            Some("account-a".into()),
+            Some("user-a".into()),
+            String::new()
+        )
+    );
+}
+
+#[test]
+fn rejects_identity_mismatch_and_missing_native_identity() {
+    let mut mismatch = snapshot("account-a", 1);
+    mismatch["account_id"] = json!("account-b");
+    assert!(
+        CodexAuth::from_rotate_snapshot(serde_json::from_value(mismatch).unwrap(), None).is_err()
+    );
+    let mut missing = snapshot("account-a", 1);
+    missing["id_token"] = Value::Null;
+    assert!(
+        CodexAuth::from_rotate_snapshot(serde_json::from_value(missing).unwrap(), None).is_err()
+    );
+}
+
+#[test]
+fn command_must_be_an_absolute_program_not_a_shell_string() {
+    assert!(RotateHelper::new(vec![]).is_err());
+    assert!(RotateHelper::new(vec!["codex-rotate rpc".into()]).is_err());
+}
+
+#[tokio::test]
+async fn request_scope_is_manager_specific_and_not_inherited_by_spawned_tasks() {
+    let manager = super::super::manager::AuthManager::from_auth_for_testing(auth("account-a", 1));
+    let other = super::super::manager::AuthManager::from_auth_for_testing(auth("account-c", 1));
+    let spawned_manager = std::sync::Arc::clone(&manager);
+    manager
+        .scope_request_auth(auth("account-b", 2), async {
+            assert_eq!(
+                manager.auth_cached().unwrap().get_account_id(),
+                Some("account-b".into())
+            );
+            assert_eq!(
+                manager.auth().await.unwrap().get_account_id(),
+                Some("account-b".into())
+            );
+            assert_eq!(
+                manager
+                    .auth_for_request(None, None)
+                    .await
+                    .unwrap()
+                    .unwrap()
+                    .get_account_id(),
+                Some("account-b".into())
+            );
+            assert_eq!(
+                other.auth_cached().unwrap().get_account_id(),
+                Some("account-c".into())
+            );
+            let spawned =
+                tokio::spawn(
+                    async move { spawned_manager.auth_cached().unwrap().get_account_id() },
+                )
+                .await
+                .unwrap();
+            assert_eq!(spawned, Some("account-a".into()));
+        })
+        .await;
+    assert_eq!(
+        manager.auth_cached().unwrap().get_account_id(),
+        Some("account-a".into())
+    );
+}
+
+#[cfg(unix)]
+fn helper(response: Value) -> RotateHelper {
+    let response = serde_json::to_string(&response)
+        .unwrap()
+        .replace('\'', "'\\''");
+    RotateHelper::new(vec![
+        "/bin/sh".into(),
+        "-c".into(),
+        format!("IFS= read -r request; printf '%s' '{response}'"),
+    ])
+    .unwrap()
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn late_refresh_is_bound_to_rejected_owner_and_revision() {
+    let rejected = auth("account-a", 1);
+    let expected = auth("account-a", 2);
+    let authority = helper(json!({"version": 1, "ok": true, "snapshot": snapshot("account-a", 2)}));
+    let refreshed = authority.refresh_snapshot(&rejected).await.unwrap();
+    assert_eq!(refreshed.rotate_identity(), expected.rotate_identity());
+    let wrong_owner =
+        helper(json!({"version": 1, "ok": true, "snapshot": snapshot("account-b", 2)}));
+    assert!(wrong_owner.refresh_snapshot(&rejected).await.is_err());
+    assert!(
+        wrong_owner
+            .acquire(Some("production-model"), Some(&rejected))
+            .await
+            .is_err()
+    );
+    let stale = helper(json!({"version": 1, "ok": true, "snapshot": snapshot("account-a", 1)}));
+    assert!(stale.refresh_snapshot(&rejected).await.is_err());
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn refreshed_snapshot_overrides_scoped_revision_without_changing_owner() {
+    let manager = super::super::manager::AuthManager::from_auth_for_testing(auth("account-a", 1));
+    manager
+        .set_external_auth(std::sync::Arc::new(helper(json!({
+            "version": 1, "ok": true, "snapshot": snapshot("account-a", 1)
+        }))))
+        .await
+        .unwrap();
+    manager
+        .scope_request_auth(auth("account-a", 1), async {
+            let refreshed = auth("account-a", 2);
+            let actual = manager
+                .auth_for_request(None, Some(&refreshed))
+                .await
+                .unwrap()
+                .unwrap();
+            assert_eq!(actual.rotate_identity(), refreshed.rotate_identity());
+            assert!(
+                manager
+                    .auth_for_request(None, Some(&auth("account-b", 2)))
+                    .await
+                    .is_err()
+            );
+        })
+        .await;
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn helper_errors_never_echo_untrusted_output() {
+    let authority = helper(json!({"version": 1, "ok": false,
+        "error": {"code": "synthetic-secret", "message": "synthetic-secret"}}));
+    let message = authority
+        .rpc(json!({"op": "acquire"}))
+        .await
+        .unwrap_err()
+        .to_string();
+    assert!(!message.contains("synthetic-secret"));
+    let signed_out = helper(json!({"version": 1, "ok": false, "error": {"code": "signed_out"}}));
+    assert_eq!(
+        signed_out
+            .rpc(json!({"op": "acquire"}))
+            .await
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::NotFound
+    );
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn shared_cache_refresh_cannot_guess_the_rejected_snapshot() {
+    let authority = helper(json!({"version": 1, "ok": true, "snapshot": snapshot("account-b", 2)}));
+    let error = authority
+        .refresh(ExternalAuthRefreshContext {
+            reason: super::super::manager::ExternalAuthRefreshReason::Unauthorized,
+            previous_account_id: Some("account-a".into()),
+        })
+        .await
+        .unwrap_err();
+    assert_eq!(
+        error.to_string(),
+        "Codex Rotate refresh requires a request snapshot"
+    );
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn spawned_request_manager_refreshes_only_its_owner_without_native_writes() {
+    let home = tempfile::tempdir().unwrap();
+    let reply = |account, revision| {
+        serde_json::to_string(&json!({
+            "version":1,"ok":true,"snapshot":snapshot(account, revision)
+        }))
+        .unwrap()
+    };
+    let script = format!(
+        r#"IFS= read -r request
+case "$request" in
+  *'"op":"refresh"'*'"rejected_revision":1'*) printf '%s' '{}' ;;
+  *'"account_key":"account-a"'*) printf '%s' '{}' ;;
+  *) printf '%s' '{}' ;;
+esac"#,
+        reply("account-a", 2),
+        reply("account-a", 1),
+        reply("account-b", 1)
+    );
+    let manager = super::super::manager::AuthManager::from_auth_for_testing_with_home(
+        auth("account-b", 1),
+        home.path().to_path_buf(),
+    );
+    manager
+        .set_external_auth(Arc::new(
+            RotateHelper::new(vec!["/bin/sh".into(), "-c".into(), script]).unwrap(),
+        ))
+        .await
+        .unwrap();
+    let competing = RequestSnapshotAuth::new(
+        Arc::new(helper(json!({
+            "version":1,"ok":true,"snapshot":snapshot("account-a", 1)
+        }))),
+        auth("account-a", 1),
+    );
+    assert!(
+        manager
+            .set_external_auth(Arc::new(competing))
+            .await
+            .is_err()
+    );
+    let fork = manager.for_request_snapshot(auth("account-a", 1)).unwrap();
+    let worker = Arc::clone(&fork);
+    let refreshed = tokio::spawn(async move {
+        assert_eq!(
+            worker.auth().await.unwrap().get_account_id().as_deref(),
+            Some("account-a")
+        );
+        worker.refresh_token_from_authority().await.unwrap();
+        worker.auth_cached().unwrap()
+    })
+    .await
+    .unwrap();
+    assert_eq!(
+        refreshed.rotate_identity(),
+        auth("account-a", 2).rotate_identity()
+    );
+    assert_eq!(
+        manager.auth_cached().unwrap().get_account_id().as_deref(),
+        Some("account-b")
+    );
+    assert!(fork.logout().await.is_err());
+    fork.clear_external_auth();
+    assert!(fork.has_external_auth());
+    assert!(!home.path().join("auth.json").exists());
+}

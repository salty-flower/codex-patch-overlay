+    fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async {
+            let _update = self
+                .update_lock
+                .acquire()
+                .await
+                .map_err(|_| io::Error::other("Codex Rotate request auth unavailable"))?;
+            let current = self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("Codex Rotate request auth unavailable"))?
+                .clone();
+            let helper = self
+                .authority
+                .rotate_helper()
+                .ok_or_else(|| io::Error::other("Codex Rotate authority is unavailable"))?;
+            let auth = helper.acquire(/*model*/ None, Some(&current)).await?;
+            *self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("Codex Rotate request auth unavailable"))? =
+                auth.clone();
+            Ok(auth)
+        })
+    }
+
+    fn refresh(&self, _context: ExternalAuthRefreshContext) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async {
+            let _update = self
+                .update_lock
+                .acquire()
+                .await
+                .map_err(|_| io::Error::other("Codex Rotate request auth unavailable"))?;
+            let current = self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("Codex Rotate request auth unavailable"))?
+                .clone();
+            let helper = self
+                .authority
+                .rotate_helper()
+                .ok_or_else(|| io::Error::other("Codex Rotate authority is unavailable"))?;
+            let auth = helper.refresh_snapshot(&current).await?;
+            *self
+                .current
+                .lock()
+                .map_err(|_| io::Error::other("Codex Rotate request auth unavailable"))? =
+                auth.clone();
+            Ok(auth)
+        })
+    }

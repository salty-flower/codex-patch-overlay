+#[test]
+fn partial_usage_only_confirms_relevant_exhaustion_not_headroom() {
+    let mut limits: codex_protocol::protocol::RateLimitSnapshot = serde_json::from_value(json!({
+        "limit_id":"other-model", "normal_model_slug":"other-model",
+        "primary":{"used_percent":80.0,"window_minutes":300,"resets_at":9999999999_i64}
+    }))
+    .unwrap();
+    assert!(!confirms_exhaustion(&limits, Some("requested-model")));
+    limits.normal_model_slug = Some("requested-model".into());
+    assert!(!confirms_exhaustion(&limits, Some("requested-model")));
+    limits.primary.as_mut().unwrap().used_percent = 100.0;
+    assert!(confirms_exhaustion(&limits, Some("requested-model")));
+    limits.normal_model_slug = Some("other-model".into());
+    assert!(!confirms_exhaustion(&limits, Some("requested-model")));
+}

+#[cfg(unix)]
+#[tokio::test]
+async fn cancelled_helper_kills_descendants_holding_stdout() {
+    let dir = tempfile::tempdir().unwrap();
+    let pid_path = dir.path().join("descendant");
+    let authority = RotateHelper::new(vec![
+        "/bin/sh".into(),
+        "-c".into(),
+        "sleep 60 & printf '%s' \"$!\" > \"$1\"; wait".into(),
+        "helper".into(),
+        pid_path.display().to_string(),
+    ])
+    .unwrap();
+    let task = tokio::spawn(async move { authority.rpc(json!({"op": "acquire"})).await });
+    let pid: i32 = tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            if let Ok(text) = std::fs::read_to_string(&pid_path)
+                && let Ok(pid) = text.parse()
+            {
+                break pid;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .unwrap();
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            // A zombie has exited; container PID 1 may not reap it promptly.
+            #[cfg(target_os = "linux")]
+            if std::fs::read_to_string(format!("/proc/{pid}/stat")).is_ok_and(|stat| {
+                stat.split_once(") ")
+                    .is_some_and(|(_, fields)| fields.starts_with('Z'))
+            }) {
+                break;
+            }
+            if !unix_process::process_exists(pid) {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("helper descendant should terminate on cancellation");
+}

+    /// Context input breakdown: non-cached (fresh) vs cached tokens.
+    ///
+    /// Only rendered when the context window has data and at least one input
+    /// token is cached.
+    fn context_breakdown_spans(&self) -> Option<Vec<Span<'static>>> {
+        let context = self.token_usage.context_window.as_ref()?;
+        if context.tokens_in_context == 0 {
+            return None;
+        }
+        let cached = self.token_usage.cached_input;
+        let non_cached = self.token_usage.non_cached_input;
+        if cached == 0 && non_cached == 0 {
+            return None;
+        }
+
+        let cached_pct = if non_cached.saturating_add(cached) > 0 {
+            ((cached as f64 / (non_cached.saturating_add(cached)) as f64) * 100.0)
+                .round() as i64
+        } else {
+            0
+        };
+
+        let cached_fmt = format_tokens_compact(cached);
+        let non_cached_fmt = format_tokens_compact(non_cached);
+
+        let mut spans = vec![
+            Span::from(non_cached_fmt),
+            Span::from(" non-cached").dim(),
+        ];
+        if cached > 0 {
+            spans.push(Span::from(" + ").dim());
+            spans.push(Span::from(format!("{cached_fmt} cached ({cached_pct}%)")).dim());
+        }
+        Some(spans)
+    }
+
     fn rate_limit_lines(
         &self,
         state: &StatusRateLimitState,

+/// Read the user-only startup setting before the async configuration loader runs.
+/// Missing, unreadable, or invalid configuration never enables the exception.
+pub fn allow_helpers_in_temp(codex_home: &Path) -> bool {
+    #[derive(Deserialize)]
+    struct StartupConfig {
+        #[serde(default)]
+        allow_helpers_in_temp: bool,
+    }
+
+    std::fs::read_to_string(codex_home.join(crate::CONFIG_TOML_FILE))
+        .ok()
+        .and_then(|contents| toml::from_str::<StartupConfig>(&contents).ok())
+        .is_some_and(|config| config.allow_helpers_in_temp)
+}

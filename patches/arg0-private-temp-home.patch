+// Keep the check available in debug builds so tests exercise the release policy.
+#[cfg_attr(debug_assertions, allow(dead_code))]
+fn helpers_allowed_in_home(
+    codex_home: &Path,
+    temp_root: &Path,
+    allow_helpers: Option<&std::ffi::OsStr>,
+) -> bool {
+    let Ok(relative) = codex_home.strip_prefix(temp_root) else {
+        return true;
+    };
+    if allow_helpers != Some(std::ffi::OsStr::new("1")) {
+        return false;
+    }
+    #[cfg(unix)]
+    {
+        // SAFETY: geteuid has no preconditions and does not mutate process state.
+        private_temp_home(temp_root, relative, unsafe { libc::geteuid() })
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = relative;
+        false
+    }
+}
+
+#[cfg(unix)]
+#[cfg_attr(debug_assertions, allow(dead_code))]
+fn private_temp_home(temp_root: &Path, relative: &Path, effective_uid: u32) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    use std::path::Component;
+
+    // The root itself may be a system alias (macOS /tmp -> /private/tmp).
+    // Never canonicalize descendants: that would hide an attacker-owned symlink.
+    let mut path = temp_root.to_path_buf();
+    if relative.as_os_str().is_empty() {
+        return false;
+    }
+    for component in relative.components() {
+        let Component::Normal(name) = component else {
+            return false;
+        };
+        path.push(name);
+        let Ok(metadata) = std::fs::symlink_metadata(&path) else {
+            return false;
+        };
+        if !metadata.is_dir() || metadata.uid() != effective_uid || metadata.mode() & 0o022 != 0 {
+            return false;
+        }
+    }
+    true
+}

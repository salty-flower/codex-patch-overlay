@@ -0,0 +1,180 @@
+use super::helpers_allowed_in_home;
+use super::prepare_aliases_in_home;
+use super::private_temp_home;
+use std::ffi::OsStr;
+use std::fs;
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::fs::PermissionsExt;
+use std::os::unix::fs::symlink;
+use std::path::Path;
+use std::path::PathBuf;
+use tempfile::TempDir;
+
+fn private_home() -> std::io::Result<(TempDir, PathBuf)> {
+    let root = tempfile::tempdir()?;
+    let home = root.path().join("user").join(".codex");
+    fs::create_dir_all(&home)?;
+    for dir in [home.parent().unwrap(), home.as_path()] {
+        fs::set_permissions(dir, fs::Permissions::from_mode(0o755))?;
+    }
+    Ok((root, home))
+}
+
+#[test]
+fn only_exact_environment_opt_in_allows_helpers() -> std::io::Result<()> {
+    let (root, home) = private_home()?;
+    assert!(!helpers_allowed_in_home(&home, root.path(), None));
+    for value in ["", "0", "true", "false", "01", " 1", "1 "] {
+        assert!(!helpers_allowed_in_home(
+            &home,
+            root.path(),
+            Some(OsStr::new(value)),
+        ));
+    }
+    assert!(helpers_allowed_in_home(
+        &home,
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    Ok(())
+}
+
+#[test]
+fn private_directories_allow_helpers() -> std::io::Result<()> {
+    let (root, home) = private_home()?;
+    assert!(helpers_allowed_in_home(
+        &home,
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    fs::set_permissions(&home, fs::Permissions::from_mode(0o700))?;
+    assert!(helpers_allowed_in_home(
+        &home,
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    Ok(())
+}
+
+#[test]
+fn different_owner_refuses_helpers() -> std::io::Result<()> {
+    let (root, home) = private_home()?;
+    let different_uid = fs::symlink_metadata(&home)?.uid().wrapping_add(1);
+    assert!(!private_temp_home(
+        root.path(),
+        Path::new("user/.codex"),
+        different_uid,
+    ));
+    Ok(())
+}
+
+#[test]
+fn writable_ancestor_or_home_refuses_helpers() -> std::io::Result<()> {
+    let (root, home) = private_home()?;
+    for dir in [home.parent().unwrap(), home.as_path()] {
+        for mode in [0o775, 0o757, 0o777, 0o1777] {
+            fs::set_permissions(dir, fs::Permissions::from_mode(mode))?;
+            assert!(!helpers_allowed_in_home(
+                &home,
+                root.path(),
+                Some(OsStr::new("1"))
+            ));
+        }
+        fs::set_permissions(dir, fs::Permissions::from_mode(0o755))?;
+    }
+    Ok(())
+}
+
+#[test]
+fn symlink_ancestor_or_home_refuses_helpers() -> std::io::Result<()> {
+    let (root, home) = private_home()?;
+    let linked_user = root.path().join("linked-user");
+    symlink(home.parent().unwrap(), &linked_user)?;
+    assert!(!helpers_allowed_in_home(
+        &linked_user.join(".codex"),
+        root.path(),
+        Some(OsStr::new("1")),
+    ));
+    let linked_home = home.parent().unwrap().join("linked-home");
+    symlink(&home, &linked_home)?;
+    assert!(!helpers_allowed_in_home(
+        &linked_home,
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    Ok(())
+}
+
+#[test]
+fn system_temp_root_symlink_is_allowed() -> std::io::Result<()> {
+    let (root, _) = private_home()?;
+    let system = tempfile::tempdir()?;
+    let temp_alias = system.path().join("tmp");
+    symlink(root.path(), &temp_alias)?;
+    assert!(helpers_allowed_in_home(
+        &temp_alias.join("user/.codex"),
+        &temp_alias,
+        Some(OsStr::new("1")),
+    ));
+    Ok(())
+}
+
+#[test]
+fn outside_temp_root_preserves_existing_policy() -> std::io::Result<()> {
+    let root = tempfile::tempdir()?;
+    assert!(helpers_allowed_in_home(
+        &root.path().join("tmp-other/.codex"),
+        &root.path().join("tmp"),
+        None,
+    ));
+    Ok(())
+}
+
+#[test]
+fn root_missing_file_and_parent_traversal_refuse_helpers() -> std::io::Result<()> {
+    let (root, home) = private_home()?;
+    assert!(!helpers_allowed_in_home(
+        root.path(),
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    assert!(!helpers_allowed_in_home(
+        &home.join("missing"),
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    let file = home.join("file");
+    fs::write(&file, b"")?;
+    assert!(!helpers_allowed_in_home(
+        &file,
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    assert!(!helpers_allowed_in_home(
+        &home.join("../.codex"),
+        root.path(),
+        Some(OsStr::new("1")),
+    ));
+    Ok(())
+}
+
+#[test]
+fn private_home_aliases_live_until_guard_drops() -> std::io::Result<()> {
+    let (root, home) = private_home()?;
+    assert!(helpers_allowed_in_home(
+        &home,
+        root.path(),
+        Some(OsStr::new("1"))
+    ));
+    let (guard, path) = prepare_aliases_in_home(&home, None)?;
+    let alias_dir = std::env::split_paths(&path).next().unwrap();
+    for name in ["apply_patch", "applypatch"] {
+        assert_eq!(
+            fs::read_link(alias_dir.join(name))?,
+            std::env::current_exe()?
+        );
+    }
+    drop(guard);
+    assert!(!alias_dir.exists());
+    Ok(())
+}

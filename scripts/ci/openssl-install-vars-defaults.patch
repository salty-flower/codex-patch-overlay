 }
+# These generated build/install invocations omit optional values. Preserve the
+# empty libdir list, existing path defaults, and empty COMMENT output.
+foreach my $optional (
+    [ libdir => [] ],
+    [ PKGCONFIGDIR => [ '.' ] ],
+    [ CMAKECONFIGDIR => [ '.' ] ],
+    [ COMMENT => [ '' ] ],
+) {
+    my ($k, $v) = @$optional;
+    next if $keys{$k};
+    $keys{$k} = 1;
+    $values{$k} = $v;
+}
+sub _mkinstallvars_string {
+    return defined $_[0] ? $_[0] : '';
+}
 

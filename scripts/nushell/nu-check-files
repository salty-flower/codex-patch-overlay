#!/usr/bin/env bash
set -euo pipefail

nushell_shebang_re='^#![[:space:]]*(/usr/bin/env([[:space:]]+-S)?[[:space:]]+)?([^[:space:]]*/)?nu([[:space:]]|$)'

for f in "$@"; do
  [ -f "$f" ] || continue

  basename="${f##*/}"
  if [[ "$basename" != *.nu ]]; then
    name_without_leading_dot="${basename#.}"
    [[ "$name_without_leading_dot" != *.* ]] || continue
    first_line=""
    IFS= read -r first_line <"$f" || true
    [[ "$first_line" =~ $nushell_shebang_re ]] || continue
  fi

  abs="$(cd "$(dirname "$f")" && pwd)/$basename"
  # shellcheck disable=SC2016 # Nushell expands $env.NU_CHECK_FILE.
  if ! NU_CHECK_FILE="$abs" nu --no-config-file -c \
    'if not (nu-check --debug $env.NU_CHECK_FILE) { exit 1 }'; then
    printf 'nu-check failed: %s\n' "$f" >&2
    exit 1
  fi
done
